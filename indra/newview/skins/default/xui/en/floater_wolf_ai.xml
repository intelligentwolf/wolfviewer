<!-- [2026-09-12] The AI wizard, matching WolfStorm's (wolfstorm js/ui/floaters/build_ai_tab.js):
     choose -> form -> (large: confirm the charge) -> a status-only screen while it runs.
     Four sibling step panels, one visible at a time (WolfPanelAI::setStep); every rect is static.
     The previous version put the body in a scroll_container declared right="0" bottom="0":
     under layout="topleft" a NON-negative right/bottom is measured from the parent's LEFT/BOTTOM
     edge (llview.cpp:2549-2560), so that viewport was built with zero width and zero height and
     the whole body was invisible. Offsets from the far edge must be negative (right="-8").

     [FORGE LOOK 2026-10-20] Paul: "our standard object ai generator just make them look as nice as the new avatar and
     clothing generator but not the same". "The Forge": words go in, an object comes out. A smithy at night is painted in
     code behind these controls (WolfAIForge in wolfai.cpp, the technique of the radio and WolfAvatars; the primitives in
     wolfpaint.h): warm charcoal with an ember glow from below and sparks rising, the "Create with AI" plate with an anvil
     and hammer (the top 96 px of the panel), four embers for the steps (Choose - Describe - Forge - Delivered, or Confirm -
     Build for a large build; 100-136), the Small model tile with its drawing, the iron plates the fields sit on, the ledger
     behind the credits row, a crucible ring while a small model is made (in ai_scroll's place, which a small model does not
     show) and a green tick when it is delivered, the error plate with its warning mark, and every button's face (image_color
     0 alpha: the forge paints them as a glowing ingot for the main action and dark iron for the rest; labels, focus and
     tooltips are the buttons' own). Text colours are fixed, not the skin's, because the text sits on the fixed painting
     (contrast of each pair in wolfai.cpp, all at least 4.5:1). Same ids, callbacks, steps and behaviour as before. -->
<floater can_close="true" can_minimize="true" can_resize="true" height="660" min_height="660" min_width="660" layout="topleft" name="wolf_ai" save_rect="true" single_instance="true" title="Create with AI" width="680">
 <panel border="false" follows="all" layout="topleft" name="wolf_ai_panel" class="wolf_panel_ai" left="0" top="20" width="680" height="640">
  <!-- lettering painted on the forge (not widgets): the title plate, and the four embers (comma separated) for the choice,
       for a small model and for a large build -->
  <string name="forge_title">Create with AI</string>
  <string name="forge_sub">Describe it in words  -  the forge makes it</string>
  <string name="steps_choose">Choose,Describe,Make it,Delivered</string>
  <string name="steps_small">Choose,Describe,Forge,Delivered</string>
  <string name="steps_large">Choose,Describe,Confirm,Build</string>
  <!-- [WOLF 3D TEXT 2026-10-26] the 3D Text tool's embers (round 2: the preview is on the form; the third ember is lit while
       the sign is made), and the words box's placeholder (PROTOCOL.md: never a trademark) -->
  <string name="steps_text">Choose,Your words,Make it,Delivered</string>
  <string name="text_placeholder">WOLF TERRITORIES</string>

  <!-- Step 1: which generator. Nothing else on the screen, so neither choice can be missed. -->
  <panel name="ai_step_choose" follows="all" layout="topleft" left="0" top="140" width="680" height="432" border="false">
   <text follows="left|top" layout="topleft" left="16" top="6" width="648" height="22" font="SansSerifLarge" text_color="1 0.89 0.72 1" name="ai_choose_title">What would you like to make?</text>
   <!-- the Small model tile: the forge draws its face and its picture (a vase) on the left; the words are the button's -->
   <button follows="left|right|top" layout="topleft" left="16" top="40" width="648" height="116" name="ai_choose_small" label="1. Small model"
    halign="left" pad_left="124" pad_bottom="26" font="SansSerifLarge"
    image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
    label_color="0.97 0.93 0.9 1" label_color_selected="0.97 0.93 0.9 1" label_color_disabled="0.79 0.72 0.67 1" label_color_disabled_selected="0.79 0.72 0.67 1"
    tool_tip="A single textured object, made from your words and put in your Objects folder" />
   <text follows="left|right|top" layout="topleft" left="140" top="94" width="512" height="54" word_wrap="true" mouse_opaque="false" text_color="0.83 0.76 0.7 1" name="ai_choose_small_note">A single textured object — furniture, a statue, a prop. Describe it, it is built, and it arrives in your Objects folder.</text>
     <!-- [2026-09-12] "2. Large project" withdrawn for now (Paul: remove the second option from
       wolfstorm and wolfviewer): four large builds failed on compiler rules at the grid's cost.
       The step panels and code stay; the button is hidden until the compiler corrects instead
       of rejects. Mirrors WolfStorm build_ai_tab.js. -->
   <button visible="false" follows="left|right|top" layout="topleft" left="16" top="168" width="648" height="116" name="ai_choose_large" label="2. Large project"
    halign="left" pad_left="124" pad_bottom="26" font="SansSerifLarge"
    image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
    label_color="0.97 0.93 0.9 1" label_color_selected="0.97 0.93 0.9 1" label_color_disabled="0.79 0.72 0.67 1" label_color_disabled_selected="0.79 0.72 0.67 1" />
   <text visible="false" follows="left|right|top" layout="topleft" left="140" top="222" width="512" height="54" word_wrap="true" mouse_opaque="false" text_color="0.83 0.76 0.7 1" name="ai_choose_large_note">A building or a settlement, with structural interiors. Designed in stages; you can close this window and it is delivered to your Objects folder when it is ready.</text>
   <!-- [WOLF 3D TEXT 2026-10-26] the 3D Text tile, in the hidden large tile's place: the forge draws its face and its picture
        (solid letters) on the left; the words are the button's (PROTOCOL.md "UI shape") -->
   <button follows="left|right|top" layout="topleft" left="16" top="168" width="648" height="116" name="ai_choose_text" label="2. 3D Text"
    halign="left" pad_left="124" pad_bottom="26" font="SansSerifLarge"
    image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
    label_color="0.97 0.93 0.9 1" label_color_selected="0.97 0.93 0.9 1" label_color_disabled="0.79 0.72 0.67 1" label_color_disabled_selected="0.79 0.72 0.67 1"
    tool_tip="Your words as a solid sign, put in your Objects folder. Free." />
   <text follows="left|right|top" layout="topleft" left="140" top="222" width="512" height="54" word_wrap="true" mouse_opaque="false" text_color="0.83 0.76 0.7 1" name="ai_choose_text_note">Words in solid letters: plain, bevelled, neon, or a hillside sign. Free.</text>
  </panel>

  <!-- [WOLF 3D TEXT 2026-10-26] Step 2 of the 3D Text tool: the form (PROTOCOL.md SPEC) with its live preview beside it.
       [ROUND 2 2026-10-26] Paul: "the 3d text is GREAT *but*" - "the text does overflow a bit on the floater". Who and why: a
       resident wants their words as a solid sign and to see it change as they try styles and fonts, then make it (free).
       Flow: type the words -> the picture follows (1.2 s after the last change) -> Make it - free.
       Two columns, sized for the floater's minimum width (660; at the default 680 the right column moves 20 px right with
       the edge, follows="right|top"):
       - left, x 24-388 on one iron plate (16-396): the words (always in sight), then two page tabs and one page at a time
         (Hick's law: about half the settings on screen at once) - "Letters" (style and its note, font, letter height and
         depth, bevel, comes as, name) and "Colour and lights" (colour, texture, glow, full bright, lights, light colour,
         brightness, reach). The pages are panels 396 x 248 at top 180; their controls are placed in the page's own
         coordinates. Labels 96 px wide (the widest, "Letter height", is 85 px in SansSerifBold 8.6 pt; "Name in inventory",
         119 px, wraps to two lines), controls from x 124.
       - right, x 432-664 at 680 (412-644 at 660): Update preview and the Day / Night switch (shown only when the sign looks
         different at night) on one row, the picture (232 x 232: a 512 x 512 day or night picture, or the older 1024 x 512
         both-halves picture fitted in), its numbers (two lines), the quiet status line (three lines: "Updating" is drawn on
         the picture itself; "Preview paused for N s", why the preview waits, or "Making your sign"), and Make it - free.
       Every field error is written by its field (the *_err lines, the forge's error red #ff7f6e on iron 6.2:1); the shared
       error box at the bottom says what failed. Text colours as the rest of this file (contrast in wolfai.cpp). -->
  <panel name="ai_step_text" follows="all" layout="topleft" left="0" top="140" width="680" height="432" border="false" visible="false">
   <button follows="left|top" layout="topleft" left="24" top="8" width="124" height="26" name="ai_text_back" label="← Start again"
    image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
    label_color="0.97 0.93 0.9 1" label_color_selected="0.97 0.93 0.9 1" label_color_disabled="0.79 0.72 0.67 1" label_color_disabled_selected="0.79 0.72 0.67 1" />
   <text follows="left|top" layout="topleft" left="160" top="13" width="236" height="16" font="SansSerifBold" text_color="1 0.7 0.42 1" name="ai_text_free">Free - no Wolf Credits are used</text>
   <!-- the words: always in sight, above the pages -->
   <text follows="left|top" layout="topleft" left="24" top="44" width="90" height="16" font="SansSerifBold" text_color="0.97 0.93 0.9 1" name="ai_text_words_lbl">Your words</text>
   <text follows="left|top" layout="topleft" left="120" top="45" width="268" height="16" halign="right" font="SansSerifSmall" text_color="0.83 0.76 0.7 1" name="ai_text_words_hint">Up to 3 lines, 24 characters a line</text>
