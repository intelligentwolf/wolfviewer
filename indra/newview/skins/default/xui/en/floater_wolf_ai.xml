    <text follows="left|top" layout="topleft" left="326" top="107" width="14" height="16" text_color="0.83 0.76 0.7 1" name="ai_text_depth_unit">m</text>
    <text visible="false" follows="left|top" layout="topleft" left="24" top="128" width="186" height="16" font="SansSerifSmall" text_color="1 0.498 0.431 1" name="ai_text_height_err" />
    <text visible="false" follows="left|top" layout="topleft" left="214" top="128" width="174" height="16" font="SansSerifSmall" text_color="1 0.498 0.431 1" name="ai_text_depth_err" />
    <check_box follows="left|top" layout="topleft" left="24" top="146" width="140" height="18" name="ai_text_bevel" label="Bevelled edges" tool_tip="Rounded-off front edges">
<check_box.label_text text_color="0.97 0.93 0.9 1" text_readonly_color="0.79 0.72 0.67 1" />
