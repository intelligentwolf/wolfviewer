    <text follows="left|top" font.style="BOLD" height="16" layout="topleft" left="4" name="tl_lbl" top="216" width="578" text_color="0.95 0.92 0.84 1">Things it uses (your own objects on this region)</text>
    <scroll_list follows="left|top" height="110" layout="topleft" left="4" name="tl_list" top="236" width="578" multi_select="false" draw_heading="true" column_padding="4">
        <scroll_list.columns name="type" label="It is a" width="100" />
        <scroll_list.columns name="role" label="Called" width="130" />
        <scroll_list.columns name="object" label="Object" width="250" />
        <scroll_list.columns name="face" label="Face" width="70" />
    </scroll_list>
    <combo_box follows="left|top" height="22" layout="topleft" left="4" name="tl_type" top="352" width="130" />
    <line_editor follows="left|top" height="22" layout="topleft" left="138" max_length_chars="24" name="tl_role" top="352" width="150" label="called, e.g. board" />
    <spinner follows="left|top" height="22" layout="topleft" left="292" name="tl_face" top="352" width="110" label="Face" label_width="34"
