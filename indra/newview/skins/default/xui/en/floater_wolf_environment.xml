      <combo_box follows="left|top" height="22" layout="topleft" left="300" top="335" width="204" name="weather_type" />

      <check_box follows="left|top" height="18" layout="topleft" left="8" top="366" width="210" name="clouds_auto" label="Cloud cover from the weather" />
      <slider follows="left|top" height="20" layout="topleft" left="220" top="365" width="284" name="clouds" label="Cover" label_width="44"
              min_val="0" max_val="100" increment="1" initial_value="50" decimal_digits="0" />
      <slider follows="left|top" height="20" layout="topleft" left="8" top="392" width="300" name="haze" label="Extra haze" label_width="84"
              min_val="0" max_val="100" increment="1" initial_value="0" decimal_digits="0"
              tool_tip="Mist in the air on top of what the weather brings. 0 = none added." />
      <text follows="left|top" height="16" layout="topleft" left="320" top="394" width="44" name="water_lbl">Water</text>
      <combo_box follows="left|top" height="22" layout="topleft" left="368" top="390" width="136" name="water" />
      <text follows="left|top" height="16" layout="topleft" left="8" top="422" width="80" name="mood_lbl">Colour mood</text>
