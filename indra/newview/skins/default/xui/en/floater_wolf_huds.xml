<!-- [HUDS BUTTON 2026-11-10] Wolf HUDs (wolffloaterhuds.cpp), opened by the labelled HUDs button at the bottom right
     (panel_toolbar_view.xml wolf_huds_button). Paul: "on the bottom left of the screen all those tiny buttons look messy -
     have a Huds button in the bottom right control that opens a colourful floater with each different hud as an
     illustrated button".
     Who and why: a resident (35-65, perhaps with weaker eyesight) wants the flight deck or the game HUD without hunting for
     a 22 px icon. Flow: press HUDs, see a big picture, a plain name, one line saying what it is and ON / OFF for every HUD;
     press one: it shows or hides exactly as its old tiny icon did; switching one ON closes this window so the HUD can be
     seen. Each tile is ONE button (the whole tile, so the name and words are pressable too: the picture and words on it
     are mouse_opaque="false" and let the press through, llview.cpp childrenHandleMouseEvent / blockMouseEvent); Tab moves
     between tiles, Enter or Space presses. Pictures: our own artwork, textures/icons/wolf_huds_<id>.png
     (region-terrain-work/huds-button-2026-11-10/make_hud_art.py), the same as WolfStorm's icons/huds/<id>.svg.
     Same tiles, order and words as WolfStorm floater_wolf_huds.js (which has the HUDs WolfStorm has). -->
<floater
 can_close="true"
 can_minimize="true"
 can_resize="false"
 height="568"
 layout="topleft"
 name="wolf_huds"
 save_rect="true"
 single_instance="true"
 title="Wolf HUDs"
 width="808">
    <text follows="left|top" font="SansSerifLarge" height="28" layout="topleft" left="12" name="intro" top="30" width="784" wrap="true">Press a picture to show or hide that HUD. A green dot and ON mean it is showing.</text>
    <!-- Game Mode -->
    <button follows="left|top" layout="topleft" left="12" top="64" width="256" height="108" name="tile_game" is_toggle="true" label="" tab_stop="true" tool_tip="Game Mode: Your character, actions and bag across the bottom of the screen." />
    <icon follows="left|top" layout="topleft" left="22" top="78" width="80" height="80" name="pic_game" image_name="WolfHuds_game" mouse_opaque="false" />
    <text follows="left|top" layout="topleft" left="112" top="74" width="148" height="20" name="name_game" font="SansSerifLarge" font.style="BOLD" mouse_opaque="false" use_ellipses="true">Game Mode</text>
    <text follows="left|top" layout="topleft" left="112" top="96" width="148" height="46" name="desc_game" font="SansSerif" wrap="true" mouse_opaque="false">Your character, actions and bag across the bottom of the screen.</text>
    <text follows="left|top" layout="topleft" left="112" top="146" width="148" height="18" name="state_game" font="SansSerif" font.style="BOLD" mouse_opaque="false">OFF</text>
    <!-- Car Dashboard -->
