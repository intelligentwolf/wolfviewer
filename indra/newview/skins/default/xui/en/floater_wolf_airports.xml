<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- [AIRPORTS 2026-10-10] The flight deck's AIRPORTS button and Wolf World > Airports (wolffloaterairports.cpp).
     Paul: "the airports button on the aircraft hud should have its own floater for search from airports not open
     web browser". The grid's airports directory, searched by name or region; Fly there sets the autopilot's route
     (no teleport: "we dont teleport we fly with autopilot or follow the route"). -->
<floater
 can_close="true"
 can_minimize="true"
 can_resize="true"
 height="400"
 layout="topleft"
 min_height="260"
 min_width="480"
 name="wolf_airports"
 help_topic="wolf_airports"
 save_rect="true"
 single_instance="true"
 title="Airports"
 width="600">
    <text follows="left|top|right" font="SansSerifBold" height="18" layout="topleft" left="10" name="title_text" top="26" width="580">Wolf Territories airports</text>
    <text follows="left|top|right" height="16" layout="topleft" left="10" name="summary" top="46" width="580" text_color="LtGray_50">Loading the airports list...</text>
    <search_editor follows="left|top|right" height="22" label="Airport name or region (type or paste)" layout="topleft" left="10" max_length_chars="64" name="search" top="70" width="580"
     tool_tip="Type part of an airport's name or its region - or paste it (Ctrl+V). The list follows as you type." />
    <scroll_list
     draw_heading="true"
     follows="all"
     height="240"
     layout="topleft"
     left="10"
     multi_select="false"
     name="airports"
     search_column="0"
     top="100"
     tool_tip="Double-click an airport to fly there."
     width="580">
        <scroll_list.columns label="Airport" name="name" relative_width="0.48" />
        <scroll_list.columns label="Region" name="region" relative_width="0.34" />
        <scroll_list.columns label="Distance" name="distance" relative_width="0.18" />
    </scroll_list>
    <button follows="left|bottom" height="22" label="Airports website" layout="topleft" left="10" name="website" top="350" width="130"
     tool_tip="The airports page on wolf-grid.com, where owners add their airports." />
    <button follows="right|bottom" height="22" label="Show on map" layout="topleft" left="370" name="show_map" top="350" width="105"
     tool_tip="Show this airport on the World Map." />
    <button follows="right|bottom" height="22" label="Fly there" layout="topleft" left="480" name="fly" top="350" width="110"
     tool_tip="Set this airport as the autopilot's destination and fly the route there; it lands on the runway it finds." />
</floater>
