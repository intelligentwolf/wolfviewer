#!/usr/bin/env python3
"""[WOLFLEAP 2026-10-24] Send one request to the running viewer through bridge.py's socket and print the JSON reply.
  wolfctl '{"pump":"LLAgent","data":{"op":"getPosition"}}'
  wolfctl apis                      # every event API the viewer offers (LLLeapListener getAPIs)
  wolfctl api LLAgent               # one API's ops and their help text
  wolfctl snapshot /path/file.png   # LLViewerWindow saveSnapshot
  wolfctl pos | nearby | login
  wolfctl tp "<Region Name>" [x y [z]]   # [2026-10-31] teleport by region name, region-local metres (any size of
                                     # region); waits for the result and exits 1 on "region not found" /
                                     # "teleport failed: <reason>"
Exit status: 0 when the viewer replied without an ["error"], 1 otherwise.
"""
import json, os, socket, sys

SOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or os.path.expanduser("~/.cache"), "wolfleap.sock")


def call(req):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(SOCK)
    s.sendall((json.dumps(req) + "\n").encode())
    buf = b""
    while not buf.endswith(b"\n"):
        chunk = s.recv(65536)
        if not chunk:
            break
        buf += chunk
    return json.loads(buf)


def main(a):
    if not a:
        print(__doc__)
        return 2
    cmd = a[0]
    if cmd.startswith("{"):
        req = json.loads(cmd)
    elif cmd == "apis":
        req = {"data": {"op": "getAPIs"}}
    elif cmd == "api":
        req = {"data": {"op": "getAPI", "api": a[1]}}
    elif cmd == "snapshot":
        req = {"pump": "LLViewerWindow", "data": {"op": "saveSnapshot", "filename": os.path.abspath(a[1])}, "timeout": 30}
    elif cmd == "pos":
        req = {"pump": "LLAgent", "data": {"op": "getPosition"}}
    elif cmd == "nearby":
        req = {"pump": "LLAgent", "data": {"op": "getNearbyAvatarsList"}}
    elif cmd == "login":
        req = {"pump": "LLPanelLogin", "data": {"op": "onClickConnect"}, "noreply": True}
    elif cmd == "tp":
        # LLAgent requestTeleport with skip_confirmation (wolfviewer llagentlistener.cpp): the viewer looks the region
        # up (up to 20 s) and then waits for the teleport (up to 60 s) before it replies, so wait longer than both.
        if len(a) not in (2, 4, 5):
            print('usage: wolfctl tp "<Region Name>" [x y [z]]', file=sys.stderr)
            return 2
        data = {"op": "requestTeleport", "regionname": a[1], "skip_confirmation": True}
        try:
            for key, val in zip(("x", "y", "z"), a[2:]):
                data[key] = float(val)
        except ValueError:
            print('usage: wolfctl tp "<Region Name>" [x y [z]]  (x, y, z are numbers of metres)', file=sys.stderr)
            return 2
        req = {"pump": "LLAgent", "data": data, "timeout": 90}
    else:
        print("unknown command", cmd, file=sys.stderr)
        return 2
    out = call(req)
    print(json.dumps(out, indent=1))
    reply = out.get("reply")
    return 0 if out.get("ok") and not (isinstance(reply, dict) and reply.get("error")) else 1


sys.exit(main(sys.argv[1:]))
