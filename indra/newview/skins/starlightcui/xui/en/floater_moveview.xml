<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- [SKIN PORT 2026-09-13] A skin's own XUI file REPLACES the default one (lldir.h findSkinnedFilenames, CURRENT_SKIN), so every WolfViewer change to the default file has to be carried here too. This file = the WolfViewer default file with this skin's own deviations re-applied. -->
<floater
 positioning="specified"
 right="-10"
 bottom="-50"
 legacy_header_height="18"
 bg_opaque_color="SL-CustomBackground"
 bg_alpha_color="SL-CustomBackground"
 background_visible="true"
 background_opaque="false"
 can_dock="false"
 can_minimize="false"
 can_close="false"
 can_resize="true"
 height="162"
 layout="topleft"
 min_height="162"
 min_width="196"
 name="move_floater"
 help_topic=""
 save_rect="true"
 save_visibility="true"
 single_instance="true"
 chrome="true"
 show_title="false"
 width="196">
    <string
     name="walk_forward_tooltip">
        Walk Forward (press Up Arrow or W)
    </string>
    <string
     name="walk_back_tooltip">
        Walk Backwards (press Down Arrow or S)
    </string>
    <string
     name="walk_left_tooltip">
        Walk left (press Shift + Left Arrow or A)
    </string>
    <string
     name="walk_right_tooltip">
        Walk right (press Shift + Right Arrow or D)
    </string>
    <string
     name="run_forward_tooltip">
        Run Forward (press Up Arrow or W)
    </string>
    <string
     name="run_back_tooltip">
        Run Backwards (press Down Arrow or S)
    </string>
    <string
     name="run_left_tooltip">
        Run left (press Shift + Left Arrow or A)
    </string>
    <string
     name="run_right_tooltip">
        Run right (press Shift + Right Arrow or D)
    </string>
    <string
     name="fly_forward_tooltip">
        Fly Forward (press Up Arrow or W)
    </string>
    <string
     name="fly_back_tooltip">
        Fly Backwards (press Down Arrow or S)
    </string>
    <string
     name="fly_left_tooltip">
        Fly left (press Shift + Left Arrow or A)
    </string>
    <string
     name="fly_right_tooltip">
        Fly right (press Shift + Right Arrow or D)
    </string>
    <string
     name="fly_up_tooltip">
        Fly up (press E)
    </string>
    <string
     name="fly_down_tooltip">
        Fly down (press C)
    </string>
    <string
     name="jump_tooltip">
        Jump (press E)
    </string>
    <string
     name="crouch_tooltip">
        Crouch (press C)
    </string>
    <string
     name="walk_title">
    </string>
    <string
     name="run_title">
    </string>
    <string
     name="fly_title">
    </string>
    <!-- WolfViewer 2026-09-25: Joysticks | Buttons | Vehicle tabs. "Joysticks" is the analogue
         movement stick (lljoystickbutton.cpp wolf_analog, after WolfStorm's
         js/input/touch_controls.js: push up/down to walk, left/right to turn) with fly-up /
         fly-down beside it. "Buttons" is Firestorm's own 4 x 2 arrow grid, restored exactly
         as floater_moveview.xml had it before the 09-06 joystick commit (same widget types,
         names, images and tool tips), scaled up to the floater's width. llmoveview.cpp
         flips the panes and remembers the choice in WolfMoveControlsButtons /
         WolfMoveControlsVehicle. "Vehicle" (after WolfStorm's Vehicle tab) is a steering
         wheel, a D / N / R gear lever, a brake and an accelerator that show the driving keys
         (Up / W, Down / S, Left / Right, Page Up / Down) — wolfvehiclecontrols.cpp.
         The walk / run / fly row (and the Stand / Stop Flying dock in modes_container) is
         shared. -->
    <panel
     border="false"
     top="4"
     follows="all"
     layout="topleft"
     left="4"
     mouse_opaque="false"
     name="panel_actions"
     height="156"
     width="188">
        <button
         follows="left|top"
         height="20"
         image_unselected="TabTop_Left_Off"
         image_selected="TabTop_Left_Selected"
         image_pressed="TabTop_Left_Selected"
         image_pressed_selected="TabTop_Left_Selected"
         label="Joysticks"
         layout="topleft"
         left="0"
         name="joysticks_tab"
         tool_tip="Show the analogue movement stick"
         top="0"
         width="63"/>
        <button
         follows="left|top"
         height="20"
         image_unselected="TabTop_Middle_Off"
         image_selected="TabTop_Middle_Selected"
         image_pressed="TabTop_Middle_Selected"
         image_pressed_selected="TabTop_Middle_Selected"
         label="Buttons"
         layout="topleft"
         left="63"
         name="buttons_tab"
         tool_tip="Show the movement arrow buttons"
         top="0"
         width="62"/>
        <button
         follows="left|top"
         height="20"
         image_unselected="TabTop_Right_Off"
         image_selected="TabTop_Right_Selected"
         image_pressed="TabTop_Right_Selected"
         image_pressed_selected="TabTop_Right_Selected"
         label="Vehicle"
         layout="topleft"
         left="125"
         name="vehicle_tab"
         tool_tip="Show the steering wheel, gear lever and accelerator"
         top="0"
         width="63"/>
        <panel
         border="false"
         follows="left|top"
         height="104"
         layout="topleft"
         left="0"
         mouse_opaque="false"
         name="move_sticks_panel"
         top="24"
         width="188">
            <joystick_turn
             wolf_analog="true"
             follows="left|top"
             height="104"
             width="104"
             image_selected="Movement_Forward_On"
             image_pressed_selected="Movement_Forward_On"
             image_unselected="Movement_Forward_Off"
             layout="topleft"
             left="0"
             name="move stick"
             quadrant="up"
             scale_image="true"
             sound_flags="3"
             held_down_delay.seconds="0.0"
             tool_tip="Movement stick: push up to walk forward, down to walk back, left and right to turn (or use the arrow keys / WASD)"
             top="0"/>
            <button
             height="40"
             follows="left|top"
             image_selected="Movement_Up_On"
             image_pressed_selected="Movement_Up_On"
             image_unselected="Movement_Up_Off"
             layout="topleft"
             left="128"
             name="stick up btn"
             width="40"
             scale_image="true"
             tool_tip="Fly up (press E)"
             top="8"/>
            <button
             height="40"
             follows="left|top"
             image_selected="Movement_Down_On"
             image_pressed_selected="Movement_Down_On"
             image_unselected="Movement_Down_Off"
             layout="topleft"
             left="128"
             name="stick down btn"
             width="40"
             scale_image="true"
             tool_tip="Fly down (press C)"
             top="56"/>
        </panel>
        <panel
         border="false"
         follows="left|top"
         height="104"
         layout="topleft"
         left="0"
         mouse_opaque="false"
         name="move_buttons_panel"
         top="24"
         visible="false"
         width="188">
        <layout_stack
         border_size="0"
         top="0"
         enabled="true"
         height="104"
         left="0"
         mouse_opaque="false"
         name="ls_vertical"
         orientation="vertical"
         width="188"
         follows="all">
            <layout_panel
             mouse_opaque="false"
             name="lp_row1"
             user_resize="false"
             width="188"
             height="52">
                <layout_stack
                 border_size="0"
                 top="0"
                 enabled="true"
                 height="52"
                 left="0"
                 mouse_opaque="false"
                 name="ls_horizontal1"
                 orientation="horizontal"
                 width="188"
                 follows="all">
                    <layout_panel
                     mouse_opaque="false"
                     name="lp_col1_1"
                     user_resize="false"
                     height="52"
                     width="47">
                        <button
                         height="52"
                         follows="all"
                         image_selected="Movement_TurnLeft_On"
                         image_pressed_selected="Movement_TurnLeft_On"
                         image_unselected="Movement_TurnLeft_Off"
                         layout="topleft"
                         left="0"
                         name="turn left btn"
                         width="47"
                         scale_image="true"
                         tool_tip="Turn left (press Left Arrow or A)"
                         top="0"/>
                    </layout_panel>
                    <layout_panel
                     mouse_opaque="false"
                     name="lp_col1_2"
                     user_resize="false"
                     height="52"
                     width="47">
                        <joystick_turn
                         height="52"
                         follows="all"
                         image_selected="Movement_Forward_On"
                         image_pressed_selected="Movement_Forward_On"
                         image_unselected="Movement_Forward_Off"
                         layout="topleft"
                         left="0"
                         name="forward btn"
                         quadrant="up"
                         width="47"
                         scale_image="true"
                         tool_tip="Walk forward (press up arrow or W)"
                         top="0"/>
                    </layout_panel>
                    <layout_panel
                     mouse_opaque="false"
                     name="lp_col1_3"
                     user_resize="false"
                     height="52"
                     width="47">
                        <button
                         height="52"
                         follows="all"
                         image_selected="Movement_TurnRight_On"
                         image_pressed_selected="Movement_TurnRight_On"
                         image_unselected="Movement_TurnRight_Off"
                         layout="topleft"
                         left="0"
                         name="turn right btn"
                         width="47"
                         scale_image="true"
                         tool_tip="Turn right (press Right Arrow or D)"
                         top="0"/>
                    </layout_panel>
                    <layout_panel
                     mouse_opaque="false"
                     name="lp_col1_4"
                     user_resize="false"
                     height="52"
                     width="47">
                        <button
                         height="52"
                         follows="all"
                         image_selected="Movement_Up_On"
                         image_pressed_selected="Movement_Up_On"
                         image_unselected="Movement_Up_Off"
                         layout="topleft"
                         left="0"
                         name="move up btn"
                         width="47"
                         scale_image="true"
                         tool_tip="Fly up (press E)"
                         top="0"/>
                    </layout_panel>
                </layout_stack>
            </layout_panel>
            <layout_panel
             mouse_opaque="false"
             name="lp_row2"
             user_resize="false"
             width="188"
             height="52">
                <layout_stack
                 border_size="0"
                 top="0"
                 enabled="true"
                 height="52"
                 left="0"
                 mouse_opaque="false"
                 name="ls_horizontal2"
                 orientation="horizontal"
                 width="188"
                 follows="all">
                    <layout_panel
                     mouse_opaque="false"
                     name="lp_col2_1"
                     user_resize="false"
                     height="52"
                     width="47">
                        <joystick_slide
                         height="52"
                         follows="all"
                         image_selected="Movement_Left_On"
                         image_pressed_selected="Movement_Left_On"
                         image_unselected="Movement_Left_Off"
                         layout="topleft"
                         left="0"
                         name="move left btn"
                         quadrant="left"
                         width="47"
                         scale_image="true"
                         tool_tip="Walk left (press Shift + Left Arrow or A)"
                         top="0"/>
                    </layout_panel>
                    <layout_panel
                     mouse_opaque="false"
                     name="lp_col2_2"
                     user_resize="false"
                     height="52"
                     width="47">
                        <joystick_turn
                         height="52"
                         follows="all"
                         image_selected="Movement_Backward_On"
                         image_pressed_selected="Movement_Backward_On"
                         image_unselected="Movement_Backward_Off"
                         layout="topleft"
                         left="0"
                         name="backward btn"
                         quadrant="down"
                         width="47"
                         scale_image="true"
                         tool_tip="Walk backward (press down arrow or S)"
                         top="0"/>
                    </layout_panel>
                    <layout_panel
                     mouse_opaque="false"
                     name="lp_col2_3"
                     user_resize="false"
                     height="52"
                     width="47">
                        <joystick_slide
                         height="52"
                         follows="all"
                         image_selected="Movement_Right_On"
                         image_pressed_selected="Movement_Right_On"
                         image_unselected="Movement_Right_Off"
                         layout="topleft"
                         left="0"
                         name="move right btn"
                         quadrant="right"
                         width="47"
                         scale_image="true"
                         tool_tip="Walk right (press Shift + Right Arrow or D)"
                         top="0"/>
                    </layout_panel>
                    <layout_panel
                     mouse_opaque="false"
                     name="lp_col2_4"
                     user_resize="false"
                     height="52"
                     width="47">
                        <button
                         height="52"
                         follows="all"
                         image_selected="Movement_Down_On"
                         image_pressed_selected="Movement_Down_On"
                         image_unselected="Movement_Down_Off"
                         layout="topleft"
                         left="0"
                         name="move down btn"
                         width="47"
                         scale_image="true"
                         tool_tip="Fly down (press C)"
                         top="0"/>
                    </layout_panel>
                </layout_stack>
            </layout_panel>
        </layout_stack>
        </panel>
        <!-- Vehicle: wheel | lever | brake | accelerator (WolfStorm css/touch_controls.css order). -->
        <panel
         border="false"
         follows="left|top"
         height="104"
         layout="topleft"
         left="0"
         mouse_opaque="false"
         name="move_vehicle_panel"
         top="24"
         visible="false"
         width="188">
            <wolf_steering_wheel
             follows="left|top"
             height="96"
             layout="topleft"
             left="0"
             name="steering wheel"
             tool_tip="Steering wheel: turns with Left / Right Arrow or A / D (or drag it left or right)"
             top="4"
             width="96"/>
            <button
             follows="left|top"
             height="30"
             label="D"
             layout="topleft"
             left="100"
             name="gear_d_btn"
             tool_tip="Drive (Page Up shifts up)"
             top="4"
             width="28"/>
            <button
             follows="left|top"
             height="30"
             label="N"
             layout="topleft"
             left="100"
             name="gear_n_btn"
             tool_tip="Neutral"
             top="37"
             width="28"/>
            <button
             follows="left|top"
             height="30"
             label="R"
             layout="topleft"
             left="100"
             name="gear_r_btn"
             tool_tip="Reverse (Page Down shifts down)"
             top="70"
             width="28"/>
            <wolf_pedal
             wolf_brake="true"
             follows="left|top"
             height="64"
             layout="topleft"
             left="132"
             name="brake"
             tool_tip="Brake: lights with Down Arrow or S (or hold it to go back)"
             top="36"
             width="24"/>
            <wolf_pedal
             follows="left|top"
             height="96"
             layout="topleft"
             left="160"
             name="accelerator"
             tool_tip="Accelerator: lights with Up Arrow or W (or hold it to go forward)"
             top="4"
             width="26"/>
        </panel>
        <!-- modes_container is where LLPanelStandStopFlying docks (llmoveview.cpp ~709) and
             reshapes itself to; panel_modes' width and height should be synchronized with
             panel_stand_stop_flying.xml -->
        <panel
         mouse_opaque="false"
         border="false"
         height="21"
         layout="topleft"
         left="0"
         name="modes_container"
         top="132"
         width="188">
        <panel
         mouse_opaque="false"
         border="false"
         height="21"
         layout="topleft"
         left="55"
         name="panel_modes"
         top="0"
         width="78">
            <button
             follows="left|bottom"
             height="19"
             image_overlay="Move_Walk_Off"
             image_selected="PushButton_Selected_Press"
             layout="topleft"
             name="mode_walk_btn"
             left="0"
             pad_right="0"
             tool_tip="Walking mode"
             top="0"
             width="26" />
            <button
             follows="left|bottom"
             height="19"
             image_overlay="Move_Run_Off"
             image_selected="PushButton_Selected_Press"
             layout="topleft"
             left_pad="0"
             name="mode_run_btn"
             pad_left="0"
             pad_right="0"
             tool_tip="Running mode"
             top="0"
             width="26" />
            <button
             follows="left|bottom"
             height="19"
             image_overlay="Move_Fly_Off"
             image_selected="PushButton_Selected_Press"
             layout="topleft"
             left_pad="0"
             name="mode_fly_btn"
             pad_left="0"
             pad_right="0"
             tool_tip="Flying mode"
             top="0"
             width="26" />
        </panel>
        </panel>
    </panel>
</floater>
