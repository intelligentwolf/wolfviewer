   <!-- the two page tabs (the chosen one has an ember label and rim, painted by the forge) -->
   <button follows="left|top" layout="topleft" left="24" top="150" width="110" height="24" name="ai_text_tab_letters" label="Letters"
    tool_tip="The style, the font, the size and the name"
    image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
    label_color="0.97 0.93 0.9 1" label_color_selected="1 0.702 0.42 1" label_color_disabled="0.79 0.72 0.67 1" label_color_disabled_selected="0.79 0.72 0.67 1" />
   <button follows="left|top" layout="topleft" left="140" top="150" width="150" height="24" name="ai_text_tab_lights" label="Colour and lights"
    tool_tip="The colour, a texture, the glow and the lights"
    image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
    label_color="0.97 0.93 0.9 1" label_color_selected="1 0.702 0.42 1" label_color_disabled="0.79 0.72 0.67 1" label_color_disabled_selected="0.79 0.72 0.67 1" />
