     decimal_digits="0"
     follows="left|top"
     height="20"
     increment="1"
     label="Agent Limit"
     label_width="97"
     layout="topleft"
     left="10"
     max_val="100"
     min_val="1"
     name="agent_limit_spin"
     top="260"
     width="170" />
    <spinner
     follows="left|top"
     height="20"
     increment="0.5"
     label="Object Bonus"
     label_width="97"
     layout="topleft"
     left="10"
     max_val="10"
     min_val="1"
     name="object_bonus_spin"
     top="280"
     width="170" />
    <text
     follows="left|top"
     height="20"
     label="Maturity"
     layout="topleft"
     left="10"
     name="access_text"
     top="310"
     width="100">
        Rating:
    </text>
    <icons_combo_box
     follows="left|top"
     height="20"
     label="Moderate"
     layout="topleft"
     left_delta="100"
     name="access_combo"
     top_delta="0"
     width="105">
        <icons_combo_box.drop_down_button
         image_overlay="Parcel_M_Light"
         image_overlay_alignment="left"
         imgoverlay_label_space="3"
         pad_left="3"/>
        <icons_combo_box.item
         label="Adult"
         name="Adult"
         value="42">
            <item.columns
             halign="center"
             type="icon"
             value="Parcel_R_Light"
             width="20"/>
          </icons_combo_box.item>
        <icons_combo_box.item
         label="Moderate"
         name="Mature"
         value="21">
            <item.columns
             halign="center"
             type="icon"
             value="Parcel_M_Light"
             width="20"/>
        </icons_combo_box.item>
        <icons_combo_box.item
         label="General"
         name="PG"
         value="13">
            <item.columns
             halign="center"
             type="icon"
             value="Parcel_PG_Light"
             width="20"/>
        </icons_combo_box.item>
    </icons_combo_box>
    <!-- [ADULT CONTENT 2026-10-26] llfloaterregioninfo.cpp processRegionInfo. Who and why: a region owner wants to see
         whether the region is Adult Content and find where that is set, in one click. Adult Content is set only on
         wolf-grid.com (region-terrain-work/adult-content/PROTOCOL.md §7), never from here; the icon and text show
         beside the rating when it is on, the link button on Wolf Territories only. -->
    <icon
     follows="left|top"
     height="16"
     image_name="Parcel_AC_Light"
     layout="topleft"
     left="222"
     name="wolf_adult_content_icon"
     top="312"
     visible="false"
     width="18" />
    <text
     follows="left|top"
     height="20"
     layout="topleft"
     left="244"
     name="wolf_adult_content_text"
     tool_tip="Only residents who have completed an age check can enter this region. Hypergrid visitors can't enter."
     top="312"
     visible="false"
     width="226">
        Adult Content
    </text>
    <button
     follows="left|top"
     height="20"
     label="Region type on wolf-grid.com..."
     layout="topleft"
     left="222"
     name="wolf_region_type_btn"
     tool_tip="Open this region's type on wolf-grid.com in your browser. Adult Content is set there by the region owner or the estate owner, never from the viewer."
     top="340"
     visible="false"
     width="230" />
    <!-- [ADULT CONTENT 2026-10-26] W81: shown after the Rating dropdown's Adult Content choice (or another rating while it
         is one) opened wolf-grid.com - llfloaterregioninfo.cpp wolf_ac_on_access_commit. Right of the Teleport Home
         buttons, which end at x 260. -->
    <text
     follows="left|top"
     height="64"
     layout="topleft"
     left="270"
     name="wolf_region_type_note"
     top="368"
     visible="false"
     width="200"
     wrap="true" />
    <button
     enabled="false"
     follows="left|top"
     height="20"
     label="Apply"
     layout="topleft"
     left="108"
     name="apply_btn"
     top="340"
     width="100"/> 
    <button
     follows="left|top"
     height="20"
     label="Teleport Home One Resident..."
     layout="topleft"
     left="10"
     name="kick_btn"
     top_pad="10"
     width="250" />
    <button
     follows="left|top"
     height="20"
     label="Teleport Home All Residents..."
     layout="topleft"
     left_delta="0"
     name="kick_all_btn"
     top_pad="3"
     width="250" />
    <button
     follows="left|top"
     height="20"
     label="Send Message To Region..."
     layout="topleft"
     left_delta="0"
     name="im_btn"
     top_pad="20"
     width="200" />
    <button
     follows="left|top"
     height="20"
     label="Manage Telehub..."
     layout="topleft"
     left="250"
     name="manage_telehub_btn"
     top="70"
     width="180">
		<button.commit_callback
         function="RegionInfo.ManageTelehub" />
    </button>
    <button
     follows="left|top"
     height="20"
     label="Manage Restart Schedule..."
     layout="topleft"
     name="manage_restart_btn"
     top_pad="5"
     left_delta="0"
     width="180">
        <button.commit_callback
         function="RegionInfo.ManageRestart" />
    </button>
    <!-- [PASSING PLANES 2026-11-01] wolfpassingplanes.cpp. Who and why: an estate owner or manager wants the passing tour
         planes off over a themed region (or on over an airfield) in one click, and to see that it took. Wolf Territories
         only (hidden elsewhere). Saved at once through php/wolf_ambient.php, not by Apply (no initCtrl).
         [BIRDS 2026-11-02] ticket 445: "Birds over this region", the same record and the same rules.
         [NATURE SOUNDS 2026-11-03] ticket 475: "Nature sounds on this region", the same again.
         [TICKET 481 2026-11-03] Buzzy Cnayl: the planes and birds texts overlapped each other (fixed-height boxes in the
         220-wide right column; a wrapped line ran into the box below). All three switches now sit full width under the
         buttons (Send Message To Region ends at y 453; the right column's Region type note at 432), and
         wolfpassingplanes.cpp layout() stacks them top-down each time their text changes: every text box takes the height
         its wrapped text needs, at any font size, and the window grows if the stack would run past its bottom. The tops
         and heights here are only the starting points. -->
    <check_box
     follows="left|top"
     height="20"
     label="Passing planes over this region"
     layout="topleft"
     left="10"
     name="wolf_planes_check"
     tool_tip="Vintage tour planes that fly across this region now and then. People's own aircraft and dogfights are not affected. Saved at once. Only the estate owner or an estate manager can change it."
     top="462"
     visible="false"
     width="460" />
    <text
     follows="left|top"
     font="SansSerifSmall"
     height="16"
     layout="topleft"
     left="28"
     name="wolf_planes_state"
     top="482"
     visible="false"
     width="442"
     wrap="true" />
    <text
     follows="left|top"
     font="SansSerifSmall"
     height="16"
     layout="topleft"
     left="28"
     name="wolf_planes_note"
     top="498"
     visible="false"
     width="442"
     wrap="true">
        People's own aircraft and dogfights are not affected.
    </text>
    <check_box
     follows="left|top"
     height="20"
     label="Birds over this region"
     layout="topleft"
     left="10"
     name="wolf_birds_check"
     tool_tip="Gulls and terns over the sea, small flocks over open land and starlings at dusk in winter. They keep clear of builds, stay low over land and sea, roost at night, and never fly in a space sky. With no category, they come over the sea and coast only: untick and tick again to have them over the land as well. Saved at once. Only the estate owner or an estate manager can change it."
     top="520"
     visible="false"
     width="460" />
    <text
     follows="left|top"
     font="SansSerifSmall"
     height="16"
     layout="topleft"
     left="28"
     name="wolf_birds_state"
     top="540"
     visible="false"
     width="442"
     wrap="true" />
    <check_box
     follows="left|top"
     height="20"
     label="Nature sounds on this region"
     layout="topleft"
     left="10"
     name="wolf_sounds_check"
     tool_tip="Crickets on warm nights (only where and when the place and the time of year would have them), soft lapping by lakes and ponds, and waves at the shore that follow the real waves. Each visitor hears them in their own viewer, at their Ambient volume, and can switch them off for themselves. Saved at once. Only the estate owner or an estate manager can change it."
     top="562"
     visible="false"
     width="460" />
    <text
     follows="left|top"
     font="SansSerifSmall"
     height="16"
     layout="topleft"
     left="28"
     name="wolf_sounds_state"
     top="582"
     visible="false"
     width="442"
     wrap="true" />
    <text
     follows="left|top"
     font="SansSerifSmall"
     height="16"
     layout="topleft"
     left="28"
     name="wolf_planes_status"
     top="604"
     visible="false"
     width="442"
     wrap="true" />
    <string name="planes_reading">Reading passing planes for this region...</string>
    <string name="planes_on_default">On: the default for regions listed under Airports. Untick to stop them.</string>
    <string name="planes_off_default">Off: the default for regions not listed under Airports. Tick to allow them.</string>
