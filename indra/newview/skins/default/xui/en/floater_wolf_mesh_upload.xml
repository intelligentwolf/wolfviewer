<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
 WolfViewer — Wolf Territories Grid model uploader.
 Source: wolfstorm/js/ui/floaters/floater_mesh_upload.js buildContent() — the same fields, the
 same wording and the same order as the web viewer's uploader, so a user who has used one
 recognises the other.

 [BLUEPRINT LOOK 2026-10-20] Paul: "upgrade the mesh upload floater make it look really nice as well ... as nice as the new
 avatar and clothing generator but not the same". "The Drawing Office": a blueprint sheet drawn in code behind these
 controls (WolfFloaterMeshUpload::drawSheet, the technique of the radio and WolfAvatars): cobalt paper with a drafting grid,
 a wireframe box with dimension lines, the title block, four stamps (Choose - Check - Upload - Done), three cards (the model
 file, the spec sheet with the model's numbers in cells, what it is called in your inventory), the status on its own plate
 (red with a warning mark for an error, which stays until the next action) and every button's face. layoutWidgets() places
 every control below on each resize, so the positions here are only a starting point. The buttons draw no skin image
 (image_color 0 alpha, as WolfAvatars' and the radio's): the sheet paints them underneath; their labels, keyboard focus and
 tooltips are the buttons' own. Text colours are fixed, not the skin's, because the text sits on the fixed drawn paper
 (contrast of each pair in wolffloatermeshupload.cpp, all at least 4.5:1). Same ids, callbacks and behaviour as before.
-->
<floater
 legacy_header_height="18"
 can_close="true"
 can_minimize="true"
 can_resize="true"
 height="760"
 layout="topleft"
 min_height="700"
 min_width="480"
 name="wolf_mesh_upload"
 help_topic="wolf_mesh_upload"
 save_rect="true"
 single_instance="true"
 title="Upload Model"
 width="560">
  <!-- lettering drawn on the sheet (not widgets) -->
  <floater.string name="title">UPLOAD MODEL</floater.string>
  <floater.string name="site">Drawing office  -  wolf-grid.com</floater.string>
  <floater.string name="stages">CHOOSE,CHECK,UPLOAD,DONE</floater.string>
  <floater.string name="card_file">THE MODEL FILE</floater.string>
  <floater.string name="card_spec">SPEC SHEET</floater.string>
  <floater.string name="card_item">IN YOUR INVENTORY</floater.string>
  <floater.string name="cells">FACES,VERTICES,TRIANGLES,SIZE (M),REZZES AS</floater.string>
  <floater.string name="spec_empty">Choose a model and its numbers appear here before anything is sent.</floater.string>

  <text type="string" length="1" follows="left|top" height="32" layout="topleft" left="150" name="blurb"
   text_color="0.74 0.82 0.93 1" top="60" width="390" word_wrap="true">
    Straight to your inventory as a rezzable mesh object. No LODs or physics to set up.
  </text>

  <button follows="left|top" height="30" label="Choose file..." layout="topleft" left="30" name="browse_btn" top="190" width="130"
   image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false" use_ellipses="true"
   label_color="0.94 0.97 1 1" label_color_selected="0.94 0.97 1 1" label_color_disabled="0.66 0.74 0.84 1" label_color_disabled_selected="0.66 0.74 0.84 1"
   tool_tip="Choose an OBJ, glTF or GLB model" />

  <text type="string" length="1" follows="left|top" font="Monospace" height="18" layout="topleft" left="170" name="file_name"
   text_color="0.94 0.97 1 1" top="196" width="360" use_ellipses="true">
    No file chosen
  </text>

  <text type="string" length="1" follows="left|top" height="30" layout="topleft" left="30" name="formats"
   text_color="0.74 0.82 0.93 1" top="228" width="500" word_wrap="true">
    OBJ, glTF and GLB. Textures and .mtl files are read from the same folder as the model. For COLLADA (.dae) use Old Upload.
  </text>

  <!-- the spec sheet's notes: what the model's textures will do, and whether it was simplified (Model::summary after its
       first line; the first line's numbers are drawn as the cells above it). A parse failure's reason shows here too. -->
  <text type="string" length="1" follows="left|top" height="80" layout="topleft" left="30" name="info"
   text_color="0.94 0.97 1 1" top="380" width="500" word_wrap="true" />

  <text type="string" length="1" follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="30" name="name_label"
   text_color="0.94 0.97 1 1" top="480" width="240">
    Name
  </text>

  <line_editor follows="left|top" height="22" layout="topleft" left="30" max_length_bytes="63" name="name_edit"
   top="498" width="240" tool_tip="The object's name in your inventory" />

  <text type="string" length="1" follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="290" name="desc_label"
   text_color="0.94 0.97 1 1" top="480" width="240">
    Description (optional)
  </text>

  <line_editor follows="left|top" height="22" layout="topleft" left="290" max_length_bytes="127" name="desc_edit"
   top="498" width="240" />

  <check_box control_name="WolfMeshUploadIncludeTextures" follows="left|top" height="16" initial_value="true"
   label="Include textures" layout="topleft" left="30" name="include_textures" top="530" width="240"
   tool_tip="Each distinct texture is uploaded as its own inventory item, at the usual texture upload cost">
    <check_box.label_text text_color="0.94 0.97 1 1" />
  </check_box>

  <text type="string" length="1" follows="left|top" height="16" layout="topleft" left="50" name="tex_note"
   text_color="0.74 0.82 0.93 1" top="548" width="480" use_ellipses="true">
    Each distinct texture is uploaded as its own inventory item.
  </text>

  <text type="string" length="1" follows="left|top" font="SansSerifBold" height="40" layout="topleft" left="44" name="status"
   text_color="0.94 0.97 1 1" top="590" width="480" word_wrap="true" />

  <button follows="left|top" height="40" label="Cancel" layout="topleft" left="14" name="cancel_btn" top="646" width="110"
   image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false" use_ellipses="true"
   label_color="0.94 0.97 1 1" label_color_selected="0.94 0.97 1 1" label_color_disabled="0.66 0.74 0.84 1" label_color_disabled_selected="0.66 0.74 0.84 1" />

  <button follows="left|top" height="40" label="Old Upload" layout="topleft" left="132" name="old_upload_btn" top="646" width="130"
   image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false" use_ellipses="true"
   label_color="0.94 0.97 1 1" label_color_selected="0.94 0.97 1 1" label_color_disabled="0.66 0.74 0.84 1" label_color_disabled_selected="0.66 0.74 0.84 1"
   tool_tip="Open the classic model uploader instead - LODs, physics, rigging and COLLADA (.dae)." />

  <button follows="left|top" height="44" label="UPLOAD" layout="topleft" left="376" name="upload_btn" top="644" width="170"
   image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false" use_ellipses="true"
   font="SansSerifBold"
   label_color="0.02 0.13 0.25 1" label_color_selected="0.02 0.13 0.25 1" label_color_disabled="0.66 0.74 0.84 1" label_color_disabled_selected="0.66 0.74 0.84 1"
   tool_tip="Upload the model straight to your inventory." />

</floater>
