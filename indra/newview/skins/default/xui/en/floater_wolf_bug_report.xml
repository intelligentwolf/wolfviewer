<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- [WOLF BUG REPORT 2026-10-24] Report a Problem (wolffloaterbugreport.cpp): the status bar's bug icon and
     Wolf World > Report a Problem... Paul: "build in a bug reporting a little bug icon on the menu that links to
     tickets and allows them to upload their logs".
     Who and why: a Wolf resident whose viewer misbehaved wants to tell support what happened, with the logs,
     in under a minute and without leaving the viewer. Flow, top to bottom: what it is about, a subject, what
     happened, the logs (on, listed), Send (bottom right); the outcome stays in the status box below the form. -->
<floater
 can_close="true"
 can_minimize="true"
 can_resize="false"
 height="486"
 layout="topleft"
 name="wolf_bug_report"
 help_topic="wolf_bug_report"
 save_rect="true"
 single_instance="true"
 title="Report a Problem"
 width="460">
    <text follows="left|top" height="44" layout="topleft" left="12" name="intro" top="26" width="436" wrap="true">Tell the Wolf Territories support team what went wrong. This opens a support ticket on wolf-grid.com; we reply there and by email to the address on your account.</text>

    <text follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="12" name="category_label" top="76" width="436">What is it about?</text>
    <combo_box follows="left|top" height="22" layout="topleft" left="12" name="category" top="94" width="436" tool_tip="Pick the closest one; the support team can change it." />

    <text follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="12" name="subject_label" top="124" width="436">Subject</text>
    <line_editor follows="left|top" height="22" layout="topleft" left="12" max_length_bytes="200" name="subject" top="142" width="436" label="For example: the viewer froze when I teleported" />

    <text follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="12" name="body_label" top="172" width="436">What happened?</text>
    <text_editor follows="left|top" height="110" layout="topleft" left="12" max_length="20000" name="body" top="190" width="436" word_wrap="true" commit_on_focus_lost="false" />

    <check_box follows="left|top" height="18" layout="topleft" left="12" name="attach_logs" top="308" width="436" initial_value="true"
     label="Attach my viewer logs" tool_tip="Helps us see what the viewer was doing. Session ids and capability links are taken out first, and only the support team can open them." />
    <text follows="left|top" height="64" layout="topleft" left="30" name="logs_list" top="328" width="418" wrap="true" text_color="LtGray_50">Looking for your logs...</text>

    <text_editor follows="left|top" height="46" layout="topleft" left="12" max_length="4096" name="status" top="396" width="436" word_wrap="true" read_only="true" parse_urls="true" show_context_menu="true" visible="false" />

    <button follows="left|bottom" height="23" layout="topleft" left="12" name="my_tickets" top="452" width="110" label="My tickets" tool_tip="Open your support tickets on wolf-grid.com in your browser" />
    <button follows="left|bottom" height="23" layout="topleft" left="130" name="open_ticket" top="452" width="120" label="Open the ticket" tool_tip="Open the ticket you just sent in your browser" visible="false" />
    <button follows="right|bottom" height="23" layout="topleft" left="348" name="send" top="452" width="100" label="Send" />
</floater>
