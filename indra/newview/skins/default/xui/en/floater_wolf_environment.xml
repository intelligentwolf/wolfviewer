<!-- [WOLF ENV 2026-10-12] World > Wolf World > Wolf Environment. Code: wolffloaterenvironment.cpp.
     Service: wolfstorm php/wolf_environment.php (format: php/wolf_env_lib.php). Our own layout (Paul
     10-03: new features do not copy Firestorm's look): what to change on the left, the value on the
     right, one spacing grid of 4 px rows of 24, the scope above the tabs and the one primary action
     (Save for everyone) bottom right, away from Remove at the bottom left.
     Basics is what most owners need; Sky and Suns & moons are the advanced section for fantasy and
     alien skies; Zones are local areas. -->
<floater
 legacy_header_height="18"
 can_resize="true"
 height="748"
 min_height="300"
 min_width="536"
 layout="topleft"
 name="wolf_environment"
 help_topic="wolf_environment"
 save_rect="true"
 single_instance="true"
 title="Wolf Environment"
 width="536">
  <floater.string name="str_loading">Reading this region's Wolf Environment...</floater.string>
  <floater.string name="str_read_failed">Could not read the Wolf Environment:</floater.string>
  <floater.string name="str_unsaved">Changed. Preview it, or Save for everyone.</floater.string>
  <floater.string name="str_saving">Saving...</floater.string>
  <floater.string name="str_saved">Saved. The sky changes for everyone in the region within a minute.</floater.string>
  <floater.string name="str_removed">Removed. The sky goes back to what it was before within a minute.</floater.string>
  <floater.string name="str_save_failed">Could not save:</floater.string>
  <floater.string name="str_conflict">Someone else changed these settings, so they have been reloaded. Your changes are still shown: press Save again to keep them.</floater.string>
  <floater.string name="str_fix">Some settings need fixing (marked in red):</floater.string>
  <floater.string name="str_previewing">Preview: only you see this sky. Save for everyone to keep it, or Stop preview.</floater.string>
  <floater.string name="str_preview_failed">Could not preview:</floater.string>
  <floater.string name="str_preview_no_cap">This region cannot preview yet (it has not got the Wolf Environment update). You can still save.</floater.string>
  <floater.string name="str_can_region">You can change this region's Wolf Environment.</floater.string>
  <floater.string name="str_can_parcel">You can change this parcel's Wolf Environment.</floater.string>
  <floater.string name="str_cannot_region">Only the region's owner, its estate owner or an estate manager can change the region's Wolf Environment. You are seeing it read-only.</floater.string>
  <floater.string name="str_cannot_parcel">Only this parcel's owner (or, on group land, a member allowed to change the environment) can change it. You are seeing it read-only.</floater.string>
  <floater.string name="str_no_parcel_env">This estate does not show parcel environments, so a parcel's Wolf Environment (and area zones) will not be seen until "Allow parcel environment override" is on (Region / Estate > Environment).</floater.string>
  <floater.string name="str_none_yet">Nothing set here yet: these are the starting settings. Save to switch it on.</floater.string>
  <floater.string name="str_search_short">Type at least two letters of a place name.</floater.string>
  <floater.string name="str_searching">Searching...</floater.string>
  <floater.string name="str_search_failed">Search failed:</floater.string>
  <floater.string name="str_none_found">No places found with that name.</floater.string>
  <floater.string name="str_pick">Pick a place from the list.</floater.string>
  <floater.string name="str_remove_ask">Remove the Wolf Environment from [WHAT]? Its settings are deleted and the sky goes back to what it was before Wolf. (To keep the settings for later, choose Off and Save instead.)</floater.string>

  <!-- [WOLF ENV 2026-10-16] A user on a smaller screen could not see Save / Preview: the window was a fixed
       744 px and ran off the bottom (it only fitted full screen). Now everything above the status line
       scrolls, the status and buttons are pinned to the bottom, and the window is resizable, so
       LLFloaterView::adjustToFitScreen (llfloater.cpp) shrinks it to fit the screen - it only resizes
       resizable floaters. The window is 16 px wider than the content for the 15 px scroll bar
       (settings.xml UIScrollbarSize). -->
  <scroll_container follows="all" height="652" layout="topleft" left="0" top="20" width="536"
                    name="body_scroll" opaque="false" reserve_scroll_corner="false">
  <panel follows="left|top" height="652" layout="topleft" left="0" top="0" width="520"
         name="body_panel" background_visible="false" border="false">

  <!-- the scope and who may change it -->
  <text follows="left|top" height="16" layout="topleft" left="12" top="6" width="60" name="scope_lbl">Change</text>
  <combo_box follows="left|top" height="22" layout="topleft" left="72" top="3" width="436" name="scope"
             tool_tip="The whole region's sky, or only the parcel you are standing on." />
  <text follows="left|top" height="30" layout="topleft" left="12" top="30" width="496" name="who" word_wrap="true" />

  <tab_container follows="left|top" height="520" layout="topleft" left="4" top="62" width="512"
                 name="tabs" tab_position="top" halign="center">

    <!-- ═══════════════════ BASICS ═══════════════════ -->
    <panel label="Basics" name="tab_basics" layout="topleft" follows="all" height="496" width="512">
