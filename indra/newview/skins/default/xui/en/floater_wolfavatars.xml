<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
 [WOLFAVATARS 2026-10-20] Wolf World > WolfAvatars... (llfloaterwolfavatars.cpp). Paul: the feature is WolfAvatars; it ships
 in the release "Character Colin". The screen is WOLFAVATARS_API.md "Screen (both viewers)": Person / Animal, a name,
 "Describe your character" (600 at most), the height (optional for animals), the tips line, the price and Start, the
 progress card (the % from progress, the words), the four pictures with Pick and More pictures, and the done card
 with the report lines and Open my inventory. One step panel shows at a time; every failure shows in "error" (it stays),
 with Buy credits... after a credits_short refusal. Stop asks first (stop_panel).
 Wolf Territories only: the menu item is gated by WolfGrid.IsOnWolfTerritories and onOpen closes it anywhere else.

 [2026-10-20] "The Summoning Circle" (Paul: "make it much more exciting like our radio, mixer etc"). The moonlit den - sky,
 moon, ridge and howling wolf, title plate, step stones, the Person / Animal tiles, the rune ring, the gilt picture frames,
 the plates every line of text sits on, and every button's face - is drawn in code behind these controls
 (LLFloaterWolfAvatars::drawDen()), the way the radio is (floater_wolf_radio.xml). LLFloaterWolfAvatars::layoutWidgets()
 places every control below on every resize and step change, so the positions here are only a starting point. The step
 panels cover the whole window and are not mouse-opaque, so their coordinates are the window's and empty night still drags
 the window. The buttons draw no skin image (image_color 0 alpha, as the radio's keys): the den paints them as glowing seals
 (the step's main action) and moonstones (the others) underneath; their labels, keyboard focus border and tooltips are the
 buttons' own. Text colours are fixed, not the skin's, because the text sits on fixed drawn plates (contrast of each pair in
 llfloaterwolfavatars.cpp, all at least 4.5:1).
-->
<floater
 legacy_header_height="18"
 can_close="true"
 can_minimize="true"
 can_resize="true"
 height="740"
 layout="topleft"
 min_height="720"
 min_width="720"
 name="wolf_avatars"
 help_topic="wolf_avatars"
 positioning="centered"
 save_rect="true"
 single_instance="true"
 title="WolfAvatars"
 width="800">
  <!-- lettering drawn on the den (not widgets) -->
  <floater.string name="title">WolfAvatars</floater.string>
  <floater.string name="subtitle">wolf-grid.com</floater.string>
  <!-- the five step stones, left to right, comma separated -->
  <floater.string name="stones">Describe,Pictures,Pick,Build,Done</floater.string>
  <floater.string name="person_word">Person</floater.string>
  <floater.string name="person_detail">a human</floater.string>
  <!-- [FURRY 2026-10-21] Paul: "FURRY standing or FURRY quad" - the animal tile is Furry - four legs -->
  <!-- the tile word is short: the tiles are 170-240 px wide and a longer word was cut ("FURRY - STA...", Paul 10-21) -->
  <floater.string name="furry_word">Furry</floater.string>
  <floater.string name="furry_detail">on two legs</floater.string>
  <floater.string name="animal_word">Furry</floater.string>
  <floater.string name="animal_detail">on four legs</floater.string>
  <floater.string name="chosen">chosen</floater.string>
  <floater.string name="picked">picked</floater.string>
  <!-- [BASE BODY 2026-10-20] the two clothes choices (people only), drawn as two chips on the slate; base_short is said on
       the price plaque (WOLFAVATARS_API.md Flow 1 clothes: "dressed" | "base") -->
  <floater.string name="dressed_word">Dressed as described</floater.string>
  <floater.string name="base_word">Base body - no clothes, to dress later</floater.string>
  <floater.string name="base_short">Base body</floater.string>
  <!-- [CLOTHING 2026-10-20] Paul: "could we make the clothes seperately". The third tile, and its words in place of a
       character's (WOLFAVATARS_API.md Flow 1 "Clothing": kind "clothing", garment required, no height, no clothes choice) -->
  <floater.string name="clothing_word">Clothing</floater.string>
  <floater.string name="clothing_detail">a garment alone</floater.string>
  <floater.string name="intro_clothing">Describe a garment, pick one of four pictures, and it arrives in your inventory, made to fit the WolfAvatars base body.</floater.string>
  <floater.string name="prompt_clothing">Describe the garment</floater.string>
  <floater.string name="prompt_tip_clothing">What the garment looks like: its cut, colours, fabric and pattern (600 characters at most)</floater.string>
  <!-- wolfavatars_lib.php WCH_PROMPT_GARMENT: a ghost-mannequin picture from the front, as if worn in a T-pose -->
  <floater.string name="tips_clothing">One garment - the pictures show it from the front on an invisible mannequin, as if worn in a T-pose.</floater.string>
  <floater.string name="done_clothing">Your clothes are ready</floater.string>
  <floater.string name="name_clothing">My clothes</floater.string>
  <!-- the garment chips, in the order of WOLFAVATARS_API.md "Garment types" (top, dress, trousers, skirt, shoes, hat, cape,
       gown), comma separated; a garment_detail_<value> string, where there is one, is said on the Garment line -->
  <floater.string name="garment_words">Top,Dress,Trousers,Skirt,Shoes,Hat,Cape,Gown</floater.string>
  <floater.string name="garment_label">Garment</floater.string>
  <floater.string name="garment_detail_top">shirts, jackets, jumpers</floater.string>
  <floater.string name="garment_detail_trousers">also shorts</floater.string>
  <!-- [FIGURE 2026-10-20] WOLFAVATARS_API.md "Figure": female | male - a base body's standard, or the body clothing is made for -->
  <floater.string name="figure_label">Figure</floater.string>
  <floater.string name="made_for_label">This clothing is for</floater.string>
  <!-- [MADE FOR 2026-10-20] the "This clothing is for" list: the resident's avatars (jobs: avatars), then the standard bodies -->
  <floater.string name="for_choose">Choose who it is for...</floater.string>
  <floater.string name="for_listing">Listing your avatars...</floater.string>
  <floater.string name="for_woman">Woman (the standard WolfAvatars body)</floater.string>
  <floater.string name="for_man">Man (the standard WolfAvatars body)</floater.string>
  <floater.string name="for_missing">Choose who the clothing is for: one of your avatars, or a standard body.</floater.string>
  <floater.string name="woman_word">Woman</floater.string>
  <floater.string name="man_word">Man</floater.string>

  <!-- ===== checking for a character already being made (jobs {kind: character}) ===== -->
  <panel follows="left|top" height="740" layout="topleft" left="0" mouse_opaque="false" name="loading_panel" top="0" visible="true" width="800">
    <text type="string" length="1" follows="left|top" font="SansSerifBold" halign="center" height="32" layout="topleft" left="12"
     name="loading_text" text_color="0.95 0.92 0.84 1" top="400" width="436" word_wrap="true">
      Checking for a character you were already making...
    </text>
  </panel>

  <!-- ===== 1. describe ===== -->
  <panel follows="left|top" height="740" layout="topleft" left="0" mouse_opaque="false" name="describe_panel" top="0" visible="false" width="800">
    <text type="string" length="1" follows="left|top" height="32" layout="topleft" left="12" name="intro"
     text_color="0.95 0.92 0.84 1" top="200" width="436" word_wrap="true">
      Describe a character, pick one of four pictures, and a wearable avatar arrives in your inventory.
    </text>
    <text type="string" length="1" follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="12" name="kind_label"
     text_color="0.95 0.92 0.84 1" top="240" width="200">
      What is it?
    </text>
    <button follows="left|top" height="150" is_toggle="true" label="" layout="topleft" left="12" name="person_btn" top="260" width="180"
     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
     tool_tip="Person: a human on two legs. The pictures show it in a T-pose." />
    <!-- [FURRY 2026-10-21] an animal standing as a person; placed by layoutWidgets in EKind order -->
    <button follows="left|top" height="150" is_toggle="true" label="" layout="topleft" left="12" name="furry_btn" top="420" width="180"
     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
     tool_tip="Furry - standing: an animal standing upright as a person - its head, fur and tail on two legs. Name the animal in your description or its name (a teddy bear, a fox, a cat...) - we ask if none is named." />
    <button follows="left|top" height="150" is_toggle="true" label="" layout="topleft" left="12" name="animal_btn" top="420" width="180"
     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
     tool_tip="Furry - four legs: a real animal that walks on all fours. The pictures show it side-on." />
    <!-- [CLOTHING 2026-10-20] the third tile: a garment alone, made to fit the WolfAvatars base body -->
    <button follows="left|top" height="100" is_toggle="true" label="" layout="topleft" left="12" name="clothing_btn" top="580" width="180"
     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
     tool_tip="Clothing: one garment alone, made to fit the WolfAvatars base body. Wear it (Add) over a base body." />
    <text type="string" length="1" follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="220" name="name_label"
     text_color="0.95 0.92 0.84 1" top="240" width="436">
      Name
    </text>
    <line_editor follows="left|top" height="22" layout="topleft" left="220" max_length_chars="48" name="name"
     tool_tip="The name of the folder it arrives in (48 characters at most)" top="258" width="436" />
    <text type="string" length="1" follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="220" name="prompt_label"
     text_color="0.95 0.92 0.84 1" top="288" width="436">
      Describe your character
    </text>
