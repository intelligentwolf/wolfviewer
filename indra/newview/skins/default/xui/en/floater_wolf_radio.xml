<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- [WolfViewer 2026-10-05] About Land > Sound > Radio Stations... and Wolf World > Music & Radio > Radio
     Stations... (wolffloaterradio.cpp, lists from wolfstorm.app/php/radio_stations.php via wolfradiostations.cpp).
     Paul: "a floater that looks like a radio with a genre choice this you click on to bring up a set of stations".
     [2026-10-17] Paul: "can you make it look more like an old radio as well". The radio itself - walnut cabinet,
     cloth grille and fretwork, magic eye, glowing LW/MW/SW dial with its red needle, knobs, station log card,
     maker's plate - is drawn in code behind these controls (WolfFloaterRadio::drawRadio()), and
     WolfFloaterRadio::layoutRadio() places every control below on every resize, so the positions here are only
     a starting point. The buttons draw no skin image (image_color 0 alpha): the radio paints them as ivory keys
     and bakelite push-buttons underneath; their labels, keyboard focus border and tooltips are the buttons' own. -->
<floater
 can_close="true"
 can_minimize="true"
 can_resize="true"
 height="640"
 layout="topleft"
 min_height="540"
 min_width="540"
 name="wolf_radio"
 help_topic="wolf_radio"
 save_rect="true"
 single_instance="true"
 title="Radio Stations"
 width="640">
    <!-- lettering on the radio (drawn, not widgets) -->
    <floater.string name="idle_name">WOLF RADIO</floater.string>
    <floater.string name="idle_detail">Pick a genre, then a station.</floater.string>
    <floater.string name="on_air">ON AIR</floater.string>
    <floater.string name="off_air">OFF AIR</floater.string>
    <floater.string name="log_title">Station log</floater.string>
    <floater.string name="volume_label">Volume</floater.string>
    <floater.string name="tuning_label">Tuning</floater.string>
    <!-- the three bands down the side of the dial, comma separated -->
    <floater.string name="bands">LW,MW,SW</floater.string>
    <!-- the figures along the top of the dial, comma separated (decoration, like an old medium-wave scale) -->
    <floater.string name="scale_numbers">550,600,700,800,1000,1200,1500</floater.string>
    <floater.string name="scale_unit">kHz</floater.string>
    <!-- tooltips for the drawn parts -->
    <floater.string name="genre_tip">Show the [GENRE] stations</floater.string>
    <!-- [WOLF STATIONS 2026-10-25] the genre keys are made in code, one per key the station list has
         (WolfFloaterRadio::refreshGenres(), makeKey()): Wolf, Residents, then every genre (14 from 2026-10-25, more may
         come); they wrap onto more rows as needed (layoutKeys()). Residents is the residents' own stations, added at
         wolf-grid.com/wolf-stations (radio_stations.php "wolf"); it is left out for a station list from before then. -->
    <floater.string name="featured_key">Wolf</floater.string>
    <floater.string name="featured_tip">The Wolf Territories stations: WTGR first, then stations run by our residents</floater.string>
    <floater.string name="residents_key">Residents</floater.string>
    <floater.string name="residents_tip">Every station run by a Wolf Territories resident that is on air now</floater.string>
    <floater.string name="residents_empty">No resident stations are on air just now. Run an internet radio station? Press "Add your station..." above to put it on this radio.</floater.string>
    <floater.string name="add_station_status">Opening wolf-grid.com/wolf-stations in your web browser. Sign in there with your Wolf Territories name; your station is listed once it passes the checks, and shows on this radio within the hour, from your next login.</floater.string>
    <floater.string name="eye_tip_on">Tuning eye: on air. You are listening to the station on the dial (only you hear it).</floater.string>
    <floater.string name="eye_tip_off">Tuning eye: off air. Press Listen, or double-click a station, to hear it.</floater.string>
    <floater.string name="volume_tip">Volume: [PERCENT]%. Click the right side or roll the wheel up to turn it up, the left side or wheel down to turn it down. This is the viewer's music volume.</floater.string>
    <floater.string name="volume_muted">Music is muted in the viewer's sound settings.</floater.string>
    <floater.string name="tuning_tip">Tuning: click the right side or roll the wheel up for the next station in the log, the left side or wheel down for the previous one.</floater.string>
    <scroll_list column_padding="0" draw_heading="true" follows="left|top" height="200" layout="topleft" left="30" multi_select="false"
     name="stations" top="320" width="580" background_visible="false" draw_stripes="true" bg_stripe_color="0.17 0.11 0.07 0.07"
     fg_unselected_color="0.17 0.11 0.07 1" fg_selected_color="0.17 0.11 0.07 1" bg_selected_color="0.85 0.62 0.30 1"
     highlighted_color="0.85 0.62 0.30 0.30" fg_disable_color="0.45 0.38 0.30 1"
     tool_tip="Double-click a station to listen to it">
        <scroll_list.columns label="Station" name="name" dynamicwidth="true" />
        <scroll_list.columns label="Country" name="country" width="140" />
        <scroll_list.columns label="kbps" name="kbps" width="50" />
    </scroll_list>
    <button follows="left|top" height="26" is_toggle="true" label="Listen" label_selected="Stop" layout="topleft" left="120" name="listen_btn" top="540" width="96"
     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false" use_ellipses="true"
     label_color="0.95 0.89 0.74 1" label_color_selected="0.95 0.89 0.74 1" label_color_disabled="0.62 0.54 0.42 1" label_color_disabled_selected="0.62 0.54 0.42 1"
     tool_tip="Listen to the station yourself (only you hear it). Press again to stop and get the land's music back." />
    <button follows="left|top" height="26" label="Set on land" layout="topleft" left_pad="8" name="set_land_btn" top_delta="0" width="120"
     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false" use_ellipses="true"
     label_color="0.95 0.89 0.74 1" label_color_selected="0.95 0.89 0.74 1" label_color_disabled="0.62 0.54 0.42 1" label_color_disabled_selected="0.62 0.54 0.42 1"
     tool_tip="Make this station the music on this land, for everyone here" />
    <button follows="left|top" height="26" label="Add to my presets" layout="topleft" left_pad="8" name="add_preset_btn" top_delta="0" width="150"
     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false" use_ellipses="true"
     label_color="0.95 0.89 0.74 1" label_color_selected="0.95 0.89 0.74 1" label_color_disabled="0.62 0.54 0.42 1" label_color_disabled_selected="0.62 0.54 0.42 1"
     tool_tip="Keep this station in My presets on the Sound tab" />
    <!-- [WOLF STATIONS 2026-10-25] at the right of the station log card's heading (layoutRadio() places it); Wolf
         Territories logins only, as the page needs one (wolffloaterradio.cpp postBuild) -->
    <button follows="left|top" height="20" label="Add your station..." layout="topleft" left="470" name="add_station_btn" top="290" width="140"
     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false" use_ellipses="true"
     label_color="0.95 0.89 0.74 1" label_color_selected="0.95 0.89 0.74 1" label_color_disabled="0.62 0.54 0.42 1" label_color_disabled_selected="0.62 0.54 0.42 1"
     tool_tip="Run an internet radio station? Add it to this radio at wolf-grid.com/wolf-stations (opens your web browser; sign in with your Wolf Territories name). It is listed once it passes the checks, and shows here within the hour, from your next login." />
    <text follows="left|top" height="36" layout="topleft" left="120" name="status" text_color="0.95 0.88 0.72 1" top="574" width="400" wrap="true">
        Stations from Wolf Territories residents and Radio Browser (radio-browser.info). Only stations on air are listed.
    </text>
</floater>
