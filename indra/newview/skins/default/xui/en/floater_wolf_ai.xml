   <!-- page 2: Colour and lights -->
   <panel name="ai_text_page_lights" follows="left|top" layout="topleft" left="0" top="180" width="396" height="248" border="false" visible="false">
    <text follows="left|top" layout="topleft" left="24" top="7" width="96" height="16" font="SansSerifBold" text_color="0.97 0.93 0.9 1" name="ai_text_colour_lbl">Letter colour</text>
