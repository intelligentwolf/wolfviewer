      <text follows="left|top" height="16" layout="topleft" left="8" top="82" width="96" name="ozone_lbl">Air absorbs</text>
      <check_box follows="left|top" height="18" layout="topleft" left="104" top="80" width="74" name="ozone_nat" label="Natural" />
