<!-- [W111 VIDEO 2026-11-24] Video Recorder (wolffloaterrecorder.cpp, wolfrecorder.cpp). Ticket 1033; Paul: "yes definitly".
     [W111 RECORDER UI 2026-11-24] Paul: "make the video recorder floater look like a proper video recording tool".
     Who and why: a resident (often 35-65, some older or disabled) wants to film what they see - dancing at a club with
     the music, a build, a ride, often well over five minutes, talking over it - and find the video afterwards.
     Flow: open (Avatar menu, Wolf World > Tools, or the toolbar button) -> press the big round Record button -> the
     monitor shows the picture, the REC light and the running time; Pause/Resume if needed -> press Stop -> "Saved" with
     the file name, size and length -> Play or Open folder.
     Modelled on camcorders and OBS Studio: a dark monitor at the top (drawn by the window: preview, REC light, timecode),
     the transport buttons under it (one primary action, the biggest target), then the settings grouped Picture, Sound
     (each source with its level meter, also drawn by the window) and Saving. Errors stay until the next press.
     While the whole window is recorded, this window is kept out of the video (WolfRecorder::holdBackFromVideo), its
     tooltips are not shown and its lists are closed (Paul: "the recording window should never be recorded"). No help
     button: the help window it opens is a separate window that would land in the video.
     Paul: "make sure it scrolls". The monitor and the transport buttons stay at the top, always in view; everything below
     them (status, Picture, Sound, Saving) is in a scroll container, so the window fits short screens (640 px by default,
     for 768-px screens) and can be made smaller (380 px) or larger. The scroll bar shows only when needed; the mouse
     wheel scrolls it; a control reached with the keyboard is scrolled into view (wolffloaterrecorder.cpp). -->
<floater
 can_close="true"
 can_minimize="true"
 can_resize="true"
 height="640"
 layout="topleft"
 min_height="380"
 min_width="500"
 name="wolf_recorder"
 save_rect="true"
 single_instance="true"
 title="Video Recorder"
 width="500">
    <view follows="left|top|right" height="140" layout="topleft" left="10" mouse_opaque="false" name="monitor" top="26" width="480" />
    <wolf_recorder_transport_button follows="left|top" font="SansSerifHuge" height="58" label="Record" layout="topleft" left="12" name="record_btn" tab_stop="true" top="174" width="200" tool_tip="Start recording what you see and hear. Press again to stop and save." />
    <wolf_recorder_transport_button follows="left|top" font="SansSerifHuge" height="58" label="Pause" layout="topleft" left="224" name="pause_btn" tab_stop="true" top="174" width="190" tool_tip="Pause the recording. Nothing is recorded until you press Resume." />

    <scroll_container border_visible="false" follows="all" height="398" layout="topleft" left="0" name="settings_scroll" opaque="false" reserve_scroll_corner="false" top="238" width="500">
    <panel background_visible="false" follows="left|top" height="504" layout="topleft" left="0" name="settings_panel" top="0" width="484">


        <text follows="left|top" font="SansSerif" height="46" layout="topleft" left="14" name="status" top="2" width="280" wrap="true">Press Record to start.</text>
        <button follows="left|top" font="SansSerif" height="28" label="Play" layout="topleft" left="300" name="play_btn" top="4" width="80" tool_tip="Play the video you have just saved, in this computer's video player" visible="false" />
        <button follows="left|top" font="SansSerif" height="28" label="Open folder" layout="topleft" left="386" name="saved_folder_btn" top="4" width="92" tool_tip="Show the folder your videos are saved in" visible="false" />
        <button follows="left|top" font="SansSerif" height="28" label="Get the video codec (free, from Cisco)" layout="topleft" left="290" name="codec_btn" top="4" width="188" tool_tip="Downloads Cisco's free H.264 video codec to this computer. Only needed when the computer's own video encoder cannot be used." visible="false" />
        <text follows="left|top" font="SansSerifSmall" height="30" layout="topleft" left="290" name="codec_note" top="34" width="188" visible="false" wrap="true">OpenH264 Video Codec provided by Cisco Systems, Inc.</text>
        <text follows="left|top" font="SansSerif" height="34" layout="topleft" left="14" name="message" top="52" width="464" wrap="true" />

        <text follows="left|top" font="SansSerifLargeBold" height="20" layout="topleft" left="14" name="picture_heading" top="94" width="200">Picture</text>
        <text follows="left|top" font="SansSerif" height="22" layout="topleft" left="24" name="size_label" top="120" width="140">Size</text>
        <combo_box follows="left|top" height="24" layout="topleft" left="170" name="size_combo" top="118" width="308" tool_tip="The size of the video picture. Your window is fitted inside, with black bars when its shape differs.">
            <combo_box.item label="Standard - 1280 x 720 (720p)" name="size_720" value="720" />
            <combo_box.item label="High - 1920 x 1080 (1080p)" name="size_1080" value="1080" />
        </combo_box>
        <text follows="left|top" font="SansSerif" height="22" layout="topleft" left="24" name="fps_label" top="148" width="140">Smoothness</text>
        <combo_box follows="left|top" height="24" layout="topleft" left="170" name="fps_combo" top="146" width="308" tool_tip="How many pictures a second the video aims for. When WolfViewer draws fewer, the video has fewer.">
            <combo_box.item label="30 pictures a second" name="fps_30" value="30" />
            <combo_box.item label="60 pictures a second (busier computer)" name="fps_60" value="60" />
        </combo_box>
        <check_box control_name="WolfRecorderShowInterface" follows="left|top" height="22" label="Show my windows, menus and name tags in the video" layout="topleft" left="24" name="show_ui_check" top="176" width="454" tool_tip="Off: only the world is recorded. On: the whole window, as you see it. This window and the REC sign are never in the video." />

        <text follows="left|top" font="SansSerifLargeBold" height="20" layout="topleft" left="14" name="sound_heading" top="206" width="120">Sound</text>
        <text follows="left|top" font="SansSerifSmall" halign="right" height="16" layout="topleft" left="130" name="sound_hint" top="210" width="348">The bars show how loud each sound is while you record.</text>
        <check_box control_name="WolfRecorderSoundWorld" follows="left|top" height="22" label="World sound and music" layout="topleft" left="24" name="world_check" top="230" width="200" tool_tip="Sounds, music and media as you hear them" />
        <slider control_name="WolfRecorderLevelWorld" decimal_digits="1" follows="left|top" height="22" increment="0.1" initial_value="1" layout="topleft" left="228" max_val="2" min_val="0" name="world_level" show_text="false" top="230" width="130" tool_tip="How loud the world sound is in the video" />
        <view follows="left|top" height="22" layout="topleft" left="364" name="world_meter" top="230" width="114" tool_tip="How loud the world sound is in the video, while you record: green is good, amber is loud, red (with the word Loud) is too loud - move the slider down." />
        <text follows="left|top" font="SansSerif" height="28" layout="topleft" left="44" name="world_note" top="252" width="434" wrap="true" />
        <check_box control_name="WolfRecorderSoundVoice" follows="left|top" height="22" label="Voice chat (other people)" layout="topleft" left="24" name="voice_check" top="282" width="200" tool_tip="Other people's voices as you hear them in voice chat" />
        <slider control_name="WolfRecorderLevelVoice" decimal_digits="1" follows="left|top" height="22" increment="0.1" initial_value="1" layout="topleft" left="228" max_val="2" min_val="0" name="voice_level" show_text="false" top="282" width="130" tool_tip="How loud voice chat is in the video" />
        <view follows="left|top" height="22" layout="topleft" left="364" name="voice_meter" top="282" width="114" tool_tip="How loud voice chat is in the video, while you record: green is good, amber is loud, red (with the word Loud) is too loud - move the slider down." />
        <text follows="left|top" font="SansSerif" height="18" layout="topleft" left="44" name="voice_note" top="304" width="434" wrap="true">Other people's voices will be recorded - please ask before sharing.</text>
        <check_box control_name="WolfRecorderSoundMic" follows="left|top" height="22" label="My microphone" layout="topleft" left="24" name="mic_check" top="324" width="200" tool_tip="Your own voice, for talking over the video. Not sent to voice chat." />
        <slider control_name="WolfRecorderLevelMic" decimal_digits="1" follows="left|top" height="22" increment="0.1" initial_value="1" layout="topleft" left="228" max_val="2" min_val="0" name="mic_level" show_text="false" top="324" width="130" tool_tip="How loud your microphone is in the video" />
        <view follows="left|top" height="22" layout="topleft" left="364" name="mic_meter" top="324" width="114" tool_tip="How loud your microphone is in the video, while you record: green is good, amber is loud, red (with the word Loud) is too loud - move the slider down." />
        <text follows="left|top" font="SansSerif" height="30" layout="topleft" left="44" name="mic_note" top="346" width="434" wrap="true">The microphone is only switched on while a recording runs, and off while it is paused. With speakers, it also picks up the world sound.</text>

        <text follows="left|top" font="SansSerifLargeBold" height="20" layout="topleft" left="14" name="saving_heading" top="384" width="200">Saving</text>
        <text follows="left|top" font="SansSerif" height="32" layout="topleft" left="24" name="folder_text" top="410" width="240" wrap="true">...</text>
        <button follows="left|top" font="SansSerif" height="28" label="Change..." layout="topleft" left="270" name="change_folder_btn" top="408" width="100" tool_tip="Choose the folder your videos are saved in" />
        <button follows="left|top" font="SansSerif" height="28" label="Open folder" layout="topleft" left="376" name="open_folder_btn" top="408" width="102" tool_tip="Show the folder your videos are saved in" />
        <text follows="left|top" font="SansSerif" height="22" layout="topleft" left="24" name="limit_label" top="450" width="140">Stop by itself</text>
        <combo_box follows="left|top" height="24" layout="topleft" left="170" name="limit_combo" top="448" width="308" tool_tip="Whether a recording stops by itself after a set time. With Never it runs until you press Stop; it still stops by itself, and says so, if the disk gets nearly full.">
            <combo_box.item label="Never - I will press Stop" name="limit_never" value="0" />
            <combo_box.item label="After 1 minute" name="limit_1" value="1" />
            <combo_box.item label="After 2 minutes" name="limit_2" value="2" />
            <combo_box.item label="After 5 minutes" name="limit_5" value="5" />
            <combo_box.item label="After 10 minutes" name="limit_10" value="10" />
            <combo_box.item label="After 15 minutes" name="limit_15" value="15" />
            <combo_box.item label="After 30 minutes" name="limit_30" value="30" />
            <combo_box.item label="After 60 minutes" name="limit_60" value="60" />
        </combo_box>
        <text follows="left|top" font="SansSerif" height="20" layout="topleft" left="24" name="space_note" top="478" width="454" wrap="true" />
    </panel>
    </scroll_container>

    <string name="record_label">Record</string>
    <string name="stop_label">Stop</string>
    <string name="saving_label">Saving...</string>
    <string name="pause_label">Pause</string>
    <string name="resume_label">Resume</string>
    <string name="record_tip">Start recording what you see and hear. Press again to stop and save.</string>
    <string name="stop_tip">Stop recording and save the video.</string>
    <string name="pause_tip">Pause the recording. Nothing is recorded until you press Resume.</string>
    <string name="resume_tip">Carry on recording, in the same video.</string>
    <string name="ready">Press Record to start. Press Stop when you have finished, and the video is saved.</string>
    <string name="starting">Starting...</string>
    <string name="recording">Recording. Press Stop to finish and save the video.</string>
    <string name="paused">Paused - nothing is being recorded. Press Resume to carry on, or Stop to save.</string>
    <string name="near_end">Recording - it stops by itself at [END].</string>
    <string name="finishing">Saving the video...</string>
    <string name="saved_as">Saved: [FILE]&#10;[SIZE], [LENGTH] long.</string>
    <string name="play_missing">The saved video is no longer in its folder.</string>
    <string name="detail_idle">[SIZE] - [FPS] pictures a second</string>
    <string name="detail_recording">[FPS] pictures a second[DROPPED]</string>
    <string name="dropped">, [N] skipped</string>
    <string name="detail_paused">Nothing is recorded while paused</string>
    <string name="monitor_stops_at">Stops by itself at [END]</string>
    <string name="state_ready">READY</string>
    <string name="state_starting">STARTING</string>
    <string name="state_rec">REC</string>
    <string name="state_paused">PAUSED</string>
    <string name="state_saving">SAVING</string>
    <string name="state_saved">SAVED</string>
    <string name="chip_mic">Microphone on</string>
    <string name="chip_voice">Voice chat on</string>
    <string name="preview_empty_1">The picture shows here</string>
    <string name="preview_empty_2">while you record</string>
    <string name="meter_loud">Loud</string>
    <string name="world_restart">Takes effect after restarting WolfViewer.</string>
    <string name="world_unavailable">This computer's sound system could not start the route the world sound is recorded from.</string>
    <string name="world_fmod">World sound can only be recorded with the OpenAL sound engine.</string>
    <string name="space_free">[FREE] free - room for about [TIME] of video at this size.</string>
    <string name="space_recording">[FREE] free - about [TIME] left at the current rate.</string>
</floater>
