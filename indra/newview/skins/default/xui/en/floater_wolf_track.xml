<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- [TRACK TOOL 2026-11-14] Lay Railway Track (wolffloatertrack.cpp). Paul, 13 Nov: "a track laying tool so people can lay
     tracks with points just by drawing"; 14 Nov: "dont forget to add stations as well... allow them to draw where a station
     should be". Design: firestorm/region-terrain-work/track-tool-2026-11-14/DESIGN.md (sections 1, 5, 10).
     Persona: a resident aged 35-65 who owns some land and has never built a railway.
     Story: "I draw a line on my land, see the track along it, add a station and a branch, press Lay track, and run my train."
     Flow: the window opens drawing (camera from above, the Tunnel tool's pen) -> 1. draw the track (a line, a branch) and
     click on the ground; 2. then add a station, signal, turntable, tunnel or cutting on it; the plan shows in the world at once, with any problem as a red mark
     and in the window -> 3. Lay track. Your railways (closed) lists what is laid here: Show, Change, Remove.
     The hint says the next step; the line under the drawing says the length, curves and stations, or what is wrong; the
     status line under Lay track says what is happening. No codes, no countdowns; failures stay in the caution colour until
     the next action; questions are asked inside the window (Start over, Remove). -->
<floater
 can_close="true"
 can_minimize="true"
 can_resize="false"
 height="680"
 layout="topleft"
 name="wolf_track"
 help_topic="wolf_track"
 save_rect="true"
 single_instance="true"
 title="Lay Railway Track"
 width="500">
 <!-- [T961 2026-11-21] Shadow: "nothing is ever off screen" on small laptop screens. Every control is in track_content, which
      scrolls in track_scroll: WolfFloaterTrack::relayout sizes track_content (Your railways closed or open), makes the window
      that plus its header but never taller than the floaters' area, and the scroll bar shows when it is cut short (the window
      then widens by the bar so nothing is covered). Coordinates below are track_content's, the same numbers as before. -->
    <scroll_container follows="all" layout="topleft" left="0" top="0" width="500" height="680" name="track_scroll" opaque="false" border_visible="false" reserve_scroll_corner="false" mouse_opaque="false">
    <panel follows="left|top" layout="topleft" left="0" top="0" width="500" height="680" name="track_content" background_visible="false" mouse_opaque="false">
    <text follows="left|top" font="SansSerifBold" height="40" layout="topleft" left="16" name="track_hint" top="26" width="468" word_wrap="true" />
    <!-- [TRACK STEPS 2026-11-18] Paul (W106 beta): "there needs to be better instructions its not obvious that you have to lay
         the track first THEN do the tunnels and cuttings". The pens are in two numbered rows, the order the planner needs them
         in (a station, signal, turntable, tunnel or cutting goes on a line already drawn: wolffloatertrack.cpp clickAt onALine),
         and Lay track is step 3. The radio items keep their order: EMode in wolffloatertrack.h is the selected index. -->
    <text follows="left|top" font="SansSerifBold" height="20" layout="topleft" left="16" name="draw_heading" top="70" width="112"
     tool_tip="Draw the track first: tunnels, cuttings, stations and signals go on a line you have drawn.">1. Draw track:</text>
    <text follows="left|top" font="SansSerifBold" height="20" layout="topleft" left="16" name="add_heading" top="94" width="112"
     tool_tip="When your line is drawn, add these to it. A hill in the way? The window offers a tunnel or a cutting by itself.">2. Then add:</text>
    <radio_group follows="left|top" height="46" layout="topleft" left="130" name="track_mode" top="68" width="354"
     tool_tip="Each choice makes something different with your next clicks on the ground. The words at the top of the window say what to click.">
        <radio_item height="20" label="Line" layout="topleft" left="0" name="line" top="0" value="line" width="50"
         tool_tip="Click where the line starts, at each bend, and where it ends. Click the first point again to make a loop." />
        <radio_item height="20" label="Branch" layout="topleft" left="54" name="branch" top="0" value="branch" width="66"
         tool_tip="Click on a line where the branch leaves it, then its bends and its end. End it on a line to join that line." />
        <radio_item height="20" label="Station" layout="topleft" left="0" name="station" top="24" value="station" width="66"
         tool_tip="Click on a line where the platform starts, then where it ends." />
        <radio_item height="20" label="Signal" layout="topleft" left="68" name="signal" top="24" value="signal" width="58"
         tool_tip="Click on a line to put a signal there. Signals are also put in by themselves." />
        <radio_item height="20" label="Turntable" layout="topleft" left="128" name="turntable" top="24" value="turntable" width="84"
         tool_tip="Click on the end of a line to put a turntable there, with stall roads round it." />
        <!-- [TRACK TOOL TUNNELS 2026-11-15] DESIGN.md 3.4: a stretch of a line through the hill -->
        <radio_item height="20" label="Tunnel" layout="topleft" left="214" name="tunnel" top="24" value="tunnel" width="62"
         tool_tip="Click on a line before a hill where the tunnel starts, then beyond the hill where it ends. The ends are fitted to the hill." />
        <!-- [TRACK TOOL CUTTINGS 2026-11-17] DESIGN.md 3.6: a stretch of a line where the ground is dug down to the rails -->
        <radio_item height="20" label="Cutting" layout="topleft" left="278" name="cutting" top="24" value="cutting" width="72"
         tool_tip="Click on a line where the cutting starts, then where it ends. The ground there is dug down to the rails when the railway is laid, and put back if you remove it." />
    </radio_group>
    <button follows="left|top" height="26" label="Undo last point" layout="topleft" left="16" name="track_undo" top="118" width="128"
     tool_tip="Take the last point you clicked back (Backspace)" />
    <button follows="left|top" height="26" label="Finish this line" layout="topleft" left="150" name="track_finish" top="118" width="128"
     tool_tip="End the line you are drawing here; your next click starts a new line" />
    <button follows="left|top" height="26" label="Start over" layout="topleft" left="284" name="track_start_over" top="118" width="96"
     tool_tip="Clear the whole drawing (the window asks first)" />
    <button follows="left|top" height="26" label="Look down" layout="topleft" left="386" name="track_top_view" top="118" width="98"
     tool_tip="Turn the camera to look down on your drawing, so a click lands where you point" />
    <!-- the window's own question (Start over, Remove, Forget pieces): in the window, never a modal box -->
    <text follows="left|top" font="SansSerifBold" height="34" layout="topleft" left="16" name="track_ask_text" top="150" visible="false" width="320" word_wrap="true" />
    <button follows="left|top" height="26" label="Yes" layout="topleft" left="344" name="track_ask_yes" top="152" visible="false" width="64" />
    <button follows="left|top" height="26" label="No" layout="topleft" left="420" name="track_ask_no" top="152" visible="false" width="64" />
    <text follows="left|top" height="20" layout="topleft" left="16" name="station_label" top="192" width="60">Station:</text>
    <combo_box follows="left|top" height="22" layout="topleft" left="76" name="station_side" top="190" width="142"
     tool_tip="Which side of the line the platform is on, looking the way you drew the line. Island: the line splits round a platform in the middle.">
        <combo_box.item label="On the left" name="left" value="left" />
        <combo_box.item label="On the right" name="right" value="right" />
        <combo_box.item label="Both sides" name="both" value="both" />
        <combo_box.item label="Island (in the middle)" name="island" value="island" />
    </combo_box>
    <combo_box follows="left|top" height="22" layout="topleft" left="224" name="station_style" top="190" width="126"
     tool_tip="How the station looks">
        <combo_box.item label="Country halt" name="halt" value="halt" />
        <combo_box.item label="Town station" name="town" value="town" />
        <combo_box.item label="Modern" name="modern" value="modern" />
    </combo_box>
    <line_editor follows="left|top" height="22" label="Station name" layout="topleft" left="356" max_length_chars="24" name="station_name" top="190" width="128"
     tool_tip="The station's name, up to 24 letters, digits, spaces, apostrophes or hyphens - for example Badger Hill" />
    <!-- [TRACK TOOL 2026-11-14] the turntable's choices (DESIGN.md 10 REQ turntables, 4.7), in place of the station's while a
         turntable is being put down or is picked in the list -->
    <panel follows="left|top" height="72" layout="topleft" left="0" name="turntable_panel" top="186" visible="false" width="500">
        <text follows="left|top" height="20" layout="topleft" left="16" name="tt_size_label" top="4" width="86">Deck length:</text>
        <combo_box follows="left|top" height="22" layout="topleft" left="104" name="tt_size" top="2" width="84"
         tool_tip="How long the turning deck is. A train can be turned if it is at least a metre shorter than the deck.">
            <combo_box.item label="15 m" name="15" value="15" />
            <combo_box.item label="20 m" name="20" value="20" />
            <combo_box.item label="24 m" name="24" value="24" />
        </combo_box>
        <text follows="left|top" height="20" layout="topleft" left="208" name="tt_roads_label" top="4" width="84">Stall roads:</text>
        <spinner decimal_digits="0" follows="left|top" height="22" increment="1" label_width="0" layout="topleft" left="294" max_val="10"
         min_val="1" name="tt_roads" top="2" width="60" tool_tip="How many tracks fan out from the turntable for engines to stand on (1 to 10)" />
        <text follows="left|top" height="20" layout="topleft" left="16" name="tt_spread_label" top="30" width="150">Angle between roads:</text>
        <spinner decimal_digits="0" follows="left|top" height="22" increment="1" label_width="0" layout="topleft" left="168" max_val="30"
         min_val="15" name="tt_spread" top="28" width="60" tool_tip="How many degrees apart the stall roads are (15 to 30)" />
        <text follows="left|top" height="20" layout="topleft" left="232" name="tt_degrees" top="30" width="60">degrees</text>
        <check_box follows="left|top" height="20" label="Engine shed over the roads" layout="topleft" left="300" name="tt_shed" top="30" width="190"
         tool_tip="Build an engine shed over the stall roads" />
        <text follows="left|top" height="18" layout="topleft" left="16" name="tt_turns" top="54" width="468" />
    </panel>
    <!-- [TRACK TOOL TUNNELS 2026-11-15] Paul: "let the user choose though sometimes they might just want to go up a hill".
         Where the plan finds a hill in the way, its two choices with their grade and length, in place of the station's row
         (climbing is the default: Climb the hill only puts the question away) -->
    <panel follows="left|top" height="100" layout="topleft" left="0" name="tunnel_choice_panel" top="186" visible="false" width="500">
        <!-- a heading, then one row per choice: its button and its length and grade in a line or two (the plan's whole
             sentence is the row's tool tip). [CUTTINGS 2026-11-17] three rows (Tunnel through, Dig a cutting, Climb the hill):
             100 px, so the drawn list's heading starts at 288; a hill with no tunnel choice shows Dig a cutting and Climb the
             hill in the first two rows (wolffloatertrack.cpp updateControls) -->
        <text follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="16" name="tunnel_choice_text" top="0" width="468" />
        <button follows="left|top" height="24" label="Tunnel through" layout="topleft" left="16" name="tunnel_choice_tunnel" top="18" width="116"
         tool_tip="Take the line through the hill in a tunnel, with brick portals at each end" />
        <text follows="left|top" font="SansSerifSmall" height="26" layout="topleft" left="138" name="tunnel_choice_tunnel_text" top="18" width="346" word_wrap="true" />
        <button follows="left|top" height="24" label="Dig a cutting" layout="topleft" left="16" name="tunnel_choice_cutting" top="46" width="116"
         tool_tip="Dig the ground down along the line so the track runs through the hill in the open, with sloped grass sides (or stone walls where it is deep). Remove puts the ground back." />
        <text follows="left|top" font="SansSerifSmall" height="26" layout="topleft" left="138" name="tunnel_choice_cutting_text" top="46" width="346" word_wrap="true" />
        <button follows="left|top" height="24" label="Climb the hill" layout="topleft" left="16" name="tunnel_choice_climb" top="74" width="116"
         tool_tip="Keep the line going over the hill (as it is now)" />
        <text follows="left|top" font="SansSerifSmall" height="26" layout="topleft" left="138" name="tunnel_choice_climb_text" top="74" width="346" word_wrap="true" />
    </panel>
    <text follows="left|top" height="18" layout="topleft" left="16" name="drawn_heading" top="288" width="380">What you have drawn (pick one to change or take it out):</text>
    <scroll_list draw_heading="false" follows="left|top" height="80" layout="topleft" left="16" name="track_items" top="308" width="380">
        <scroll_list.columns name="what" relative_width="1" />
    </scroll_list>
    <button follows="left|top" height="26" label="Take out" layout="topleft" left="404" name="track_take_out" top="308" width="80"
     tool_tip="Take the line, branch, station, signal, turntable, tunnel or cutting picked in the list out of the drawing" />
    <text follows="left|top" height="34" layout="topleft" left="16" name="track_summary" top="394" width="468" word_wrap="true" />
    <text follows="left|top" height="52" layout="topleft" left="16" name="track_problems" top="428" width="468" word_wrap="true" />
    <text follows="left|top" font="SansSerifBold" height="20" layout="topleft" left="16" name="lay_heading" top="484" width="468">3. Lay it</text>
    <button follows="left|top" font="SansSerifLarge" height="34" label="Lay track" layout="topleft" left="16" name="track_lay" top="506" width="180"
     tool_tip="Make the track, stations and signals and put them on your land (free)" />
    <progress_bar color_bar="0.3 0.85 0.4 1" follows="left|top" height="10" layout="topleft" left="208" name="track_progress" top="518" visible="false" width="276" />
    <!-- Lay the next part shows only when Look again / Take away what was placed do not (wolffloatertrack.cpp updateControls),
         so they share the row -->
    <button follows="left|top" height="26" label="Lay the next part" layout="topleft" left="16" name="track_next_part" top="546" visible="false" width="180"
     tool_tip="Put the part of your railway that is in the region you are in now on the land" />
    <button follows="left|top" height="26" label="Look again" layout="topleft" left="16" name="track_look_again" top="546" visible="false" width="120"
     tool_tip="Look again for the pieces that have not appeared yet" />
    <button follows="left|top" height="26" label="Take away what was placed" layout="topleft" left="144" name="track_take_away" top="546" visible="false" width="220"
     tool_tip="Take away the pieces that did appear (the railway stays in your inventory, in Objects)" />
    <!-- [TRACK TOOL CUTTINGS 2026-11-17] DESIGN.md 3.6 "Window": after a dig or a fill that failed, Dig again / Put the ground
         back (its label). Never shown with Look again / Take away what was placed (wolffloatertrack.cpp updateControls) -->
    <button follows="left|top" height="26" label="Dig again" layout="topleft" left="204" name="track_ground_again" top="546" visible="false" width="180"
     tool_tip="Ask the region again to dig the cutting, or to put the ground back as it was" />
    <text follows="left|top" height="46" layout="topleft" left="16" name="track_status" top="576" width="468" word_wrap="true" />
    <check_box follows="left|top" height="18" label="Your railways in this region" layout="topleft" left="16" name="track_mine_check" top="628" width="300"
     tool_tip="Show the railways you have laid in this region, to show, change or remove them" />
    <panel follows="left|top" height="140" layout="topleft" left="0" name="track_mine_panel" top="650" visible="false" width="500">
        <scroll_list follows="left|top" height="96" layout="topleft" left="16" name="track_mine_list" top="0" width="468">
            <scroll_list.columns label="Railway" name="name" relative_width="0.5" />
            <scroll_list.columns label="State" name="state" relative_width="0.3" />
            <scroll_list.columns label="Laid" name="date" relative_width="0.2" />
        </scroll_list>
        <button follows="left|top" height="26" label="Show" layout="topleft" left="16" name="track_show" top="104" width="80"
         tool_tip="Draw this railway's plan in the world" />
        <button follows="left|top" height="26" label="Change" layout="topleft" left="102" name="track_change" top="104" width="90"
         tool_tip="Load this railway into the drawing. Lay track then lays the changed railway, and the old one is taken away once the new one is in place." />
        <button follows="left|top" height="26" label="Lay its part here" layout="topleft" left="198" name="track_lay_part" top="104" width="136"
         tool_tip="Put the part of this railway that is in the region you are in on the land" />
        <button follows="left|top" height="26" label="Remove" layout="topleft" left="404" name="track_remove" top="104" width="80"
         tool_tip="Take this railway's pieces away from the region you are in (the window asks first)" />
    </panel>
    </panel>
    </scroll_container>
</floater>
