<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- [2026-09-12] The AI wizard, matching WolfStorm's (wolfstorm js/ui/floaters/build_ai_tab.js):
     choose -> form -> (large: confirm the charge) -> a status-only screen while it runs.
     Four sibling step panels, one visible at a time (WolfPanelAI::setStep); every rect is static.
     The previous version put the body in a scroll_container declared right="0" bottom="0":
     under layout="topleft" a NON-negative right/bottom is measured from the parent's LEFT/BOTTOM
     edge (llview.cpp:2549-2560), so that viewport was built with zero width and zero height and
     the whole body was invisible. Offsets from the far edge must be negative (right="-8").

     [FORGE LOOK 2026-10-20] Paul: "our standard object ai generator just make them look as nice as the new avatar and
     clothing generator but not the same". "The Forge": words go in, an object comes out. A smithy at night is painted in
     code behind these controls (WolfAIForge in wolfai.cpp, the technique of the radio and WolfAvatars; the primitives in
     wolfpaint.h): warm charcoal with an ember glow from below and sparks rising, the "Create with AI" plate with an anvil
     and hammer (the top 96 px of the panel), four embers for the steps (Choose - Describe - Forge - Delivered, or Confirm -
     Build for a large build; 100-136), the Small model tile with its drawing, the iron plates the fields sit on, the ledger
     behind the credits row, a crucible ring while a small model is made (in ai_scroll's place, which a small model does not
     show) and a green tick when it is delivered, the error plate with its warning mark, and every button's face (image_color
     0 alpha: the forge paints them as a glowing ingot for the main action and dark iron for the rest; labels, focus and
     tooltips are the buttons' own). Text colours are fixed, not the skin's, because the text sits on the fixed painting
     (contrast of each pair in wolfai.cpp, all at least 4.5:1). Same ids, callbacks, steps and behaviour as before. -->
<floater can_close="true" can_minimize="true" can_resize="true" height="660" min_height="660" min_width="660" layout="topleft" name="wolf_ai" save_rect="true" single_instance="true" title="Create with AI" width="680">
 <panel border="false" follows="all" layout="topleft" name="wolf_ai_panel" class="wolf_panel_ai" left="0" top="20" width="680" height="640">
  <!-- lettering painted on the forge (not widgets): the title plate, and the four embers (comma separated) for the choice,
       for a small model and for a large build -->
  <string name="forge_title">Create with AI</string>
  <string name="forge_sub">Describe it in words  -  the forge makes it</string>
  <string name="steps_choose">Choose,Describe,Make it,Delivered</string>
  <string name="steps_small">Choose,Describe,Forge,Delivered</string>
  <string name="steps_large">Choose,Describe,Confirm,Build</string>

  <!-- Step 1: which generator. Nothing else on the screen, so neither choice can be missed. -->
  <panel name="ai_step_choose" follows="all" layout="topleft" left="0" top="140" width="680" height="432" border="false">
   <text follows="left|top" layout="topleft" left="16" top="6" width="648" height="22" font="SansSerifLarge" text_color="1 0.89 0.72 1" name="ai_choose_title">What would you like to make?</text>
   <!-- the Small model tile: the forge draws its face and its picture (a vase) on the left; the words are the button's -->
   <button follows="left|right|top" layout="topleft" left="16" top="40" width="648" height="116" name="ai_choose_small" label="1. Small model"
    halign="left" pad_left="124" pad_bottom="26" font="SansSerifLarge"
    image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
    label_color="0.97 0.93 0.9 1" label_color_selected="0.97 0.93 0.9 1" label_color_disabled="0.79 0.72 0.67 1" label_color_disabled_selected="0.79 0.72 0.67 1"
    tool_tip="A single textured object, made from your words and put in your Objects folder" />
   <text follows="left|right|top" layout="topleft" left="140" top="94" width="512" height="54" word_wrap="true" mouse_opaque="false" text_color="0.83 0.76 0.7 1" name="ai_choose_small_note">A single textured object — furniture, a statue, a prop. Describe it, it is built, and it arrives in your Objects folder.</text>
     <!-- [2026-09-12] "2. Large project" withdrawn for now (Paul: remove the second option from
       wolfstorm and wolfviewer): four large builds failed on compiler rules at the grid's cost.
       The step panels and code stay; the button is hidden until the compiler corrects instead
       of rejects. Mirrors WolfStorm build_ai_tab.js. -->
   <button visible="false" follows="left|right|top" layout="topleft" left="16" top="168" width="648" height="116" name="ai_choose_large" label="2. Large project"
    halign="left" pad_left="124" pad_bottom="26" font="SansSerifLarge"
    image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
    label_color="0.97 0.93 0.9 1" label_color_selected="0.97 0.93 0.9 1" label_color_disabled="0.79 0.72 0.67 1" label_color_disabled_selected="0.79 0.72 0.67 1" />
   <text visible="false" follows="left|right|top" layout="topleft" left="140" top="222" width="512" height="54" word_wrap="true" mouse_opaque="false" text_color="0.83 0.76 0.7 1" name="ai_choose_large_note">A building or a settlement, with structural interiors. Designed in stages; you can close this window and it is delivered to your Objects folder when it is ready.</text>
  </panel>

  <!-- Step 2: the form for the chosen generator. -->
  <panel name="ai_step_form" follows="all" layout="topleft" left="0" top="140" width="680" height="432" border="false" visible="false">
   <!-- the ledger row (the forge draws its plate) -->
   <button follows="left|top" layout="topleft" left="24" top="8" width="124" height="26" name="ai_back" label="← Start again"
    image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
    label_color="0.97 0.93 0.9 1" label_color_selected="0.97 0.93 0.9 1" label_color_disabled="0.79 0.72 0.67 1" label_color_disabled_selected="0.79 0.72 0.67 1" />
   <text follows="left|top" layout="topleft" left="160" top="13" width="190" height="16" font="SansSerifBold" text_color="1 0.7 0.42 1" name="ai_credits">Wolf Credits: unavailable</text>
   <button follows="left|top" layout="topleft" left="356" top="8" width="84" height="26" name="ai_update" label="Update"
    image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
    label_color="0.97 0.93 0.9 1" label_color_selected="0.97 0.93 0.9 1" label_color_disabled="0.79 0.72 0.67 1" label_color_disabled_selected="0.79 0.72 0.67 1" />
   <button follows="left|top" layout="topleft" left="448" top="8" width="110" height="26" name="ai_buy" label="Buy credits"
    image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
    label_color="0.97 0.93 0.9 1" label_color_selected="0.97 0.93 0.9 1" label_color_disabled="0.79 0.72 0.67 1" label_color_disabled_selected="0.79 0.72 0.67 1" />
   <!-- the iron plate (the forge draws it from 44 to 332) -->
   <text follows="left|right|top" layout="topleft" left="30" top="54" width="620" height="44" word_wrap="true" parse_urls="false" text_color="0.83 0.76 0.7 1" name="ai_note" />
   <text follows="left|top" layout="topleft" left="30" top="104" width="110" height="16" font="SansSerifBold" text_color="0.97 0.93 0.9 1" name="ai_mode_lbl">Project size</text>
   <combo_box follows="left|top" layout="topleft" left="142" top="101" width="280" height="22" name="ai_mode">
    <combo_box.item label="Building" value="structure" />
    <combo_box.item label="Settlement" value="settlement" />
    <combo_box.item label="Small model" value="mesh" />
   </combo_box>
   <text follows="left|top" layout="topleft" left="30" top="130" width="300" height="16" font="SansSerifBold" text_color="0.97 0.93 0.9 1" name="ai_prompt_lbl">Describe what you want</text>
   <text_editor follows="left|right|top" layout="topleft" left="30" top="148" width="620" height="112" word_wrap="true" parse_urls="false" max_length="4000" name="ai_prompt" />
   <text follows="left|top" layout="topleft" left="30" top="268" width="300" height="16" font="SansSerifBold" text_color="0.97 0.93 0.9 1" name="ai_name_lbl">Name in inventory</text>
   <line_editor follows="left|top" layout="topleft" left="30" top="286" width="360" height="24" max_length_chars="63" name="ai_name" />
   <!-- the main action: the glowing ingot, bottom right of the plate -->
   <button follows="right|top" layout="topleft" left="420" top="274" width="230" height="44" name="ai_build" label="Build"
    font="SansSerifBold" use_ellipses="true"
    image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
    label_color="0.165 0.055 0.008 1" label_color_selected="0.165 0.055 0.008 1" label_color_disabled="0.79 0.72 0.67 1" label_color_disabled_selected="0.79 0.72 0.67 1" />
   <text follows="left|top" layout="topleft" left="24" top="344" width="300" height="16" font="SansSerifBold" text_color="0.97 0.93 0.9 1" name="ai_saved_title">Saved buildings</text>
   <button follows="right|top" layout="topleft" left="562" top="340" width="94" height="24" name="ai_jobs_reload" label="Reload"
    image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
    label_color="0.97 0.93 0.9 1" label_color_selected="0.97 0.93 0.9 1" label_color_disabled="0.79 0.72 0.67 1" label_color_disabled_selected="0.79 0.72 0.67 1" />
   <scroll_list follows="left|right|top" layout="topleft" left="24" top="368" width="632" height="60" name="ai_jobs" multi_select="false" draw_heading="true">
    <scroll_list.columns name="name" label="Build" relative_width="0.6" />
    <scroll_list.columns name="state" label="State" relative_width="0.4" />
   </scroll_list>
  </panel>

  <!-- Step 3 (large only): the charge, stated plainly, before any money is spent. -->
  <panel name="ai_step_confirm" follows="all" layout="topleft" left="0" top="140" width="680" height="432" border="false" visible="false">
   <text follows="left|top" layout="topleft" left="16" top="6" width="648" height="22" font="SansSerifLarge" text_color="1 0.89 0.72 1" name="ai_confirm_title">Before your building is started</text>
   <text follows="left|right|top" layout="topleft" left="30" top="46" width="620" height="180" word_wrap="true" parse_urls="false" text_color="0.97 0.93 0.9 1" name="ai_confirm_text" />
   <button follows="left|right|top" layout="topleft" left="16" top="246" width="648" height="44" name="ai_confirm_start" label="Start the building"
    font="SansSerifBold" use_ellipses="true"
    image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
    label_color="0.165 0.055 0.008 1" label_color_selected="0.165 0.055 0.008 1" label_color_disabled="0.79 0.72 0.67 1" label_color_disabled_selected="0.79 0.72 0.67 1" />
   <text follows="left|right|top" layout="topleft" left="24" top="296" width="632" height="32" word_wrap="true" text_color="0.83 0.76 0.7 1" name="ai_confirm_note">I understand the charge and that it is taken automatically when it is ready.</text>
   <button follows="left|top" layout="topleft" left="16" top="340" width="320" height="28" name="ai_confirm_back" label="Go back and change the description"
    image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
    label_color="0.97 0.93 0.9 1" label_color_selected="0.97 0.93 0.9 1" label_color_disabled="0.79 0.72 0.67 1" label_color_disabled_selected="0.79 0.72 0.67 1" />
  </panel>

  <!-- Step 4: the status, on its own. The job lives on the grid (or on WolfAI for a small
       model), so closing the window is safe and reopening comes back here. -->
  <panel name="ai_step_working" follows="all" layout="topleft" left="0" top="140" width="680" height="432" border="false" visible="false">
   <text follows="left|right|top" layout="topleft" left="16" top="6" width="648" height="22" font="SansSerifLarge" text_color="1 0.89 0.72 1" name="ai_working_title" />
   <!-- a large build's progress and preview; a small model shows the crucible ring in this place instead -->
   <scroll_container follows="left|right|top|bottom" layout="topleft" left="16" top="36" width="648" height="246" name="ai_scroll" opaque="false">
    <panel name="ai_scroll_content" layout="topleft" left="0" top="0" width="626" height="700" border="false">
     <text follows="left|top" layout="topleft" left="4" top="4" width="610" height="16" word_wrap="true" parse_urls="false" text_color="0.97 0.93 0.9 1" name="ai_job_name" />
     <text follows="left|top" layout="topleft" left="4" top="24" width="610" height="32" word_wrap="true" parse_urls="false" text_color="0.97 0.93 0.9 1" name="ai_job_status" />
     <text follows="left|top" layout="topleft" left="4" top="60" width="610" height="16" word_wrap="true" parse_urls="false" text_color="1 0.7 0.42 1" name="ai_job_cost" />
     <panel follows="left|top" layout="topleft" left="4" top="80" width="610" height="210" name="ai_preview" border="false" />
     <panel follows="left|top" layout="topleft" left="4" top="294" width="610" height="22" name="ai_view_controls" border="false">
      <button follows="left|top" layout="topleft" left="0" top="0" width="56" height="22" name="ai_view_prev" label="Prev" />
      <button follows="left|top" layout="topleft" left="64" top="0" width="56" height="22" name="ai_view_next" label="Next" />
      <text follows="left|top" layout="topleft" left="128" top="3" width="300" height="18" text_color="0.83 0.76 0.7 1" name="ai_view_label" />
     </panel>
     <text_editor follows="left|top" layout="topleft" left="4" top="320" width="610" height="130" word_wrap="true" parse_urls="false" read_only="true" allow_scroll="true" name="ai_job_result" />
     <text follows="left|top" layout="topleft" left="4" top="454" width="610" height="16" word_wrap="true" parse_urls="false" text_color="0.83 0.76 0.7 1" name="ai_grounding_note" />
     <!-- Safe LLMediaCtrl subclass is created here with trusted_content=false in postBuild. -->
     <panel follows="left|top" layout="topleft" left="4" top="474" width="610" height="110" name="ai_grounding" visible="false" border="false" />
     <text_editor follows="left|top" layout="topleft" left="4" top="588" width="610" height="106" word_wrap="true" parse_urls="false" read_only="true" allow_scroll="true" name="ai_sources" />
    </panel>
   </scroll_container>
   <!-- the stage words on their own plate (the forge draws it) -->
   <text follows="left|right|bottom" layout="topleft" left="28" top="294" width="624" height="34" word_wrap="true" parse_urls="false" halign="center" font="SansSerifBold" text_color="0.97 0.93 0.9 1" name="ai_status" />
   <text follows="left|right|bottom" layout="topleft" left="16" top="340" width="648" height="36" word_wrap="true" text_color="0.83 0.76 0.7 1" name="ai_working_note" />
   <button follows="left|bottom" layout="topleft" left="16" top="390" width="160" height="30" name="ai_collect" label="Collect" visible="false"
    image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
    label_color="0.165 0.055 0.008 1" label_color_selected="0.165 0.055 0.008 1" label_color_disabled="0.79 0.72 0.67 1" label_color_disabled_selected="0.79 0.72 0.67 1" />
   <button follows="left|bottom" layout="topleft" left="184" top="390" width="260" height="30" name="ai_resume" label="Resume" visible="false"
    image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
    label_color="0.97 0.93 0.9 1" label_color_selected="0.97 0.93 0.9 1" label_color_disabled="0.79 0.72 0.67 1" label_color_disabled_selected="0.79 0.72 0.67 1" />
   <button follows="right|bottom" layout="topleft" left="496" top="390" width="168" height="30" name="ai_working_done" label="Start another"
    image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
    label_color="0.97 0.93 0.9 1" label_color_selected="0.97 0.93 0.9 1" label_color_disabled="0.79 0.72 0.67 1" label_color_disabled_selected="0.79 0.72 0.67 1" />
  </panel>

  <!-- Shared: every step reports failures here, on the forge's red plate with its warning mark (shown only while there is
       one; read-only, so the words can be selected and copied, and they stay until the next action). -->
  <text_editor follows="left|right|bottom" layout="topleft" left="46" top="580" width="620" height="52" name="ai_error" word_wrap="true" parse_urls="false" read_only="true" allow_scroll="true" bg_readonly_color="0.239 0.078 0.094 1" text_readonly_color="1 0.79 0.76 1" />
 </panel>
</floater>
