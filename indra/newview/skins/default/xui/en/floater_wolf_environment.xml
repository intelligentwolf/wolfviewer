        <radio_item follows="left|top" height="20" layout="topleft" left="0" top="0" width="490" name="mode_wolf"
                    label="Wolf Environment: Wolf draws the whole sky" />
        <radio_item follows="left|top" height="20" layout="topleft" left="0" top="21" width="490" name="mode_ontop"
                    label="On top: keep my own sky, Wolf adds weather, cloud, haze and light" />
        <radio_item follows="left|top" height="20" layout="topleft" left="0" top="42" width="490" name="mode_off"
                    label="Off: my own sky only (the settings are kept for later)" />
      </radio_group>

      <text follows="left|top" height="16" layout="topleft" left="8" top="98" width="80" name="preset_lbl">Look</text>
      <combo_box follows="left|top" height="22" layout="topleft" left="92" top="95" width="200" name="preset"
                 tool_tip="A ready-made sky. Earth is the real sky; the others are fantasy worlds. Fine-tune them on the Sky and Suns &amp; moons tabs." />
      <text follows="left|top" height="30" layout="topleft" left="300" top="94" width="200" name="preset_note" word_wrap="true" text_color="LabelDisabledColor">Fine-tune on the Sky and Suns &amp; moons tabs.</text>

      <text follows="left|top" height="16" layout="topleft" left="8" top="126" width="490" name="place_hdr" text_color="EmphasisColor">Place</text>
      <combo_box follows="left|top" height="22" layout="topleft" left="92" top="124" width="200" name="place_kind" />
      <line_editor follows="left|top" height="22" layout="topleft" left="8" top="150" width="400" name="place_search"
                   max_length_bytes="120" label="Search for a town or city..." commit_on_focus_lost="false" />
      <button follows="left|top" height="22" layout="topleft" left="414" top="150" width="90" name="place_search_btn" label="Search" />
      <scroll_list follows="left|top" height="44" layout="topleft" left="8" top="176" width="496" name="place_results"
