     text_color="0.12 0.07 0.03 1" top="248" width="340" word_wrap="true" />
    <text type="string" length="1" follows="left|top" height="80" layout="topleft" left="420" name="price_how"
     text_color="0.78 0.78 0.86 1" top="340" width="340" word_wrap="true">
      Nothing is charged until you press Start. The 4 pictures are charged once they are drawn; the build is charged when your avatar is made. If a step fails, you are not charged for it.
    </text>
    <button follows="left|top" height="34" label="Back" layout="topleft" left="20" name="back_btn" top="693" width="120"
     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false" use_ellipses="true"
     label_color="0.95 0.92 0.84 1" label_color_selected="0.95 0.92 0.84 1" label_color_disabled="0.72 0.72 0.80 1" label_color_disabled_selected="0.72 0.72 0.80 1"
