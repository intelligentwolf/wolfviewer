               label_width="84" decimal_digits="4" increment="0.0001" min_val="-180" max_val="180" />

      <text follows="left|top" height="16" layout="topleft" left="8" top="282" width="80" name="time_hdr" text_color="EmphasisColor">Time</text>
      <combo_box follows="left|top" height="22" layout="topleft" left="92" top="279" width="200" name="time_mode" />
      <combo_box follows="left|top" height="22" layout="topleft" left="300" top="279" width="204" name="time_zone" max_chars="64" />
      <line_editor follows="left|top" height="22" layout="topleft" left="300" top="305" width="204" name="time_zone_search"
                   max_length_bytes="40" label="Search zones..." commit_on_focus_lost="false" />
      <slider follows="left|top" height="20" layout="topleft" left="92" top="306" width="200" name="time_hour" label=""
              min_val="0" max_val="23.75" increment="0.25" initial_value="12" decimal_digits="2" show_text="false" can_edit_text="false"
              tool_tip="The sky always shows this time of day." />
      <text follows="left|top" height="16" layout="topleft" left="300" top="308" width="200" name="time_hour_text" />
      <spinner follows="left|top" height="22" layout="topleft" left="92" top="305" width="200" name="time_day_hours"
               label="Day lasts (h)" label_width="96" decimal_digits="1" increment="0.5" min_val="4" max_val="168"
               tool_tip="A whole day and night every this many hours (4 to 168, the range EEP itself uses)." />

      <text follows="left|top" height="16" layout="topleft" left="8" top="338" width="80" name="weather_hdr" text_color="EmphasisColor">Weather</text>
