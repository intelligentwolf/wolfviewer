#ifndef WOLF_TK_CORETRANSFORM_GLSL
#define WOLF_TK_CORETRANSFORM_GLSL

// Source: three-geospatial packages/core/src/shaders/transform.glsl:1 screenToView
vec3 screenToView(
  const vec2 uv,
  const float depth,
  const float viewZ,
  const mat4 projectionMatrix,
  const mat4 inverseProjectionMatrix
) {
  vec4 clip = vec4(vec3(uv, depth) * 2.0 - 1.0, 1.0);
  float clipW = projectionMatrix[2][3] * viewZ + projectionMatrix[3][3];
  clip *= clipW;
  return (inverseProjectionMatrix * clip).xyz;
}
#endif // WOLF_TK_CORETRANSFORM_GLSL
