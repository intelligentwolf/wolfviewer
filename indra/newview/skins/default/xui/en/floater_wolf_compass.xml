<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- [WOLF COMPASS 2026-10-16] Wolf World > Compass (wolffloatercompass.cpp). A Victorian mariner's
     compass, drawn in code: the card and its red needle point North, the black lubber mark at the
     top is where you are looking, the blue pointer on the rim is the way you are moving. Resizable; the dial
     and the lettering scale with the window. Every grid. -->
<floater
 can_close="true"
 can_minimize="true"
 can_resize="true"
 height="345"
 layout="topleft"
 min_height="230"
 min_width="170"
 name="wolf_compass"
 help_topic="wolf_compass"
 save_rect="true"
 save_visibility="true"
 single_instance="true"
 title="Tessa's Compass"
 width="260">
    <!-- the 16 points of the compass, clockwise from North, comma separated (the first, fifth,
         ninth and thirteenth are lettered large on the card) -->
    <floater.string name="point_names">N,NNE,NE,ENE,E,ESE,SE,SSE,S,SSW,SW,WSW,W,WNW,NW,NNW</floater.string>
    <floater.string name="heading_label">Heading</floater.string>
    <floater.string name="course_label">Course</floater.string>
    <floater.string name="at_rest">at rest</floater.string>
</floater>
