<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- Source: floater_about_land.xml land_waves_panel (2026-09-07), moved intact to Region / Estate. -->
<panel border="true" follows="all" height="520" width="480" label="Waves"
       layout="topleft" name="panel_region_waves">
  <panel.string name="str_note_all">You can set every cell of [REGION] and its wave settings ([W] x [H] cells of [CELL] m, [STATE]).</panel.string>
  <panel.string name="str_note_parcel">You can set the cells on land you own in [REGION]; other cells are locked ([W] x [H] cells of [CELL] m, [STATE]).</panel.string>
  <panel.string name="str_off_grid">This region is not on the Wolf Territories grid, so it uses the automatic wave layout.</panel.string>
  <panel.string name="str_newer_on_grid">The layout changed on the grid while you were painting — Save puts your painting on top of it.</panel.string>
  <panel.string name="str_fetching">Asking the grid for this region's wave layout…</panel.string>
  <panel.string name="str_stored">saved layout</panel.string>
  <panel.string name="str_automatic">automatic layout; nothing saved yet</panel.string>
  <panel.string name="str_locked_cell">That cell is on land you do not own — it stays as it is.</panel.string>
  <panel.string name="str_layout_off_parcel">This region's painted layout is switched off, and only the region holder can turn it on (Use this layout).</panel.string>
  <panel.string name="str_layout_on_for_paint">Use this layout switched on so your painting shows — Save to keep it.</panel.string>
  <panel.string name="str_saving">Saving…</panel.string>
  <panel.string name="str_saved">Saved — everyone in the region now sees this layout.</panel.string>
  <panel.string name="str_save_failed">Could not save:</panel.string>
  <panel.string name="str_default_loaded">Automatic layout on; your painting is cleared — Save to keep it (Revert undoes it).</panel.string>
  <text follows="left|top" height="30" left="10" top="8" width="460" word_wrap="true" name="waves_help">
Paint on the map or directly on the water. Surf, Open, Small, Calm and Off use the same saved layout.
  </text>
  <text follows="left|top" height="28" left="10" top_pad="2" width="460" word_wrap="true"
        name="waves_note" text_color="0.79 0.64 0.15 1" />
  <button follows="left|top" height="20" left="10" top_pad="4" width="60" name="waves_brush_s" label="Surf" is_toggle="true" />
  <button follows="left|top" height="20" left_pad="4" top_delta="0" width="60" name="waves_brush_o" label="Open" is_toggle="true" />
  <button follows="left|top" height="20" left_pad="4" top_delta="0" width="60" name="waves_brush_m" label="Small" is_toggle="true" />
  <button follows="left|top" height="20" left_pad="4" top_delta="0" width="60" name="waves_brush_c" label="Calm" is_toggle="true" />
  <button follows="left|top" height="20" left_pad="4" top_delta="0" width="60" name="waves_brush_x" label="Off" is_toggle="true" />
  <button follows="left|top" height="22" left="10" top_pad="6" width="130" name="waves_world_paint" label="Paint on water" is_toggle="true" />
  <slider follows="left|top" height="22" left_pad="8" top_delta="0" width="322" name="waves_brush_diameter" label="Diameter (16 m)" label_width="110" min_val="1" max_val="8" increment="1" initial_value="1" decimal_digits="0" show_text="true" tool_tip="Circular brush diameter in 16 m cells, the same size on every region: 1 is 16 m, 8 is 128 m. Every touched water cell is painted." />
  <wolf_wave_painter follows="left|top" height="224" width="224" left="10" top_pad="6" name="waves_painter" />
  <text follows="left|top" height="14" left="244" top_delta="0" width="226" name="waves_surf_height_lbl">Surf wave height (m)</text>
  <slider follows="left|top" height="16" left="244" top_pad="2" width="226" name="waves_surf_height" min_val="0.2" max_val="20" increment="0.1" initial_value="3" decimal_digits="1" show_text="true" />
  <text follows="left|top" height="14" left="244" top_pad="8" width="226" name="waves_set_interval_lbl">Surf set every (s)</text>
  <slider follows="left|top" height="16" left="244" top_pad="2" width="226" name="waves_set_interval" min_val="30" max_val="600" increment="10" initial_value="90" decimal_digits="0" show_text="true" />
  <text follows="left|top" height="14" left="244" top_pad="8" width="226" name="waves_calm_ripple_lbl">Calm ripple (cm)</text>
  <slider follows="left|top" height="16" left="244" top_pad="2" width="226" name="waves_calm_ripple" min_val="0" max_val="10" increment="0.5" initial_value="3" decimal_digits="1" show_text="true" />
  <text follows="left|top" height="14" left="244" top_pad="8" width="226" name="waves_small_scale_lbl">Small waves (% of open sea)</text>
  <slider follows="left|top" height="16" left="244" top_pad="2" width="226" name="waves_small_scale" min_val="5" max_val="80" increment="5" initial_value="30" decimal_digits="0" show_text="true" />
  <check_box follows="left|top" height="16" left="244" top_pad="10" width="226" name="waves_enabled" label="Use this layout (off = automatic)" initial_value="true" />
  <text follows="left|top" height="42" left="10" top="380" width="460" word_wrap="true" name="waves_status" />
  <button follows="left|top" height="22" left="10" top_pad="4" width="80" name="waves_save" label="Save" />
  <button follows="left|top" height="22" left_pad="6" top_delta="0" width="80" name="waves_revert" label="Revert" />
  <button follows="left|top" height="22" left_pad="6" top_delta="0" width="140" name="waves_default" label="Reset to automatic" />
</panel>
