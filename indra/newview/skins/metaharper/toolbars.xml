<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<toolbars>
    <right_toolbar
     button_alignment="center"
     button_display_mode="icons_only"
     button_layout_style="none" />
    <bottom_toolbar
     button_alignment="left"
     button_display_mode="icons_only"
     button_layout_style="fill">
     <!-- WolfViewer 2026-09-07: Chat and Speak stay; everything else lives in five GROUP
          buttons (wolftoolbargroups.cpp), each a popup of the commands for one purpose. -->
     <command name="chat"/>
     <command name="speak"/>
     <command name="group_voice"/>
     <command name="group_move"/>
     <command name="group_world"/>
     <command name="group_me"/>
     <command name="group_display"/>
   </bottom_toolbar>
    <left_toolbar
     button_alignment="center"
     button_display_mode="icons_only"
     button_layout_style="none" />
</toolbars>
