#ifndef WOLF_TK_COREINTERLEAVEDGRADIENTNOISE_GLSL
#define WOLF_TK_COREINTERLEAVEDGRADIENTNOISE_GLSL

// Reference: https://advances.realtimerendering.com/s2014/index.html#_NEXT_GENERATION_POST

// Source: three-geospatial packages/core/src/shaders/interleavedGradientNoise.glsl:3 interleavedGradientNoise
float interleavedGradientNoise(const vec2 coord) {
  const vec3 magic = vec3(0.06711056, 0.00583715, 52.9829189);
  return fract(magic.z * fract(dot(coord, magic.xy)));
}
#endif // WOLF_TK_COREINTERLEAVEDGRADIENTNOISE_GLSL
