         den (drawClothes) like the Person / Animal tiles; toggle buttons so the keyboard reaches them, one always chosen. -->
    <button follows="left|top" height="22" is_toggle="true" label="" layout="topleft" left="220" name="dressed_btn" top="400" width="200"
     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
     tool_tip="Dressed as described: the clothes in your words are part of the avatar" />
    <button follows="left|top" height="22" is_toggle="true" label="" layout="topleft" left="428" name="base_btn" top="400" width="228"
     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
     tool_tip="Base body: plain underwear only, barefoot, no accessories - add your own clothes in-world" />
    <!-- [FIGURE 2026-10-20] Woman / Man: for a base body ("Figure") and for clothing ("Made for"); two drawn chips -->
    <text type="string" length="1" follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="220" name="figure_label"
     text_color="0.95 0.92 0.84 1" top="400" width="80">
      Figure
