    <combo_box follows="left|top" layout="topleft" left="124" top="76" width="264" height="22" name="ai_text_font" tool_tip="The lettering (open-licence fonts), in groups" />
    <text follows="left|top" layout="topleft" left="24" top="107" width="96" height="16" font="SansSerifBold" text_color="0.97 0.93 0.9 1" name="ai_text_height_lbl">Letter height</text>
    <spinner text_disabled_color="0.79 0.72 0.67 1" text_enabled_color="0.97 0.93 0.9 1" follows="left|top" layout="topleft" left="124" top="104" width="64" height="22" label="" label_width="0"
     name="ai_text_height" min_val="0.1" max_val="30" increment="0.1" initial_value="1" decimal_digits="2" tool_tip="The height of a capital letter, in metres" />
