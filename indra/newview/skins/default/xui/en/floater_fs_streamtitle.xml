<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 name="stream_info"
 title="Now playing:"
 can_resize="true"
 height="46"
 width="400"
 layout="topleft"
 min_height="46"
 min_width="200"
 save_rect="true"
>
<floater.string name="NoStream">
	No stream playing
</floater.string>
	<text
		top="3"
		follows="left|top|right"
		height="16"
		width="320"
		layout="topleft"
		left="10"
		name="streamtitle"
		use_ellipses="true"
		wrap="false"
		/>
	<button
		top_delta="-2"
		follows="top|right"
		height="16"
		width="60"
		layout="topleft"
		name="btn_history"
		label="History"
		right="-5"
		/>
	<!-- WolfViewer: album cover, drawn by FSFloaterStreamTitle::draw() into this panel's
	     rect; shown only when WolfStreamAlbumArt is on and a cover was found -->
	<panel
		top="27"
		left="10"
		follows="left|top"
		height="96"
		width="96"
		layout="topleft"
		name="album_art"
		visible="false"
		background_visible="true"
		bg_alpha_color="0 0 0 0.4"
		bg_opaque_color="0 0 0 0.4"
		/>
</floater>
