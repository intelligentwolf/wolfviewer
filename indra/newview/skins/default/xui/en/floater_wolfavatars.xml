     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false" use_ellipses="true"
     label_color="0.16 0.08 0.02 1" label_color_selected="0.16 0.08 0.02 1" label_color_disabled="0.72 0.72 0.80 1" label_color_disabled_selected="0.72 0.72 0.80 1"
     tool_tip="Start: the 4 pictures are drawn first, then you pick one" />
