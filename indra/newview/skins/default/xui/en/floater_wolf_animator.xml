<!-- [WOLF ANIMATOR 2026-11-05] Wolf Animator (wolffloateranimator.cpp): Wolf World > Wolf Animator... and Build > Wolf Animator...
     Ticket 547 (Jimmy Olsen, approved by Paul). Who and why: a Wolf Territories resident, often older or less confident with
     computers, who wants their avatar to dance or wave and has never made an animation. Story: say what the avatar should do
     in your own words (or pick an example), see what it costs (the AI cost plus 10%, at least 1 credit, never more than the
     quote, charged only once it is in your inventory), press Make my animation; a minute later it is in Animations, with a
     moving figure of it here; then How was it? Great / OK / Please try again (free, once) / Something is wrong (a Flea Report).
     Flow, top to bottom: 1. the description and examples 2. the cost, your credits and Make my animation 3. the result
     (figure left, words right) 4. How was it? and its box. The status line above the bottom buttons keeps progress or a
     failure (caution colour) until the next action. Large text (SansSerifLarge) for reading ease; 560 x 716 fits a 1360 x 768 (as the Building Generator's 720 x 706)
     screen. Endpoint contract: region-terrain-work/wolf-animator-2026-11-05/README.md "Window contract". -->
<floater
 can_close="true"
 can_minimize="true"
 can_resize="false"
 height="716"
 layout="topleft"
 min_height="300"
 name="wolf_animator"
 help_topic="wolf_animator"
 save_rect="true"
 single_instance="true"
 title="Wolf Animator"
 width="560">
    <string name="feature_name">Wolf Animator</string>
    <string name="opening">Opening the Wolf Animator...</string>
    <string name="closed">The Wolf Animator is closed</string>
    <string name="reopen">Close this window and open it again to try again.</string>
    <string name="start_hint">Say what your avatar should do, then press Make my animation. You see the price first.</string>
    <string name="no_result_yet">Your animation will move here</string>
    <string name="no_result_text">Once it is made, what it does and where it is in your inventory show here.</string>
    <string name="preview_bad">The moving picture could not be drawn</string>
    <string name="counter">[N] / [MAX] characters</string>
    <string name="examples_prompt">Or start from an example...</string>
    <string name="credit_one">[N] credit</string>
    <string name="credit_many">[N] credits</string>
    <string name="quote_waiting">Reading what it costs...</string>
    <string name="quote_missing">The Wolf Animator did not say what it costs - close the window and open it again.</string>
    <string name="quote_line">Making it costs about [N], at most [M].</string>
    <string name="balance_unknown">Reading your AI credits...</string>
    <string name="balance_short">You have [N] AI credits to spend (balance [B]) - not enough to make one.</string>
    <string name="balance_ok">You have [N] AI credits to spend (balance [B]).</string>
    <string name="not_confirmed">Wait a moment - this region is still being confirmed as Wolf Territories.</string>
    <string name="request_needed">Not made: please describe the animation first.</string>
    <string name="making_send">Sending your description...</string>
    <string name="make_waiting">Your animation is waiting ([AHEAD] ahead of it). Nothing is charged until it is in your inventory.</string>
    <string name="make_next">Your animation is next. Nothing is charged until it is in your inventory.</string>
