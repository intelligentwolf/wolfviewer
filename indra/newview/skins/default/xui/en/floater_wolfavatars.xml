    <button follows="left|top" height="22" is_toggle="true" label="" layout="topleft" left="408" name="man_btn" top="400" width="100"
     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
     tool_tip="Man: fitted to the standard male body" />
    <!-- [MADE FOR 2026-10-20] Paul: "This clothing is for <dropdown avatars>" - clothing made for one of your avatars is
         fitted to that avatar's own body; laid out on the figure row (layoutWidgets) -->
    <combo_box follows="left|top" layout="topleft" left="300" top="400" width="356" height="22" name="for_combo"
     tool_tip="Made for one of your avatars, the clothing is fitted to that avatar's own body (a wolf's cloak clears the tail and the fur). A standard body: the WolfAvatars base body's shape, a woman's or a man's." />
    <!-- [CLOTHING 2026-10-20] the garment: eight drawn chips, two rows of four, one always chosen -->
    <text type="string" length="1" follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="220" name="garment_label"
     text_color="0.95 0.92 0.84 1" top="430" width="436" use_ellipses="true">
      Garment
    </text>
    <button follows="left|top" height="22" is_toggle="true" label="" layout="topleft" left="220" name="garment_top_btn" top="450" width="104"
     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
     tool_tip="Top: shirts, jackets, jumpers - made to fit the WolfAvatars base body" />
    <button follows="left|top" height="22" is_toggle="true" label="" layout="topleft" left="330" name="garment_dress_btn" top="450" width="104"
