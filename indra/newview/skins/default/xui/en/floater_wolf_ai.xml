    <text follows="left|top" layout="topleft" left="24" top="173" width="96" height="16" font="SansSerifBold" text_color="0.97 0.93 0.9 1" name="ai_text_layout_lbl">Comes as</text>
    <combo_box follows="left|top" layout="topleft" left="124" top="170" width="200" height="22" name="ai_text_layout" tool_tip="One object, or one object per letter in a rez box">
