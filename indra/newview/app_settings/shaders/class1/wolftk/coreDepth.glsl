#ifndef WOLF_TK_COREDEPTH_GLSL
#define WOLF_TK_COREDEPTH_GLSL

// cSpell:words logdepthbuf

#ifdef DEPTH_PACKING
// Source: three-geospatial packages/core/src/shaders/depth.glsl:4 readDepthValue
float readDepthValue(const sampler2D depthBuffer, const vec2 uv) {
  #if DEPTH_PACKING == 3201
  return unpackRGBAToDepth(texture(depthBuffer, uv));
  #else // DEPTH_PACKING == 3201
  return texture(depthBuffer, uv).r;
  #endif // DEPTH_PACKING == 3201
}
#endif // DEPTH_PACKING

// Source: three-geospatial packages/core/src/shaders/depth.glsl:13 reverseLogDepth
float reverseLogDepth(const float depth, const float near, const float far) {
  #if defined(USE_LOGDEPTHBUF) || defined(USE_LOGARITHMIC_DEPTH_BUFFER)
  float d = pow(2.0, depth * log2(far + 1.0)) - 1.0;
  float a = far / (far - near);
  float b = far * near / (near - far);
  return a + b / d;
  #else // defined(USE_LOGARITHMIC_DEPTH_BUFFER) || defined(USE_LOGARITHMIC_DEPTH_BUFFER)
  return depth;
  #endif // defined(USE_LOGARITHMIC_DEPTH_BUFFER) || defined(USE_LOGARITHMIC_DEPTH_BUFFER)
}

// Source: three-geospatial packages/core/src/shaders/depth.glsl:24 linearizeDepth
float linearizeDepth(const float depth, const float near, const float far) {
  float ndc = depth * 2.0 - 1.0;
  return 2.0 * near * far / (far + near - ndc * (far - near));
}
#endif // WOLF_TK_COREDEPTH_GLSL
