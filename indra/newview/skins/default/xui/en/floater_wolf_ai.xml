    <text follows="left|top" layout="topleft" left="214" top="107" width="42" height="16" font="SansSerifBold" text_color="0.97 0.93 0.9 1" name="ai_text_depth_lbl">Depth</text>
    <spinner text_disabled_color="0.79 0.72 0.67 1" text_enabled_color="0.97 0.93 0.9 1" follows="left|top" layout="topleft" left="258" top="104" width="64" height="22" label="" label_width="0"
