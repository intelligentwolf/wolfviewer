<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- [WOLF BUG REPORT 2026-10-24] Report a Problem (wolffloaterbugreport.cpp): the status bar's bug icon and
     Wolf World > Report a Problem... Paul: "build in a bug reporting a little bug icon on the menu that links to
     tickets and allows them to upload their logs".
     Who and why: a Wolf resident whose viewer misbehaved wants to tell support what happened, with the logs,
     in under a minute and without leaving the viewer. Flow, top to bottom: what it is about, a subject, what
     happened, the logs (on, listed), Send (bottom right); the outcome stays in the status box below the form. -->
<floater
 can_close="true"
 can_minimize="true"
 can_resize="false"
 height="730"
 layout="topleft"
 name="wolf_bug_report"
 help_topic="wolf_bug_report"
 save_rect="true"
 single_instance="true"
 title="Flea Report: found something broken, or got an idea?"
 width="460">
    <!-- [FLEA REPORT 2026-10-26] Paul: "change bug reports to flea reports! lets have some fun", and a flea report is also
         for new features and ideas. Text only; names unchanged. The choice below switches the form (wolffloaterbugreport.cpp
         applyKind): "Something's broken" = pick a category, logs on; "I have an idea" = category "idea", logs off. -->
    <text follows="left|top" height="58" layout="topleft" left="12" name="intro" top="26" width="436" wrap="true">Found a flea, or got an idea? Wolves get fleas, and so do viewers. Tell the support team what went wrong, or what you would like, and we will pick it off. This opens a support ticket on wolf-grid.com; we reply there and by email.</text>

    <radio_group follows="left|top" height="20" layout="topleft" left="12" name="kind" top="88" width="436" draw_border="false">
        <radio_item type="string" follows="left|top" height="20" layout="topleft" left="0" top="0" width="180" label="Something's broken" name="kind_broken" />
        <radio_item type="string" follows="left|top" height="20" layout="topleft" left="200" top="0" width="180" label="I have an idea" name="kind_idea" />
    </radio_group>

    <text follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="12" name="category_label" top="114" width="436">What is it about?</text>
    <combo_box follows="left|top" height="22" layout="topleft" left="12" name="category" top="132" width="436" tool_tip="Pick the closest one; the support team can change it." />

    <text follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="12" name="subject_label" top="162" width="436">Subject</text>
    <line_editor follows="left|top" height="22" layout="topleft" left="12" max_length_bytes="200" name="subject" top="180" width="436" label="For example: the viewer froze when I teleported" />

    <text follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="12" name="body_label" top="210" width="436">What happened?</text>
    <text_editor follows="left|top" height="90" layout="topleft" left="12" max_length="20000" name="body" top="228" width="436" word_wrap="true" commit_on_focus_lost="false" />

    <check_box follows="left|top" height="18" layout="topleft" left="12" name="attach_logs" top="326" width="436" initial_value="true"
     label="Attach my viewer logs" tool_tip="Helps us see what the viewer was doing. Session ids and capability links are taken out first, and only the support team can open them." />
    <text follows="left|top" height="102" layout="topleft" left="30" name="logs_list" top="346" width="418" wrap="true" text_color="LtGray_50">Looking for your logs...</text>

    <!-- [FLEA PICTURES 2026-10-27] Jimmy Olsen, ticket #250: "Can u mod the flea report to also allow people to attach pics?"
         Who and why: a resident wants to SHOW the support team what they see, in a click or two, without leaving the
         viewer. Two ways in, side by side; then one line per picture with its own Remove button (wolffloaterbugreport.cpp
         updatePictures shows "pictures_none" while there are none); then what is sent, in plain words. -->
    <text follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="12" name="pictures_label" top="452" width="436">Pictures (optional, up to 3)</text>
    <button follows="left|top" height="23" layout="topleft" left="12" name="take_snapshot" top="470" width="140" label="Take a snapshot"
     tool_tip="Takes a picture of the viewer screen as it is now, without this window" />
    <button follows="left|top" height="23" layout="topleft" left="160" name="add_picture" top="470" width="140" label="Add a picture..."
     tool_tip="Pick a picture from your computer (PNG, JPEG, BMP or TGA)" />

    <text follows="left|top" height="20" layout="topleft" left="12" name="pictures_none" top="500" width="436" text_color="LtGray_50">No pictures added. They are optional.</text>
    <text follows="left|top" height="20" layout="topleft" left="12" name="picture_1" top="500" width="346" use_ellipses="true" visible="false" />
    <button follows="left|top" height="20" layout="topleft" left="368" name="remove_picture_1" top="498" width="80" label="Remove" tool_tip="Take this picture off the flea report" visible="false" />
    <text follows="left|top" height="20" layout="topleft" left="12" name="picture_2" top="522" width="346" use_ellipses="true" visible="false" />
    <button follows="left|top" height="20" layout="topleft" left="368" name="remove_picture_2" top="520" width="80" label="Remove" tool_tip="Take this picture off the flea report" visible="false" />
    <text follows="left|top" height="20" layout="topleft" left="12" name="picture_3" top="544" width="346" use_ellipses="true" visible="false" />
    <button follows="left|top" height="20" layout="topleft" left="368" name="remove_picture_3" top="542" width="80" label="Remove" tool_tip="Take this picture off the flea report" visible="false" />

    <text follows="left|top" height="70" layout="topleft" left="12" name="pictures_note" top="568" width="436" wrap="true" text_color="LtGray_50">A snapshot is your whole viewer screen without this window. Each picture is made at most 1920 pixels on its longest side and 2 MB, and goes on your ticket like a screenshot added on the website, so check it shows nothing you would not want to share.</text>

    <text_editor follows="left|top" height="46" layout="topleft" left="12" max_length="4096" name="status" top="642" width="436" word_wrap="true" read_only="true" parse_urls="true" show_context_menu="true" visible="false" />

    <button follows="left|bottom" height="23" layout="topleft" left="12" name="my_tickets" top="696" width="110" label="My tickets" tool_tip="Open your support tickets on wolf-grid.com in your browser" />
    <button follows="left|bottom" height="23" layout="topleft" left="130" name="open_ticket" top="696" width="120" label="Open the ticket" tool_tip="Open the ticket you just sent in your browser" visible="false" />
    <button follows="right|bottom" height="23" layout="topleft" left="348" name="send" top="696" width="100" label="Send" />
</floater>
