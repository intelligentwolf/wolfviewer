<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
 border="true"
 follows="top|left"
 height="320"
 help_topic="panel_region_general_tab"
 label="Region"
 layout="topleft"
 left="0"
 name="General"
 top="320"
 width="480">
    <text
     follows="left|top"
     font="SansSerif"
     height="20"
     layout="topleft"
     left="10"
     name="region_text_lbl"
     top="10"
     width="100">
        Region:
    </text>
    <text
     follows="left|top"
     font="SansSerif"
     height="20"
     layout="topleft"
     left_delta="50"
     name="region_text"
     top_delta="0"
     use_ellipses="true"
     width="235">
        unknown
    </text>
    <text
     follows="right|top"
     font="SansSerif"
     height="20"
     layout="topleft"
     top_delta="0"
     right="-100"
     name="estate_id_lbl"
     width="80">
        Estate ID:
    </text>
    <line_editor
     follows="right|top"
     font="SansSerif"
     height="20"
     layout="topleft"
     top_delta="0"
     name="estate_id"
     right="-10"
     initial_value="unknown"
     width="85" />
    <text
     follows="left|top"
     font="SansSerif"
     height="20"
     layout="topleft"
     left="10"
     name="region_type_lbl"
     top="30"
     width="100">
        Type:
    </text>
    <text
     follows="left|top"
     font="SansSerif"
     height="20"
     layout="topleft"
     left_delta="50"
     name="region_type"
     top_delta="0"
     width="400">
        unknown
    </text>
    <text
     follows="right|top"
     font="SansSerif"
     height="20"
     layout="topleft"
     top_delta="0"
     right="-100"
     name="grid_position_lbl"
     width="80">
        Grid Position:
    </text>
    <line_editor
     follows="right|top"
     font="SansSerif"
     height="20"
     layout="topleft"
     right="-55"
     name="grid_position_x"
     top_delta="0"
     default_text="n/a"
     width="40" />
    <line_editor
     follows="right|top"
     font="SansSerif"
     height="20"
     layout="topleft"
     right="-10"
     name="grid_position_y"
     top_delta="0"
     default_text="n/a"
     width="40" />
    <text
     follows="left|top"
     font="SansSerif"
     height="20"
     layout="topleft"
     left="10"
     name="version_channel_text_lbl"
     top="50"
     width="100">
        Version:
    </text>
    <text
     follows="left|top"
     font="SansSerif"
     height="20"
     layout="topleft"
     left_delta="50"
     name="version_channel_text"
     top_delta="0"
     right="-10">
        unknown
    </text>
    <check_box
     height="20"
     label="Block Terraform"
     layout="topleft"
     left="10"
     name="block_terraform_check"
     top="70"
     width="80" />
    <check_box
     height="20"
     label="Block Fly"
     layout="topleft"
     left="10"
     name="block_fly_check"
     top="90"
     width="80" />
    <check_box
     height="20"
     label="Block Parcel Fly Over"
     layout="topleft"
     left="10"
     name="block_fly_over_check"
     tool_tip="Extend access checks upwards to prevent flying over a parcel"
     top="110"
     width="90" />
  <check_box
     height="20"
     label="Allow Damage"
     layout="topleft"
     left="10"
     name="allow_damage_check"
     top="130"
     width="80" />
    <check_box
     height="20"
     label="Restrict Pushing"
     layout="topleft"
     left="10"
     name="restrict_pushobject"
     top="150"
     width="80" />
    <check_box
     height="20"
     label="Allow Land Resell"
     layout="topleft"
     left="10"
     name="allow_land_resell_check"
     top="170"
     width="80" />
    <check_box
     height="20"
     label="Allow Land Join/Divide"
     layout="topleft"
     left="10"
     name="allow_parcel_changes_check"
     top="190"
     width="80" />
    <check_box
     height="20"
     label="Block Land Show in Search"
     layout="topleft"
     left="10"
     name="block_parcel_search_check"
     tool_tip="Let people see this region and its parcels in search results"
     top="210"
     width="80" />
	<spinner
     decimal_digits="0"
     follows="left|top"
     height="20"
     increment="1"
     label="Agent Limit"
     label_width="97"
     layout="topleft"
     left="10"
     max_val="100"
     min_val="1"
     name="agent_limit_spin"
     top="260"
     width="170" />
    <spinner
     follows="left|top"
     height="20"
     increment="0.5"
     label="Object Bonus"
     label_width="97"
     layout="topleft"
     left="10"
     max_val="10"
     min_val="1"
     name="object_bonus_spin"
     top="280"
     width="170" />
    <text
     follows="left|top"
     height="20"
     label="Maturity"
     layout="topleft"
     left="10"
     name="access_text"
     top="310"
     width="100">
        Rating:
    </text>
    <icons_combo_box
     follows="left|top"
     height="20"
     label="Moderate"
     layout="topleft"
     left_delta="100"
     name="access_combo"
     top_delta="0"
     width="105">
        <icons_combo_box.drop_down_button
         image_overlay="Parcel_M_Light"
         image_overlay_alignment="left"
         imgoverlay_label_space="3"
         pad_left="3"/>
        <icons_combo_box.item
         label="Adult"
         name="Adult"
         value="42">
            <item.columns
             halign="center"
             type="icon"
             value="Parcel_R_Light"
             width="20"/>
          </icons_combo_box.item>
        <icons_combo_box.item
         label="Moderate"
         name="Mature"
         value="21">
            <item.columns
             halign="center"
             type="icon"
             value="Parcel_M_Light"
             width="20"/>
        </icons_combo_box.item>
        <icons_combo_box.item
         label="General"
         name="PG"
         value="13">
            <item.columns
             halign="center"
             type="icon"
             value="Parcel_PG_Light"
             width="20"/>
        </icons_combo_box.item>
    </icons_combo_box>
    <!-- [ADULT CONTENT 2026-10-26] llfloaterregioninfo.cpp processRegionInfo. Who and why: a region owner wants to see
         whether the region is Adult Content and find where that is set, in one click. Adult Content is set only on
         wolf-grid.com (region-terrain-work/adult-content/PROTOCOL.md §7), never from here; the icon and text show
         beside the rating when it is on, the link button on Wolf Territories only. -->
    <icon
     follows="left|top"
     height="16"
     image_name="Parcel_AC_Light"
     layout="topleft"
     left="222"
     name="wolf_adult_content_icon"
     top="312"
     visible="false"
     width="18" />
    <text
     follows="left|top"
     height="20"
     layout="topleft"
     left="244"
     name="wolf_adult_content_text"
     tool_tip="Only residents who have completed an age check can enter this region. Hypergrid visitors can't enter."
     top="312"
     visible="false"
     width="226">
        Adult Content
    </text>
    <button
     follows="left|top"
     height="20"
     label="Region type on wolf-grid.com..."
     layout="topleft"
     left="222"
     name="wolf_region_type_btn"
     tool_tip="Open this region's type on wolf-grid.com in your browser. Adult Content is set there by the region owner or the estate owner, never from the viewer."
     top="340"
     visible="false"
     width="230" />
    <!-- [ADULT CONTENT 2026-10-26] W81: shown after the Rating dropdown's Adult Content choice (or another rating while it
         is one) opened wolf-grid.com - llfloaterregioninfo.cpp wolf_ac_on_access_commit. Right of the Teleport Home
         buttons, which end at x 260. -->
    <text
     follows="left|top"
     height="64"
     layout="topleft"
     left="270"
     name="wolf_region_type_note"
     top="368"
     visible="false"
     width="200"
     wrap="true" />
    <button
     enabled="false"
     follows="left|top"
     height="20"
     label="Apply"
     layout="topleft"
     left="108"
     name="apply_btn"
     top="340"
     width="100"/> 
    <button
     follows="left|top"
     height="20"
     label="Teleport Home One Resident..."
     layout="topleft"
     left="10"
     name="kick_btn"
     top_pad="10"
     width="250" />
    <button
     follows="left|top"
     height="20"
     label="Teleport Home All Residents..."
     layout="topleft"
     left_delta="0"
     name="kick_all_btn"
     top_pad="3"
     width="250" />
    <button
     follows="left|top"
     height="20"
     label="Send Message To Region..."
     layout="topleft"
     left_delta="0"
     name="im_btn"
     top_pad="20"
     width="200" />
    <button
     follows="left|top"
     height="20"
     label="Manage Telehub..."
     layout="topleft"
     left="250"
     name="manage_telehub_btn"
     top="70"
     width="180">
		<button.commit_callback
         function="RegionInfo.ManageTelehub" />
    </button>
    <button
     follows="left|top"
     height="20"
     label="Manage Restart Schedule..."
     layout="topleft"
     name="manage_restart_btn"
     top_pad="5"
     left_delta="0"
     width="180">
        <button.commit_callback
         function="RegionInfo.ManageRestart" />
    </button>
</panel>
