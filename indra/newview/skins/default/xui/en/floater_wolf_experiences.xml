<!-- [WolfViewer 2026-10-14] Experiences - the welcome chooser (wolffloaterexperiences.cpp; contract
     wolfstorm/tools/EXPERIENCES_V1.md). Opens by itself after a new resident's login, and from
     Wolf World > Experiences... and the Experiences toolbar button.
     [WolfViewer 2026-10-14] "Add your experience" (add_btn) beside the checkbox: the builder tools.
     [WolfViewer 2026-10-14] mode_experiences | mode_whats_on at the top switch to What's on (events,
     wolfstorm/tools/EVENTS_V1.md).
     [2026-11-21] Paul: "far more exciting, with a 3D scrolling carousel ... a space background like the map". The
     carousel (wolfexperiencecarousel.cpp) is drawn under everything from just below the title: the map's sky, the
     category pills (58 to 106 from its top), the ring and the caption (48 to 126 from its bottom). The widgets here sit
     on top of it: the mode buttons and the subtitle in the row above the pills, the status line over the ring, the
     footer under the caption. What's on's list (cards_scroll) shows over its sky. Bigger (900 x 680) and resizable;
     always opened in the middle of the screen (Paul: "should ALWAYS appear in the middle of the screen"): no saved
     place (save_rect off), centred by the code on every open. The category chips cat_0..cat_6 are gone (the
     carousel draws its own pills).
     [2026-11-22] Paul: "The events part of the Experiences floater: make it like the experiences rather than a long
     list". What's on fills the same carousel (wolffloaterexperiences.cpp fillEventsCarousel); the event list
     (cards_scroll, panel_wolf_experience_card.xml) is gone. show_experiences ("See Experiences") shows under the status
     line's "Nothing on right now", where "Try again" shows after a failure (never both). -->
<floater
 can_close="true"
 can_minimize="true"
 can_resize="true"
 height="680"
 layout="topleft"
 min_height="560"
 min_width="640"
 name="wolf_experiences"
 help_topic="wolf_experiences"
 positioning="centered"
 save_rect="false"
 single_instance="true"
 title="Wolf Experiences"
 width="900">
    <wolf_experience_carousel
     follows="all"
     height="658"
     layout="topleft"
     left="0"
     name="carousel"
     tab_stop="true"
     top="22"
     width="900" />
    <button follows="left|top" height="30" is_toggle="true" label="Experiences" layout="topleft" left="16" name="mode_experiences" top="30" width="130"
     tool_tip="Places to go and things to do on Wolf Territories." />
    <button follows="left|top" height="30" is_toggle="true" label="What's on" layout="topleft" left="148" name="mode_whats_on" top="30" width="130"
     tool_tip="Events happening now and in the next 7 days, in your own time zone." />
    <text follows="left|top|right" font="SansSerifLarge" height="22" layout="topleft" left="294" name="subtitle" text_color="0.79 0.83 0.90 1" top="36" use_ellipses="true" width="590">Pick something to do — we'll take you there.</text>
    <text follows="left|top|right" font="SansSerifLarge" height="44" layout="topleft" left="24" mouse_opaque="false" name="status" text_color="0.79 0.83 0.90 1" top="150" width="852" wrap="true">Finding experiences…</text>
    <button follows="left|top" height="28" label="Try again" layout="topleft" left="24" name="retry" top="198" visible="false" width="110"
     tool_tip="Ask for the list again." />
    <button follows="left|top" height="28" label="See Experiences" layout="topleft" left="24" name="show_experiences" top="198" visible="false" width="170"
     tool_tip="Places to go and things to do on Wolf Territories, any time." />
    <check_box follows="left|bottom" height="18" label="Don't show this when I arrive" layout="topleft" left="16" name="dont_show" top="646" width="220"
     tool_tip="Ticked, this window no longer opens by itself after you log in. You can always open it from Wolf World &gt; Experiences..." />
    <!-- [WolfViewer 2026-10-14] Builder tools (EXPERIENCES_V1.md v1.1): opens floater_wolf_experience_submit.xml. -->
    <button follows="left|bottom" height="28" label="Add your experience" layout="topleft" left="244" name="add_btn" top="641" width="170"
     tool_tip="Made somewhere worth visiting? Add it here: it shows in Wolf Experiences as soon as you submit it." />
    <button follows="right|bottom" height="28" label="Close" layout="topleft" left="790" name="close_btn" top="641" width="94" />
</floater>
