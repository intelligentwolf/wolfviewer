<!-- [W111 VIDEO 2026-11-24] Video Recorder (wolffloaterrecorder.cpp, wolfrecorder.cpp). Ticket 1033; Paul: "yes definitly".
     [W111 RECORDER UI 2026-11-24] Paul: "make the video recorder floater look like a proper video recording tool".
     Who and why: a resident (often 35-65, some older or disabled) wants to film what they see - dancing at a club with
     the music, a build, a ride, often well over five minutes, talking over it - and find the video afterwards.
     Flow: open (Avatar menu, Wolf World > Tools, or the toolbar button) -> press the big round Record button -> the
     monitor shows the picture, the REC light and the running time; Pause/Resume if needed -> press Stop -> "Saved" with
     the file name, size and length -> Play or Open folder.
     Modelled on camcorders and OBS Studio: a dark monitor at the top (drawn by the window: preview, REC light, timecode),
     the transport buttons under it (one primary action, the biggest target), then the settings grouped Picture, Sound
     (each source with its level meter, also drawn by the window) and Saving. Errors stay until the next press.
     While the whole window is recorded, this window is kept out of the video (WolfRecorder::holdBackFromVideo), its
     tooltips are not shown and its lists are closed (Paul: "the recording window should never be recorded"). No help
     button: the help window it opens is a separate window that would land in the video.
     Paul: "make sure it scrolls". The monitor and the transport buttons stay at the top, always in view; everything below
     them (status, Picture, Sound, Saving) is in a scroll container, so the window fits short screens (640 px by default,
     for 768-px screens) and can be made smaller (380 px) or larger. The scroll bar shows only when needed; the mouse
     wheel scrolls it; a control reached with the keyboard is scrolled into view (wolffloaterrecorder.cpp). -->
<!-- [HUD KIT 2026-11-25] Paul's Gunmetal Console look (wolfhudkit.h), as the Wolf HUDs window: the window a machined gunmetal plate,
     the monitor and the sound meters lit instruments behind glass in chrome frames, Record and Pause backlit keys (lit while
     recording / paused, wolffloaterrecorder.cpp), Picture, Sound and Saving each framed in a recessed inlay, every button a key
     44 px high (Play, Open folder, Get the video codec, Change... and Open folder were 28). Words in the kit's own colours
     (colors.xml WolfHudKit*: on the plate Text 8.9:1, Dim 6.4:1, Amber 6.0:1; on the inlay, drawn at WolfHudKitInlay, 8.3 / 6.0 /
     5.7:1). The combo boxes, check boxes and sliders stay the viewer's standard ones (keyboard-operable; inventory small_ok).
     Same controls, order, words, tooltips and actions (scripts/wolf/hudkit/inventory/recorder.json); the scrolling is kept:
     every part below the buttons moved down with the taller keys and the settings panel grew to 552.
     [RECORDING PRIVACY 2026-11-25] the people-left-out note under the status (everything below moved down 40) and the Privacy
     section at the end: the settings panel grew to 712. -->
<floater
 can_close="true"
 can_minimize="true"
 can_resize="true"
 height="640"
 layout="topleft"
 min_height="380"
 min_width="500"
 name="wolf_recorder"
 bg_opaque_image="WolfHudKit_Plate"
 bg_alpha_image="WolfHudKit_Plate"
 bg_opaque_image_overlay="WolfHudKitImage"
 bg_alpha_image_overlay="WolfHudKitImage"
 save_rect="true"
 single_instance="true"
 title="Video Recorder"
 width="500">
    <view follows="left|top|right" height="140" layout="topleft" left="10" mouse_opaque="false" name="monitor" top="26" width="480" />
    <wolf_recorder_transport_button follows="left|top" font="SansSerifHuge" height="58" label="Record" layout="topleft" left="12" name="record_btn" tab_stop="true" top="174" width="200" tool_tip="Start recording what you see and hear. Press again to stop and save." />
    <wolf_recorder_transport_button follows="left|top" font="SansSerifHuge" height="58" label="Pause" layout="topleft" left="224" name="pause_btn" tab_stop="true" top="174" width="190" tool_tip="Pause the recording. Nothing is recorded until you press Resume." />

    <scroll_container border_visible="false" follows="all" height="398" layout="topleft" left="0" name="settings_scroll" opaque="false" reserve_scroll_corner="false" top="238" width="500">
    <panel background_visible="false" follows="left|top" height="712" layout="topleft" left="0" name="settings_panel" top="0" width="484">
        <!-- the three framed sections, first so they are drawn under everything else (llview.cpp addChild: push_front; draw: rbegin) -->
        <icon follows="left|top" height="112" layout="topleft" left="6" name="picture_frame" top="160" width="474" color="WolfHudKitInlay" image_name="WolfHudKit_Inlay" mouse_opaque="false" />
        <icon follows="left|top" height="174" layout="topleft" left="6" name="sound_frame" top="274" width="474" color="WolfHudKitInlay" image_name="WolfHudKit_Inlay" mouse_opaque="false" />
        <icon follows="left|top" height="140" layout="topleft" left="6" name="saving_frame" top="450" width="474" color="WolfHudKitInlay" image_name="WolfHudKit_Inlay" mouse_opaque="false" />

        <text follows="left|top" font="SansSerif" height="46" layout="topleft" left="14" name="status" top="2" width="280" wrap="true" text_color="WolfHudKitText">Press Record to start.</text>
        <button follows="left|top" font="SansSerif" height="44" label="Play" layout="topleft" left="300" name="play_btn" top="4" width="80" tool_tip="Play the video you have just saved, in this computer's video player" visible="false" label_color="WolfHudKitText" label_color_disabled="WolfHudKitTextDim" image_unselected="WolfHudKit_Key" image_hover_unselected="WolfHudKit_Key" image_selected="WolfHudKit_KeyLit" image_hover_selected="WolfHudKit_KeyLit" image_pressed="WolfHudKit_KeyDown" image_pressed_selected="WolfHudKit_KeyDown" image_disabled="WolfHudKit_Key" image_disabled_selected="WolfHudKit_KeyLit" image_color="WolfHudKitImage" image_color_disabled="WolfHudKitImageDisabled" hover_glow_amount="0.22" />
        <button follows="left|top" font="SansSerif" height="44" label="Open folder" layout="topleft" left="386" name="saved_folder_btn" top="4" width="92" tool_tip="Show the folder your videos are saved in" visible="false" label_color="WolfHudKitText" label_color_disabled="WolfHudKitTextDim" image_unselected="WolfHudKit_Key" image_hover_unselected="WolfHudKit_Key" image_selected="WolfHudKit_KeyLit" image_hover_selected="WolfHudKit_KeyLit" image_pressed="WolfHudKit_KeyDown" image_pressed_selected="WolfHudKit_KeyDown" image_disabled="WolfHudKit_Key" image_disabled_selected="WolfHudKit_KeyLit" image_color="WolfHudKitImage" image_color_disabled="WolfHudKitImageDisabled" hover_glow_amount="0.22" />
        <button follows="left|top" font="SansSerif" height="44" label="Get the video codec (free, from Cisco)" layout="topleft" left="290" name="codec_btn" top="4" width="188" tool_tip="Downloads Cisco's free H.264 video codec to this computer. Only needed when the computer's own video encoder cannot be used." visible="false" label_color="WolfHudKitText" label_color_disabled="WolfHudKitTextDim" image_unselected="WolfHudKit_Key" image_hover_unselected="WolfHudKit_Key" image_selected="WolfHudKit_KeyLit" image_hover_selected="WolfHudKit_KeyLit" image_pressed="WolfHudKit_KeyDown" image_pressed_selected="WolfHudKit_KeyDown" image_disabled="WolfHudKit_Key" image_disabled_selected="WolfHudKit_KeyLit" image_color="WolfHudKitImage" image_color_disabled="WolfHudKitImageDisabled" hover_glow_amount="0.22" />
        <text follows="left|top" font="SansSerifSmall" height="30" layout="topleft" left="290" name="codec_note" top="50" width="188" visible="false" wrap="true" text_color="WolfHudKitTextDim">OpenH264 Video Codec provided by Cisco Systems, Inc.</text>
        <!-- [RECORDING PRIVACY 2026-11-25] ticket 1060: how many people around are left out of the video, under the status -->
        <text follows="left|top" font="SansSerif" height="36" layout="topleft" left="14" name="privacy_note" top="82" width="464" wrap="true" text_color="WolfHudKitAmber" />
        <text follows="left|top" font="SansSerif" height="34" layout="topleft" left="14" name="message" top="122" width="464" wrap="true" text_color="WolfHudKitText" />

        <text follows="left|top" font="SansSerifLargeBold" height="20" layout="topleft" left="14" name="picture_heading" top="164" width="200" text_color="WolfHudKitText">Picture</text>
        <text follows="left|top" font="SansSerif" height="22" layout="topleft" left="24" name="size_label" top="190" width="140" text_color="WolfHudKitText">Size</text>
        <combo_box follows="left|top" height="24" layout="topleft" left="170" name="size_combo" top="188" width="300" tool_tip="The size of the video picture. Your window is fitted inside, with black bars when its shape differs.">
            <combo_box.item label="Standard - 1280 x 720 (720p)" name="size_720" value="720" />
            <combo_box.item label="High - 1920 x 1080 (1080p)" name="size_1080" value="1080" />
        </combo_box>
        <text follows="left|top" font="SansSerif" height="22" layout="topleft" left="24" name="fps_label" top="218" width="140" text_color="WolfHudKitText">Smoothness</text>
        <combo_box follows="left|top" height="24" layout="topleft" left="170" name="fps_combo" top="216" width="300" tool_tip="How many pictures a second the video aims for. When WolfViewer draws fewer, the video has fewer.">
            <combo_box.item label="30 pictures a second" name="fps_30" value="30" />
            <combo_box.item label="60 pictures a second (busier computer)" name="fps_60" value="60" />
        </combo_box>
        <check_box control_name="WolfRecorderShowInterface" follows="left|top" height="22" label="Show my windows, menus and name tags in the video" layout="topleft" left="24" name="show_ui_check" top="246" width="446" tool_tip="Off: only the world is recorded. On: the whole window, as you see it. This window and the REC sign are never in the video." label_text.text_color="WolfHudKitText" label_text.text_readonly_color="WolfHudKitTextDim" />

        <text follows="left|top" font="SansSerifLargeBold" height="20" layout="topleft" left="14" name="sound_heading" top="278" width="120" text_color="WolfHudKitText">Sound</text>
        <text follows="left|top" font="SansSerifSmall" halign="right" height="16" layout="topleft" left="130" name="sound_hint" top="282" width="340" text_color="WolfHudKitTextDim">The bars show how loud each sound is while you record.</text>
        <check_box control_name="WolfRecorderSoundWorld" follows="left|top" height="22" label="World sound and music" layout="topleft" left="24" name="world_check" top="302" width="200" tool_tip="Sounds, music and media as you hear them" label_text.text_color="WolfHudKitText" label_text.text_readonly_color="WolfHudKitTextDim" />
        <slider control_name="WolfRecorderLevelWorld" decimal_digits="1" follows="left|top" height="22" increment="0.1" initial_value="1" layout="topleft" left="228" max_val="2" min_val="0" name="world_level" show_text="false" top="302" width="130" tool_tip="How loud the world sound is in the video" />
        <view follows="left|top" height="22" layout="topleft" left="364" name="world_meter" top="302" width="108" tool_tip="How loud the world sound is in the video, while you record: green is good, amber is loud, red (with the word Loud) is too loud - move the slider down." />
        <text follows="left|top" font="SansSerif" height="28" layout="topleft" left="44" name="world_note" top="324" width="426" wrap="true" text_color="WolfHudKitTextDim" />
        <check_box control_name="WolfRecorderSoundVoice" follows="left|top" height="22" label="Voice chat (other people)" layout="topleft" left="24" name="voice_check" top="354" width="200" tool_tip="Other people's voices as you hear them in voice chat" label_text.text_color="WolfHudKitText" label_text.text_readonly_color="WolfHudKitTextDim" />
        <slider control_name="WolfRecorderLevelVoice" decimal_digits="1" follows="left|top" height="22" increment="0.1" initial_value="1" layout="topleft" left="228" max_val="2" min_val="0" name="voice_level" show_text="false" top="354" width="130" tool_tip="How loud voice chat is in the video" />
        <view follows="left|top" height="22" layout="topleft" left="364" name="voice_meter" top="354" width="108" tool_tip="How loud voice chat is in the video, while you record: green is good, amber is loud, red (with the word Loud) is too loud - move the slider down." />
        <text follows="left|top" font="SansSerif" height="18" layout="topleft" left="44" name="voice_note" top="376" width="426" wrap="true" text_color="WolfHudKitTextDim">Other people's voices will be recorded - please ask before sharing.</text>
        <check_box control_name="WolfRecorderSoundMic" follows="left|top" height="22" label="My microphone" layout="topleft" left="24" name="mic_check" top="396" width="200" tool_tip="Your own voice, for talking over the video. Not sent to voice chat." label_text.text_color="WolfHudKitText" label_text.text_readonly_color="WolfHudKitTextDim" />
        <slider control_name="WolfRecorderLevelMic" decimal_digits="1" follows="left|top" height="22" increment="0.1" initial_value="1" layout="topleft" left="228" max_val="2" min_val="0" name="mic_level" show_text="false" top="396" width="130" tool_tip="How loud your microphone is in the video" />
        <view follows="left|top" height="22" layout="topleft" left="364" name="mic_meter" top="396" width="108" tool_tip="How loud your microphone is in the video, while you record: green is good, amber is loud, red (with the word Loud) is too loud - move the slider down." />
        <text follows="left|top" font="SansSerif" height="30" layout="topleft" left="44" name="mic_note" top="418" width="426" wrap="true" text_color="WolfHudKitTextDim">The microphone is only switched on while a recording runs, and off while it is paused. With speakers, it also picks up the world sound.</text>

        <text follows="left|top" font="SansSerifLargeBold" height="20" layout="topleft" left="14" name="saving_heading" top="454" width="200" text_color="WolfHudKitText">Saving</text>
        <text follows="left|top" font="SansSerif" height="44" layout="topleft" left="24" name="folder_text" top="480" width="236" wrap="true" text_color="WolfHudKitText">...</text>
        <button follows="left|top" font="SansSerif" height="44" label="Change..." layout="topleft" left="266" name="change_folder_btn" top="480" width="100" tool_tip="Choose the folder your videos are saved in" label_color="WolfHudKitText" label_color_disabled="WolfHudKitTextDim" image_unselected="WolfHudKit_Key" image_hover_unselected="WolfHudKit_Key" image_selected="WolfHudKit_KeyLit" image_hover_selected="WolfHudKit_KeyLit" image_pressed="WolfHudKit_KeyDown" image_pressed_selected="WolfHudKit_KeyDown" image_disabled="WolfHudKit_Key" image_disabled_selected="WolfHudKit_KeyLit" image_color="WolfHudKitImage" image_color_disabled="WolfHudKitImageDisabled" hover_glow_amount="0.22" />
        <button follows="left|top" font="SansSerif" height="44" label="Open folder" layout="topleft" left="372" name="open_folder_btn" top="480" width="100" tool_tip="Show the folder your videos are saved in" label_color="WolfHudKitText" label_color_disabled="WolfHudKitTextDim" image_unselected="WolfHudKit_Key" image_hover_unselected="WolfHudKit_Key" image_selected="WolfHudKit_KeyLit" image_hover_selected="WolfHudKit_KeyLit" image_pressed="WolfHudKit_KeyDown" image_pressed_selected="WolfHudKit_KeyDown" image_disabled="WolfHudKit_Key" image_disabled_selected="WolfHudKit_KeyLit" image_color="WolfHudKitImage" image_color_disabled="WolfHudKitImageDisabled" hover_glow_amount="0.22" />
        <text follows="left|top" font="SansSerif" height="22" layout="topleft" left="24" name="limit_label" top="536" width="140" text_color="WolfHudKitText">Stop by itself</text>
        <combo_box follows="left|top" height="24" layout="topleft" left="170" name="limit_combo" top="534" width="300" tool_tip="Whether a recording stops by itself after a set time. With Never it runs until you press Stop; it still stops by itself, and says so, if the disk gets nearly full.">
            <combo_box.item label="Never - I will press Stop" name="limit_never" value="0" />
            <combo_box.item label="After 1 minute" name="limit_1" value="1" />
            <combo_box.item label="After 2 minutes" name="limit_2" value="2" />
            <combo_box.item label="After 5 minutes" name="limit_5" value="5" />
            <combo_box.item label="After 10 minutes" name="limit_10" value="10" />
            <combo_box.item label="After 15 minutes" name="limit_15" value="15" />
            <combo_box.item label="After 30 minutes" name="limit_30" value="30" />
            <combo_box.item label="After 60 minutes" name="limit_60" value="60" />
        </combo_box>
        <text follows="left|top" font="SansSerif" height="20" layout="topleft" left="24" name="space_note" top="564" width="446" wrap="true" text_color="WolfHudKitTextDim" />
    
        <!-- [RECORDING PRIVACY 2026-11-25] Ticket 1060 (Luke Koda: "That should be up to each person"). The resident's own
             choice, kept on the grid website (wolfrecordprivacy.h), the same box as Preferences > Privacy and the website's
             account page. Saved as soon as it is ticked; honest about what it cannot do. -->
        <icon follows="left|top" height="112" layout="topleft" left="6" name="privacy_frame" top="594" width="474" color="WolfHudKitInlay" image_name="WolfHudKit_Inlay" mouse_opaque="false" />
        <text follows="left|top" font="SansSerifLargeBold" height="20" layout="topleft" left="14" name="privacy_heading" top="598" width="200" text_color="WolfHudKitText">Privacy</text>
        <check_box follows="left|top" height="22" label="Don't include me in other people's recordings" layout="topleft" left="24" name="no_recording_check" top="624" width="446" tool_tip="Ticked: other people's WolfViewer video recordings show a grey shape instead of you and your name tag. Saved on your Wolf Territories account straight away." label_text.text_color="WolfHudKitText" label_text.text_readonly_color="WolfHudKitTextDim" />
        <text follows="left|top" font="SansSerif" height="46" layout="topleft" left="44" name="no_recording_note" top="648" width="426" wrap="true" text_color="WolfHudKitTextDim">Leaves you out of other people's WolfViewer recordings (other screen-recording programs can't be stopped).</text>
    </panel>
