<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- [WOLF DJ 2026-10-04] World > Wolf DJ / Talk Show... (wolffloaterdj.cpp, engine wolfdjaudio.cpp).
     A mini mixer that sends in-world voice, the microphone and music from other programs (or the
     Wolf DJ playlist) to the region owner's own radio stream on cast.wolfterritories.org. Paul:
     "talk show mode so that we can pick up voice in world and transmit it on to the stream",
     "faders as well with eq levels", "level indicator leds", "a button to just listen to one
     channel through the output", "can we have more channels and also a refresh button for music
     sources", "make it resizeable with a limit to small". The channel strips scroll when the
     window is made smaller than them; the stream settings and the Go Live row stay put. -->
<floater
 can_close="true"
 can_minimize="true"
 can_resize="true"
 height="752"
 layout="topleft"
 min_height="400"
 min_width="440"
 name="wolf_dj"
 help_topic="wolf_dj"
 save_rect="true"
 single_instance="true"
 title="Wolf DJ / Talk Show"
 width="776">
    <text follows="left|top" height="16" layout="topleft" left="10" name="url_label" top="24" width="96">Stream address</text>
    <line_editor follows="left|top|right" height="20" layout="topleft" left="108" max_length_bytes="255" name="stream_url" top="22" width="484"
     tool_tip="Your stream from My Radio Stream on wolf-grid.com, e.g. http://cast.wolfterritories.org:8000/radio/your-name. Every region owner gets one free." />
    <button follows="right|top" height="20" label="Grid Stream" layout="topleft" left="596" name="get_stream" top="22" width="124"
     tool_tip="Get your own Wolf Territories radio stream and fill in its address and password. Every region owner has one; it is made for you the first time." />
    <button follows="right|top" height="20" label="Copy" layout="topleft" left="724" name="copy_url" top="22" width="48"
     tool_tip="Copy your stream address, to give a region owner for their land's music." />
    <text follows="left|top" height="16" layout="topleft" left="10" name="pw_label" top="50" width="96">Password</text>
    <line_editor follows="left|top" height="20" is_password="true" layout="topleft" left="108" max_length_bytes="128" name="stream_password" top="48" width="120"
     tool_tip="Your stream password (shown once on My Radio Stream). Kept in the viewer's encrypted store." />
    <check_box follows="left|top" height="16" label="Save password" layout="topleft" left="234" name="save_password" top="50" width="110"
     tool_tip="Keep the stream password in the viewer's encrypted store for next time. Untick to forget it." />
    <text follows="left|top" height="16" layout="topleft" left="346" name="station_label" top="50" width="70">Show name</text>
    <line_editor follows="left|top|right" height="20" layout="topleft" left="418" max_length_bytes="120" name="station_name" top="48" width="354" />
    <scroll_container
     follows="all"
     height="490"
     layout="topleft"
     left="0"
     name="strips_scroll"
     opaque="false"
     reserve_scroll_corner="false"
     top="74"
     width="776">
        <panel
         follows="left|top"
         height="490"
         layout="topleft"
         left="0"
         name="strips_panel"
         top="0"
         background_visible="false"
         width="776">
            <!-- [WOLF DJ 2026-10-10] The mixing desk (wolfdjdesk.cpp): every strip, the stereo master and
                 the meter bridge are drawn and handled there. Paul: "make the volume controls into proper
                 mixing desk sliders", "upgrade the whole look to look like a mixing desk with graphics",
                 "a MON button on each channel", "stereo sliders for the main mix". Its size is
                 WolfDJDesk::WIDTH x HEIGHT. -->
            <wolf_dj_desk follows="left|top" height="486" layout="topleft" left="8" name="desk" top="2" width="760" />
            <!-- The music channels' sources, laid over the slots the desk leaves for them (positioned in
                 wolffloaterdj.cpp postBuild from WolfDJDesk::sourceRect). -->
            <combo_box follows="left|top" height="20" layout="topleft" left="0" name="source_music_a" top="0" width="76" tool_tip="What plays on this channel: a program, everything you hear, or the Wolf DJ playlist. The list refreshes every time you open it." />
            <combo_box follows="left|top" height="20" layout="topleft" left="0" name="source_music_b" top="0" width="76" tool_tip="What plays on this channel: a program, everything you hear, or the Wolf DJ playlist. The list refreshes every time you open it." />
            <combo_box follows="left|top" height="20" layout="topleft" left="0" name="source_music_c" top="0" width="76" tool_tip="What plays on this channel: a program, everything you hear, or the Wolf DJ playlist. The list refreshes every time you open it." />
            <combo_box follows="left|top" height="20" layout="topleft" left="0" name="source_music_d" top="0" width="76" tool_tip="What plays on this channel: a program, everything you hear, or the Wolf DJ playlist. The list refreshes every time you open it." />
        </panel>
    </scroll_container>
    <!-- [WOLF DJ 2026-10-05] Jingle pads (WolfDJJingles, wolfdjplayer.cpp). Paul: "a jingle set of buttons in
         different colours you can apply files to in the playlist folder". The colours are set in
         wolffloaterdj.cpp (PAD_COLOURS); the files are put on them from the Playlist window. -->
    <text follows="left|bottom" height="16" layout="topleft" left="10" name="jingles_label" top="574" width="52">Jingles</text>
    <button follows="left|bottom" height="22" label="1" layout="topleft" left="62" name="jingle_0" top="570" width="62" use_ellipses="true" />
    <button follows="left|bottom" height="22" label="2" layout="topleft" left="128" name="jingle_1" top="570" width="62" use_ellipses="true" />
    <button follows="left|bottom" height="22" label="3" layout="topleft" left="194" name="jingle_2" top="570" width="62" use_ellipses="true" />
    <button follows="left|bottom" height="22" label="4" layout="topleft" left="260" name="jingle_3" top="570" width="62" use_ellipses="true" />
    <button follows="left|bottom" height="22" label="5" layout="topleft" left="326" name="jingle_4" top="570" width="62" use_ellipses="true" />
    <button follows="left|bottom" height="22" label="6" layout="topleft" left="392" name="jingle_5" top="570" width="62" use_ellipses="true" />
    <button follows="left|bottom" height="22" label="7" layout="topleft" left="458" name="jingle_6" top="570" width="62" use_ellipses="true" />
    <button follows="left|bottom" height="22" label="8" layout="topleft" left="524" name="jingle_7" top="570" width="62" use_ellipses="true" />
    <button follows="left|bottom" height="22" label="Stop" layout="topleft" left="590" name="jingle_stop" top="570" width="40" tool_tip="Stop the jingle that is playing." />
    <check_box follows="left|bottom" height="16" label="Talk-over (my mic dips the music)" layout="topleft" left="10" name="talk_over" top="602" width="230" />
    <check_box follows="left|bottom" height="16" label="Play on my land when I go live" layout="topleft" left="250" name="play_on_land" top="602" width="220"
     tool_tip="On your own region: sets this parcel's music to your stream while you are live, and puts the old music back after." />
    <button follows="right|bottom" height="20" label="Refresh sources" layout="topleft" left="652" name="refresh_sources" top="600" width="120" tool_tip="Look again for programs playing sound. A program only shows while it is playing: start it playing first, then press this (the lists also refresh when you open them)." />
    <text follows="left|right|bottom" height="16" layout="topleft" left="10" name="sources_note" top="622" width="762" text_color="LtGray_50" use_ellipses="true"
     tool_tip="To send music from another program (a music player, a browser...): start it playing first, press Refresh sources, then pick it in the list at the top of Music 1, 2, 3 or 4." />
    <text follows="left|bottom" height="16" layout="topleft" left="10" name="np_label" top="644" width="80">Now playing</text>
    <line_editor follows="left|bottom" height="20" label="Artist" layout="topleft" left="92" max_length_bytes="120" name="now_artist" top="642" width="150" />
    <line_editor follows="left|right|bottom" height="20" label="Title" layout="topleft" left="246" max_length_bytes="160" name="now_title" top="642" width="432" />
    <button follows="right|bottom" height="20" label="Send title" layout="topleft" left="684" name="send_title" top="642" width="88" tool_tip="Show this to listeners as the song playing now." />
    <button follows="left|bottom" height="28" image_color="ButtonImageColor" label="Go Live" layout="topleft" left="10" name="go_live" top="672" width="110" font="SansSerifBold" />
    <button follows="left|bottom" height="28" label="Playlist..." layout="topleft" left="126" name="open_playlist" top="672" width="90" tool_tip="Open the Wolf DJ playlist: pick songs from your computer and play them on a music channel." />
    <text follows="left|right|bottom" font="SansSerifBold" height="34" layout="topleft" left="224" name="status_text" top="672" width="548" wrap="true">Off air.</text>
    <text follows="left|right|bottom" height="32" layout="topleft" left="10" name="land_note" top="708" width="762" wrap="true" text_color="LtGray_50" />
</floater>
