<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- [WOLF CHAT 2026-10-21] Right-click on a channel in Wolf Chat's sidebar - the group's OWNERS only
     (wolffloaterchat.cpp WolfFloaterChat::showChannelMenu; php/wolfchat.php refuses anyone else). Never shown for
     #group-chat (the group's own chat). Delete asks first; it is placed apart from the others. [2026-10-21] The
     Discord items show for text channels only: Bridge when not linked (or the link stopped), Unlink when linked.
     [DISCORD VOICE 2026-10-22] Voice rooms get the voice pair instead: Bridge to Discord voice / Unlink Discord voice.
     [2026-10-23] Rename became Edit channel (name, emoji, category), with Move up / Move down inside its category. -->
<context_menu
 layout="topleft"
 name="Wolf Chat Channel Menu">
    <menu_item_call
     label="Edit channel (name, emoji, category)..."
     layout="topleft"
     name="edit">
        <menu_item_call.on_click
         function="WolfChatChannel.Action"
         parameter="edit" />
    </menu_item_call>
    <menu_item_call
     label="Move up"
     layout="topleft"
     name="up">
        <menu_item_call.on_click
         function="WolfChatChannel.Action"
         parameter="up" />
        <menu_item_call.on_enable
         function="WolfChatChannel.Enable"
         parameter="up" />
    </menu_item_call>
    <menu_item_call
     label="Move down"
     layout="topleft"
     name="down">
        <menu_item_call.on_click
         function="WolfChatChannel.Action"
         parameter="down" />
        <menu_item_call.on_enable
         function="WolfChatChannel.Enable"
         parameter="down" />
    </menu_item_call>
    <menu_item_call
     label="Who can see this channel..."
     layout="topleft"
     name="roles">
        <menu_item_call.on_click
         function="WolfChatChannel.Action"
         parameter="roles" />
    </menu_item_call>
    <menu_item_call
     label="Bridge to Discord..."
     layout="topleft"
     name="bridge">
        <menu_item_call.on_click
         function="WolfChatChannel.Action"
         parameter="bridge" />
        <menu_item_call.on_visible
         function="WolfChatChannel.Visible"
         parameter="bridge" />
    </menu_item_call>
    <menu_item_call
     label="Unlink from Discord..."
     layout="topleft"
     name="unbridge">
        <menu_item_call.on_click
         function="WolfChatChannel.Action"
         parameter="unbridge" />
        <menu_item_call.on_visible
         function="WolfChatChannel.Visible"
         parameter="unbridge" />
    </menu_item_call>
    <menu_item_call
     label="Bridge to Discord voice..."
     layout="topleft"
     name="bridge_voice">
        <menu_item_call.on_click
         function="WolfChatChannel.Action"
         parameter="bridge_voice" />
        <menu_item_call.on_visible
         function="WolfChatChannel.Visible"
         parameter="bridge_voice" />
    </menu_item_call>
    <menu_item_call
     label="Unlink Discord voice..."
     layout="topleft"
     name="unbridge_voice">
        <menu_item_call.on_click
         function="WolfChatChannel.Action"
         parameter="unbridge_voice" />
        <menu_item_call.on_visible
         function="WolfChatChannel.Visible"
         parameter="unbridge_voice" />
    </menu_item_call>
    <menu_item_separator
     layout="topleft" />
    <menu_item_call
     label="Delete channel..."
     layout="topleft"
     name="delete">
        <menu_item_call.on_click
         function="WolfChatChannel.Action"
         parameter="delete" />
    </menu_item_call>
</context_menu>
