     tool_tip="Trousers (also shorts) - made to fit the WolfAvatars base body" />
    <button follows="left|top" height="22" is_toggle="true" label="" layout="topleft" left="550" name="garment_skirt_btn" top="450" width="104"
     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
     tool_tip="Skirt - made to fit the WolfAvatars base body" />
    <button follows="left|top" height="22" is_toggle="true" label="" layout="topleft" left="220" name="garment_shoes_btn" top="478" width="104"
     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
     tool_tip="Shoes - made to fit the WolfAvatars base body" />
    <button follows="left|top" height="22" is_toggle="true" label="" layout="topleft" left="330" name="garment_hat_btn" top="478" width="104"
     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
     tool_tip="Hat - made to fit the WolfAvatars base body" />
    <button follows="left|top" height="22" is_toggle="true" label="" layout="topleft" left="440" name="garment_cape_btn" top="478" width="104"
     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
     tool_tip="Cape - made to fit the WolfAvatars base body" />
    <button follows="left|top" height="22" is_toggle="true" label="" layout="topleft" left="550" name="garment_gown_btn" top="478" width="104"
     image_color="0 0 0 0" image_color_disabled="0 0 0 0" hover_glow_amount="0" label_shadow="false"
     tool_tip="Gown - made to fit the WolfAvatars base body" />
    <text type="string" length="1" follows="left|top" font="SansSerifSmall" height="14" layout="topleft" left="220" name="garment_hint"
     text_color="0.78 0.78 0.86 1" top="510" width="436" use_ellipses="true">
      Made to fit the body you choose below - wear it (Add) over that avatar.
    </text>
    <text type="string" length="1" follows="left|top" font="SansSerifSmall" height="14" layout="topleft" left="220" name="clothes_hint"
     text_color="0.78 0.78 0.86 1" top="424" width="436" use_ellipses="true">
      Plain underwear, barefoot - add your own clothes in-world.
    </text>
    <text type="string" length="1" follows="left|top" font="SansSerifBold" height="16" layout="topleft" left="220" name="height_label"
     text_color="0.95 0.92 0.84 1" top="444" width="436">
      Height
    </text>
    <line_editor follows="left|top" height="22" layout="topleft" left="220" max_length_bytes="8" name="height"
     tool_tip="Height in metres, 0.3 to 4" top="462" width="70" />
    <text type="string" length="1" follows="left|top" height="32" layout="topleft" left="298" name="height_note"
     text_color="0.78 0.78 0.86 1" top="464" width="358" word_wrap="true" />
    <text type="string" length="1" follows="left|top" height="44" layout="topleft" left="220" name="tips"
     text_color="0.78 0.78 0.86 1" top="500" width="436" word_wrap="true">
      One character, simple clothes, no long skirts or capes - the pictures show it in a T-pose (people) or side-on (animals).
    </text>
    <text type="string" length="1" follows="left|top" height="32" layout="topleft" left="220" name="form_error"
