<!-- [GREEDY TABLE HERE 2026-11-11] "Put a Greedy table here" (wolfgreedysetup.cpp). Paul testing W104: "greedy went to the menu,
     there's no button to rez a table"; his rule for every game: a SETUP HELPER, "stand there, press Rez" for each piece.
     The same two steps as the in-world "Greedy - set up box" (region-terrain-work/greedy-dice-2026-11-10/README.md s6):
     step 1 the table (Greedy Table, or Jimmy Olsen's Greedy Table (Wolf Grid)), step 2 the board, then "Greedy is set up!".
     Who and why: a resident aged 35-65 wants a Greedy table on their land to play with friends. They open Greedy, press
     "Put a Greedy table here", stand where they want it, and press one big button. Each step and each problem is said in
     words in the message box under the buttons, and stays there until the next press (never a countdown). -->
<floater
 can_close="true"
 can_minimize="true"
 can_resize="false"
 height="500"
 layout="topleft"
 name="wolf_greedy_setup"
 help_topic="wolf_greedy_setup"
 save_rect="true"
 single_instance="true"
 title="Put a Greedy table here"
 width="460">
    <panel follows="left|top" height="480" layout="topleft" left="0" name="gs_panel" top="20" width="460" background_visible="true" background_opaque="true" bg_opaque_image="WolfGreedy_Wood" bg_alpha_image="WolfGreedy_Wood">
        <icon follows="left|top" height="48" layout="topleft" left="10" name="gs_logo" top="6" width="48" image_name="WolfGreedy_Logo" tool_tip="Greedy" />
        <text follows="left|top" font="SansSerifHuge" font.style="BOLD" height="34" layout="topleft" left="66" name="gs_title" top="12" width="384" text_color="1 0.84 0.3 1">Let's set up Greedy!</text>
        <icon follows="left|top" height="248" layout="topleft" left="8" name="gs_card" top="60" width="444" image_name="WolfGreedy_Plate" color="0.12 0.1 0.08 0.96" />
        <text follows="left|top" font="SansSerifLarge" font.style="BOLD" height="24" layout="topleft" left="20" name="gs_step" top="70" width="420" text_color="0.89 0.73 0.35 1">Step 1 of 2: the table</text>
        <text follows="left|top" font="SansSerifLarge" height="96" layout="topleft" left="20" name="gs_body" top="98" width="420" wrap="true" text_color="0.95 0.92 0.85 1"> </text>
        <text follows="left|top" font="SansSerifBold" height="18" layout="topleft" left="20" name="gs_which_label" top="198" width="420" text_color="0.89 0.73 0.35 1">Which table?</text>
        <radio_group follows="left|top" height="48" layout="topleft" left="20" name="gs_which" top="218" width="420" draw_border="false">
            <radio_item type="string" follows="left|top" height="22" layout="topleft" left="0" top="0" width="420" label="Greedy Table - six seats, the score panel at the head" name="table" />
            <radio_item type="string" follows="left|top" height="22" layout="topleft" left="0" top="24" width="420" label="Greedy Table (Wolf Grid) - Jimmy Olsen's wolf table" name="table_wolfgrid" />
        </radio_group>
        <icon follows="left|top" height="40" layout="topleft" left="64" name="gs_die_a" top="210" width="40" image_name="WolfGreedy_Die5" visible="false" />
        <icon follows="left|top" height="40" layout="topleft" left="112" name="gs_die_b" top="210" width="40" image_name="WolfGreedy_Die1" visible="false" />
        <icon follows="left|top" height="40" layout="topleft" left="160" name="gs_die_c" top="210" width="40" image_name="WolfGreedy_Die6" visible="false" />
        <button follows="left|top" font="SansSerifLarge" height="46" layout="topleft" left="20" name="gs_put" image_color="0.13 0.55 0.29 1" label_color="White" top="318" width="420" label="Put the table here" tool_tip="It appears just in front of you, facing you, where you stand" />
        <button follows="left|top" height="30" layout="topleft" left="20" name="gs_back" top="372" width="136" label="Back" />
        <button follows="left|top" height="30" layout="topleft" left="162" name="gs_skip" top="372" width="136" label="Skip" />
        <button follows="left|top" height="30" layout="topleft" left="304" name="gs_close" top="372" width="136" label="Close" />
        <!-- the message box: what is happening now, or what went wrong and what to do (read-only; it can be selected and copied) -->
        <text_editor follows="left|top" font="SansSerif" height="62" layout="topleft" left="20" name="gs_message" top="410" width="420" read_only="true" word_wrap="true" visible="false" show_context_menu="true" />
    </panel>
</floater>
