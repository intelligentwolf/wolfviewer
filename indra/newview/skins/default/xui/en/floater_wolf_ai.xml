    <text follows="left|top" layout="topleft" left="24" top="196" width="96" height="30" word_wrap="true" font="SansSerifBold" text_color="0.97 0.93 0.9 1" name="ai_text_name_lbl">Name in inventory</text>
    <line_editor follows="left|top" layout="topleft" left="124" top="198" width="264" height="24" max_length_chars="48" name="ai_text_name" label="The first line of your words"
