     label_color="0.16 0.08 0.02 1" label_color_selected="0.16 0.08 0.02 1" label_color_disabled="0.72 0.72 0.80 1" label_color_disabled_selected="0.72 0.72 0.80 1"
     tool_tip="Nothing is charged yet" />
  </panel>

  <!-- ===== 2. the price and Start ===== -->
  <panel follows="left|top" height="740" layout="topleft" left="0" mouse_opaque="false" name="price_panel" top="0" visible="false" width="800">
    <text type="string" length="1" follows="left|top" font="SansSerifLargeBold" height="22" layout="topleft" left="420" name="price_title"
     text_color="0.12 0.07 0.03 1" top="220" width="340">
