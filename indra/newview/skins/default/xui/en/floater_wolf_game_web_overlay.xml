<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<!-- [WOLF GAME 2026-10-09] The game's web page, mode "overlay": over the whole world view with a
     close X top-right; Escape closes it too (WolfGame::handleEscape). VIEWER_SPEC.md §3.8. -->
<floater
 bg_alpha_image="Window_NoTitle_Background"
 bg_opaque_image="Window_NoTitle_Foreground"
 can_close="false"
 can_drag_on_left="false"
 can_minimize="false"
 can_resize="false"
 header_height="0"
 height="600"
 layout="topleft"
 legacy_header_height="0"
 name="wolf_game_web_overlay"
 save_rect="false"
 show_title="false"
 single_instance="true"
 title="Game page"
 width="800">
    <web_browser
     follows="all"
     height="600"
     layout="topleft"
     left="0"
     name="browser"
     top="0"
     trusted_content="false"
     width="800" />
    <!-- The page's real host, always on show (a region cannot title a page "Wolf Territories
         login"); the script's name follows it as secondary text. Set in code. -->
    <text
     parse_urls="false"
     bg_visible="true"
     bg_readonly_color="0 0 0 0.85"
     follows="left|top"
     height="20"
     layout="topleft"
     left="6"
     name="host_label"
     text_color="White"
     top="10"
     use_ellipses="true"
     width="600" />
    <button
     follows="right|top"
     height="28"
     label="X"
     layout="topleft"
     name="close_overlay"
     right="-6"
     tool_tip="Close this page (Escape)"
     top="6"
     width="32" />
</floater>
